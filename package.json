{
  "name": "pa-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "node --experimental-strip-types scripts/validate-data.ts && astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run check && npm test && astro build && npm run mcp:build",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp:smoke": "node scripts/smoke-mcp.mjs",
    "preview": "astro preview",
    "data:refresh": "node --experimental-strip-types scripts/import-official-lists.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "astro": "^7.2.2",
    "fast-xml-parser": "^5.11.0",
    "pdfjs-dist": "^6.2.108",
    "saxes": "^6.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "exceljs": "^4.4.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "js-yaml": "5.4.0",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
