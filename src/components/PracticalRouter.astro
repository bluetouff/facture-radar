---
import InterfaceIcon from "./InterfaceIcon.astro";
import sources from "../data/sources.json";
import { buildDirectFacturXAnswer } from "../lib/direct-routing";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const answer = buildDirectFacturXAnswer();
const sourcesById = new Map(sources.map((source) => [source.id, source]));
const stateLabels = {
  documented: "Publié",
  confirm: "À vérifier",
  unknown: "Information absente",
} as const;
---

<section class:list={["practical-router", { compact }]} id="facturx-direct" aria-labelledby="practical-router-title">
  <header class="router-head">
    <div class="router-mark"><InterfaceIcon name="action" /></div>
    <div>
      <small>Question pratique</small>
      <h2 id="practical-router-title">Votre fichier est prêt. Où pouvez-vous l'envoyer&nbsp;?</h2>
    </div>
    <span class="freshness">Mis à jour le 25 août 2026</span>
  </header>

  <nav class="need-switch" aria-label="Choisir son point de départ">
    <a class="active" href="#facturx-direct" aria-current="page"><InterfaceIcon name="invoice" /> J'ai déjà un Factur-X</a>
    <a href="#verifier-logiciel"><InterfaceIcon name="search" /> Je veux garder mon logiciel</a>
    <a href="/diagnostic/"><InterfaceIcon name="verdict" /> Je cherche une solution complète</a>
  </nav>

  <blockquote>{answer.question}</blockquote>

  <section class="direct-answer">
    <span class="answer-icon"><InterfaceIcon name="check" /></span>
    <div>
      <small>Réponse courte</small>
      <h3>{answer.headline}</h3>
      <p>{answer.explanation}</p>
    </div>
  </section>

  <div class="route-map" aria-label="Circuit recherché : fichier Factur-X, dépôt direct sur le portail d'une PA, puis transmission au client">
    <div><span>01</span><strong>Votre Factur-X</strong><small>PDF/A-3 + XML EN16931</small></div>
    <i aria-hidden="true"></i>
    <div><span>02</span><strong>Portail de la PA</strong><small>Dépôt direct, sans intermédiaire</small></div>
    <i aria-hidden="true"></i>
    <div><span>03</span><strong>PA du client</strong><small>Routage et statuts</small></div>
  </div>

  {compact ? (
    <div class="compact-proof">
      <div><span>PA directe</span><strong>Oui</strong></div>
      <div><span>Import public</span><strong>PDF ou XML</strong></div>
      <div><span>Dernier contrôle</span><strong>XML tiers conservé</strong></div>
      <a href="/verifier-mon-outil/#facturx-direct">Voir les trois pistes et le test à faire <InterfaceIcon name="arrow" /></a>
    </div>
  ) : (
    <>
      <details class="volume-refinement">
        <summary>Ajuster les tarifs à mon volume de factures</summary>
        <form class="volume-picker" id="direct-volume-form">
          <fieldset>
            <legend>Votre volume sert uniquement à afficher le bon tarif</legend>
            <label><input type="radio" name="volume" value="up-to-24" /> <span>24 factures/an ou moins</span></label>
            <label><input type="radio" name="volume" value="25-to-1000" /> <span>25 à 1 000/mois</span></label>
            <label><input type="radio" name="volume" value="over-1000" /> <span>Plus de 1 000/mois</span></label>
            <label><input type="radio" name="volume" value="unknown" checked /> <span>Je ne sais pas</span></label>
          </fieldset>
        </form>
      </details>

      <div class="route-options" id="direct-route-options">
        {answer.options.map((option, index) => (
          <article class="route-option" data-option-id={option.id}>
            <header>
              <span class="option-index">0{index + 1}</span>
              <div><small>{option.statusLabel}</small><h3>{option.name}</h3></div>
              <span class:list={["option-state", { leading: index === 0 }]}>{index === 0 ? "À examiner en premier" : "Alternative"}</span>
            </header>
            <p class="option-summary">{option.summary}</p>
            <dl>
              {option.facts.map((fact) => (
                <div data-state={fact.state}>
                  <dt>{fact.label}</dt>
                  <dd><span aria-hidden="true"></span>{fact.value}<small>{stateLabels[fact.state]}</small></dd>
                </div>
              ))}
              <div class="price-row">
                <dt>Prix pour votre volume</dt>
                <dd class="route-price">{option.price}</dd>
              </div>
            </dl>
            <div class="unknown-box"><strong>Information encore absente</strong><p>{option.decisiveUnknown}</p></div>
            <div class="test-box"><span><InterfaceIcon name="action" /></span><div><strong>Prochaine action</strong><p>{option.nextStep}</p></div></div>
            <div class="option-links">
              {option.profileHref && <a href={option.profileHref}>Voir la fiche PA Check</a>}
              <details>
                <summary><InterfaceIcon name="proof" /> Voir les sources</summary>
                <ul>
                  {[...new Set([...option.facts.flatMap((fact) => fact.sourceIds), ...option.priceSourceIds])].map((sourceId) => {
                    const source = sourcesById.get(sourceId);
                    return source && <li><a href={source.url} rel="noopener">{source.title}</a><small>{source.publisher} · consulté le {source.accessedAt.split("-").reverse().join("/")}</small></li>;
                  })}
                </ul>
              </details>
            </div>
          </article>
        ))}
      </div>

      <section class="decision-tools">
        <div>
          <small>Avant d'ouvrir un compte</small>
          <h3>Vérifiez d'abord que votre fichier est bien un Factur-X EN16931.</h3>
          <p>Le contrôle reste sur votre appareil. Vous évitez de tester une PA avec une facture déjà invalide.</p>
          <a class="button" href="/verifier-une-facture/">Contrôler mon fichier <InterfaceIcon name="arrow" /></a>
        </div>
        <div class="vendor-question">
          <small>La question exacte à poser</small>
          <p id="vendor-question-text">{answer.vendorQuestion}</p>
          <button type="button" id="copy-vendor-question"><InterfaceIcon name="copy" /> Copier la question</button>
          <span id="vendor-question-status" aria-live="polite"></span>
        </div>
      </section>
    </>
  )}
</section>

{!compact && (
  <script>
    import { buildDirectFacturXAnswer, type DirectRoutingVolume } from "../lib/direct-routing";

    const form = document.querySelector<HTMLFormElement>("#direct-volume-form");
    form?.addEventListener("change", () => {
      const data = new FormData(form);
      const volume = (data.get("volume") ?? "unknown") as DirectRoutingVolume;
      const updated = buildDirectFacturXAnswer(volume);
      for (const option of updated.options) {
        const card = document.querySelector<HTMLElement>(`[data-option-id="${option.id}"]`);
        const price = card?.querySelector<HTMLElement>(".route-price");
        if (price) price.textContent = option.price;
      }
    });

    const copyButton = document.querySelector<HTMLButtonElement>("#copy-vendor-question");
    const question = document.querySelector<HTMLElement>("#vendor-question-text");
    const status = document.querySelector<HTMLElement>("#vendor-question-status");
    copyButton?.addEventListener("click", async () => {
      if (!question || !status) return;
      try {
        await navigator.clipboard.writeText(question.textContent ?? "");
        status.textContent = "Question copiée.";
      } catch {
        const range = document.createRange();
        range.selectNodeContents(question);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        status.textContent = "Question sélectionnée. Utilisez maintenant la commande Copier de votre appareil.";
      }
    });
  </script>
)}

<style>
  .practical-router { overflow: hidden; scroll-margin-top: 5.5rem; border: 1px solid color-mix(in srgb, var(--signal) 20%, var(--line)); border-radius: 1.35rem; background: rgba(255,255,255,.96); box-shadow: 0 1.2rem 3.8rem rgba(31,46,77,.11); }
  .router-head { display: grid; grid-template-columns: auto 1fr auto; gap: .8rem; align-items: center; padding: 1.15rem 1.2rem; background: linear-gradient(120deg, #14243a, #1d3155); }
  .router-mark { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid rgba(255,255,255,.16); border-radius: .8rem; background: rgba(255,255,255,.08); color: #aebcff; }
  .router-head > div:nth-child(2) { min-width: 0; }
  .router-head small { color: #aebcff; font-size: .76rem; font-weight: 760; letter-spacing: .045em; text-transform: uppercase; }
  .router-head h2 { margin: .12rem 0 0; color: #fff; font-size: 1.08rem; letter-spacing: -.025em; }
  .freshness { border: 1px solid rgba(255,255,255,.14); border-radius: 999px; padding: .42rem .6rem; color: rgba(255,255,255,.72); font-size: .78rem; white-space: nowrap; }
  .need-switch { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; border-bottom: 1px solid var(--line); padding: .7rem; background: var(--surface-2); }
  .need-switch a { display: flex; gap: .42rem; align-items: center; border: 1px solid transparent; border-radius: .7rem; padding: .72rem; color: var(--muted); font-size: .78rem; font-weight: 690; }
  .need-switch a.active { border-color: color-mix(in srgb, var(--signal) 26%, var(--line)); background: #fff; color: var(--signal); box-shadow: 0 .28rem .8rem rgba(41,57,86,.06); }
  .need-switch :global(svg) { flex: 0 0 auto; width: 1rem; height: 1rem; }
  blockquote { position: relative; margin: 0; border-bottom: 1px solid var(--line); padding: 1.1rem 1.2rem 1.1rem 2.4rem; color: var(--bright); font-size: .95rem; font-weight: 650; line-height: 1.5; }
  blockquote::before { position: absolute; top: .9rem; left: 1.05rem; color: var(--signal); content: "“"; font-size: 2rem; line-height: 1; }
  .route-map { display: grid; grid-template-columns: 1fr 2.4rem 1fr 2.4rem 1fr; align-items: center; margin-top: -.2rem; padding: 0 1.2rem 1rem; background: linear-gradient(90deg, #f7f9fc, #fff); }
  .route-map > div { min-width: 0; border: 1px solid var(--line); border-radius: .75rem; padding: .7rem; background: #fff; }
  .route-map span { color: var(--signal); font: 750 .78rem/1 var(--font-mono); }
  .route-map strong, .route-map small { display: block; }
  .route-map strong { margin-top: .25rem; color: var(--bright); font-size: .78rem; }
  .route-map small { margin-top: .12rem; color: var(--muted); font-size: .78rem; }
  .route-map i { height: 1px; background: var(--line-strong); }
  .route-map i::after { display: block; width: .45rem; height: .45rem; margin: -.25rem 0 0 auto; border-top: 1px solid var(--line-strong); border-right: 1px solid var(--line-strong); rotate: 45deg; content: ""; }
  .direct-answer { display: grid; grid-template-columns: auto 1fr; gap: .9rem; margin: 0 1.2rem 1.2rem; border: 1px solid color-mix(in srgb, var(--success) 24%, var(--line)); border-radius: .95rem; padding: 1rem; background: linear-gradient(120deg, var(--success-soft), #fff 65%); }
  .answer-icon { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: .72rem; background: var(--success); color: #fff; }
  .direct-answer small { color: var(--success); font-size: .78rem; font-weight: 760; letter-spacing: .04em; text-transform: uppercase; }
  .direct-answer h3 { margin: .12rem 0 0; color: var(--bright); font-size: 1.13rem; letter-spacing: -.025em; }
  .direct-answer p { max-width: 72ch; margin: .45rem 0 0; color: var(--paper); font-size: .85rem; }
  .volume-refinement { overflow: hidden; margin: 0 1.2rem 1rem; border: 1px solid var(--line); border-radius: .8rem; background: #fff; }
  .volume-refinement > summary { padding: .75rem .85rem; color: var(--paper); cursor: pointer; font-size: .78rem; font-weight: 690; }
  .volume-picker { margin: 0; border-top: 1px solid var(--line); padding: .85rem; background: var(--surface-2); }
  .volume-picker fieldset { display: flex; flex-wrap: wrap; gap: .45rem; margin: 0; border: 0; padding: 0; }
  .volume-picker legend { width: 100%; margin-bottom: .35rem; color: var(--bright); font-size: .78rem; font-weight: 710; }
  .volume-picker label { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; padding: .48rem .65rem; background: #fff; color: var(--paper); cursor: pointer; font-size: .76rem; }
  .volume-picker label:has(input:checked) { border-color: var(--signal); background: var(--signal-soft); color: var(--signal); }
  .volume-picker input { accent-color: var(--signal); }
  .route-options { display: grid; gap: .8rem; padding: 0 1.2rem 1.2rem; }
  .route-option { overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: #fff; }
  .route-option > header { display: grid; grid-template-columns: auto 1fr auto; gap: .7rem; align-items: center; border-bottom: 1px solid var(--line); padding: .85rem 1rem; background: linear-gradient(100deg, var(--signal-soft), #fff 55%); }
  .option-index { color: var(--signal); font: 760 .78rem/1 var(--font-mono); }
  .route-option header small { color: var(--signal); font-size: .76rem; font-weight: 720; text-transform: uppercase; }
  .route-option h3 { margin: .05rem 0 0; color: var(--bright); font-size: 1.2rem; letter-spacing: -.03em; }
  .option-state { border-radius: 999px; padding: .4rem .55rem; background: var(--surface-2); color: var(--muted); font-size: .8rem; font-weight: 700; }
  .option-state.leading { background: var(--success-soft); color: var(--success); }
  .option-summary { margin: 0; padding: .85rem 1rem; color: var(--paper); font-size: .85rem; }
  .route-option dl { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border-top: 1px solid var(--line); }
  .route-option dl > div { min-width: 0; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: .72rem 1rem; }
  .route-option dl > div:nth-child(2n) { border-right: 0; }
  .route-option dt { color: var(--muted); font-size: .78rem; }
  .route-option dd { display: flex; flex-wrap: wrap; gap: .38rem; align-items: center; margin: .28rem 0 0; color: var(--bright); font-size: .8rem; font-weight: 710; }
  .route-option dd > span { width: .46rem; height: .46rem; border-radius: 50%; background: var(--success); }
  .route-option [data-state="confirm"] dd > span { background: var(--amber); }
  .route-option [data-state="unknown"] dd > span { background: var(--muted); }
  .route-option dd small { margin-left: auto; color: var(--success); font-size: .78rem; font-weight: 670; }
  .route-option [data-state="confirm"] dd small { color: var(--amber); }
  .route-option [data-state="unknown"] dd small { color: var(--muted); }
  .route-option dl > .price-row { grid-column: 1 / -1; border-right: 0; background: #f8fafc; }
  .price-row dd { color: var(--signal); }
  .unknown-box, .test-box { margin: .8rem 1rem 0; border-radius: .75rem; padding: .78rem .85rem; }
  .unknown-box { border: 1px solid color-mix(in srgb, var(--amber) 24%, var(--line)); background: var(--amber-soft); }
  .unknown-box strong { color: var(--amber); font-size: .8rem; }
  .unknown-box p, .test-box p { margin: .25rem 0 0; color: var(--paper); font-size: .79rem; }
  .test-box { display: grid; grid-template-columns: auto 1fr; gap: .65rem; background: var(--surface-2); }
  .test-box > span { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .6rem; background: #fff; color: var(--signal); }
  .test-box strong { color: var(--bright); font-size: .76rem; }
  .option-links { display: flex; flex-wrap: wrap; gap: 1rem; align-items: start; padding: .9rem 1rem 1rem; }
  .option-links > a { color: var(--signal); font-size: .76rem; font-weight: 700; text-decoration: underline; text-underline-offset: .18rem; }
  .option-links details { flex: 1 1 18rem; margin: 0; }
  .option-links summary { display: flex; gap: .35rem; align-items: center; color: var(--signal); cursor: pointer; font-size: .75rem; font-weight: 700; }
  .option-links summary :global(svg) { width: 1rem; height: 1rem; }
  .option-links ul { display: grid; gap: .55rem; margin: .7rem 0 0; padding: 0; list-style: none; }
  .option-links li { display: grid; }
  .option-links li a { color: var(--paper); font-size: .75rem; text-decoration: underline; text-underline-offset: .15rem; }
  .option-links li small { color: var(--muted); font-size: .78rem; }
  .decision-tools { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; border-top: 1px solid var(--line); padding: 1.2rem; background: var(--surface-2); }
  .decision-tools > div { border: 1px solid var(--line); border-radius: .9rem; padding: 1rem; background: #fff; }
  .decision-tools small { color: var(--signal); font-size: .78rem; font-weight: 740; text-transform: uppercase; }
  .decision-tools h3 { margin: .3rem 0 0; color: var(--bright); font-size: 1rem; }
  .decision-tools p { color: var(--paper); font-size: .82rem; }
  .decision-tools .button { gap: .45rem; margin-top: .2rem; }
  .vendor-question button { display: inline-flex; gap: .4rem; align-items: center; border: 1px solid var(--line-strong); border-radius: .65rem; padding: .62rem .75rem; background: #fff; color: var(--bright); cursor: pointer; font-size: .75rem; font-weight: 700; }
  .vendor-question button :global(svg) { width: 1rem; height: 1rem; }
  #vendor-question-status { display: block; margin-top: .45rem; color: var(--success); font-size: .76rem; }
  .compact-proof { display: grid; grid-template-columns: repeat(3, 1fr); gap: .55rem; padding: 0 1.2rem 1.2rem; }
  .compact-proof > div { border: 1px solid var(--line); border-radius: .72rem; padding: .7rem; background: var(--surface-2); }
  .compact-proof span, .compact-proof strong { display: block; }
  .compact-proof span { color: var(--muted); font-size: .76rem; }
  .compact-proof strong { margin-top: .2rem; color: var(--bright); font-size: .78rem; }
  .compact-proof > a { display: flex; grid-column: 1 / -1; justify-content: space-between; align-items: center; border-radius: .7rem; padding: .75rem .85rem; background: var(--signal); color: #fff; font-size: .76rem; font-weight: 720; }
  .compact-proof > a:hover { color: #fff; background: #334cc8; }
  .compact-proof :global(svg) { width: 1rem; height: 1rem; }
  .compact .router-head { grid-template-columns: auto 1fr; }
  .compact .freshness { display: none; }
  @media (max-width: 720px) {
    .router-head { grid-template-columns: auto 1fr; }
    .freshness { grid-column: 2; justify-self: start; }
    .need-switch { display: none; }
    .route-map { grid-template-columns: 1fr; gap: .45rem; }
    .route-map i { width: 1px; height: 1rem; margin-inline: 1.5rem; }
    .route-map i::after { margin: .55rem 0 0 -.2rem; rotate: 135deg; }
    .route-option dl, .decision-tools { grid-template-columns: 1fr; }
    .route-option dl > div { border-right: 0; }
  }
  @media (max-width: 520px) {
    .router-head, .route-map, .decision-tools { padding-inline: .8rem; }
    blockquote { padding-right: .8rem; }
    .direct-answer, .volume-refinement { margin-inline: .8rem; }
    .route-options, .compact-proof { padding-inline: .8rem; }
    .route-option > header { grid-template-columns: auto 1fr; }
    .option-state { grid-column: 2; justify-self: start; }
    .compact-proof { grid-template-columns: 1fr; }
    .compact-proof > a { grid-column: 1; }
  }
</style>
