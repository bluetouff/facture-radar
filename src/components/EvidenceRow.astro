---
import type { Evidence } from "../data/types";
import sources from "../data/sources.json";
import EvidenceBadge from "./EvidenceBadge.astro";

interface Props {
  label: string;
  evidence: Evidence<unknown>;
}

const { label, evidence } = Astro.props;

function displayValue(value: unknown): string {
  if (value === null) return "À confirmer";
  if (label === "Statut DGFiP" && value === "registered") return "Plateforme agréée";
  if (label === "Date d'immatriculation" && typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
    return value.split("-").reverse().join("/");
  }
  if (label === "Engagement minimal" && typeof value === "number") {
    return value === 0 ? "Aucun engagement minimal indiqué" : `${value} mois`;
  }
  if (typeof value === "boolean") return value ? "Oui" : "Non";
  if (typeof value === "string" || typeof value === "number") return String(value);
  if (Array.isArray(value)) return value.length ? value.join(", ") : "Aucune information publiée";
  if (typeof value === "object" && value) {
    if ("stage" in value && "scope" in value) {
      const availability = value as { stage: "available" | "limited" | "beta" | "announced"; scope: string };
      const stageLabels = { available: "Disponible", limited: "Accès limité", beta: "En bêta", announced: "Annoncée" } as const;
      return `${stageLabels[availability.stage]} · ${availability.scope}`;
    }
    if ("acceptsThirdPartyFile" in value) {
      const detail = value as { acceptsThirdPartyFile: boolean; formats: string[]; preservesEmbeddedXml: boolean | null; requiresReentry: boolean | null };
      const parts = [detail.acceptsThirdPartyFile ? "Import tiers publié" : "Import tiers non pris en charge"];
      if (detail.formats.length) parts.push(detail.formats.join(", "));
      if (detail.preservesEmbeddedXml === true) parts.push("XML embarqué conservé");
      if (detail.preservesEmbeddedXml === false) parts.push("XML embarqué non conservé");
      if (detail.requiresReentry === false) parts.push("sans ressaisie publiée");
      if (detail.requiresReentry === true) parts.push("ressaisie requise");
      return parts.join(" · ");
    }
    if ("bulkExport" in value) {
      const detail = value as { bulkExport: boolean | null; formats: string[]; postTerminationAccess: string | null; fees: string | null };
      const parts = [detail.bulkExport === true ? "Export en masse publié" : detail.bulkExport === false ? "Pas d'export en masse" : "Export en masse à confirmer"];
      if (detail.formats.length) parts.push(`formats : ${detail.formats.join(", ")}`);
      if (detail.postTerminationAccess) parts.push(detail.postTerminationAccess);
      if (detail.fees) parts.push(detail.fees);
      return parts.join(" · ");
    }
    if ("label" in value && typeof value.label === "string") return value.label;
    if ("available" in value) {
      const api = value as { available: boolean; includedInFree: boolean | null };
      if (!api.available) return "Non";
      if (api.includedInFree === true) return "Oui, incluse dans le gratuit";
      if (api.includedInFree === false) return "Oui, offre payante requise";
      return "Oui, coût d'accès à confirmer";
    }
  }
  return "Valeur structurée";
}

const linkedSources = evidence.sourceIds
  .map((id) => sources.find((source) => source.id === id))
  .filter((source) => source !== undefined);
const checkedAtLabel = evidence.checkedAt.split("-").reverse().join("/");
---

<div class="evidence-row" data-status={evidence.status}>
  <div class="evidence-key">
    <span class="status-marker" aria-hidden="true"></span>
    <span class="evidence-label">{label}</span>
    <EvidenceBadge status={evidence.status} />
  </div>
  <div class="evidence-value">
    <strong>{displayValue(evidence.value)}</strong>
    {evidence.note && <p>{evidence.note}</p>}
  </div>
  <details class="evidence-sources">
    <summary>{linkedSources.length ? "Sources et date" : "Date de vérification"}</summary>
    <div>
      {linkedSources.length ? linkedSources.map((source) => (
        <a href={source.url} rel="noopener">{source.publisher}<span aria-hidden="true">↗</span></a>
      )) : <span>Aucune source concluante</span>}
      <small>Mis à jour le {checkedAtLabel}</small>
    </div>
  </details>
</div>

<style>
  .evidence-row { --row-tone: #538565; display: grid; grid-template-columns: minmax(10rem,.8fr) minmax(0,1.5fr); gap: .55rem 1.5rem; border-bottom: 1px solid #cbd4c1; padding: 1.2rem 1.4rem; background: #f8f5ee; }
  .evidence-row:last-child { border-bottom: 0; }
  .evidence-row[data-status="official"] { --row-tone: #526cb2; }
  .evidence-row[data-status="declared"] { --row-tone: #826aa1; }
  .evidence-row[data-status="non_documented"] { --row-tone: #a77c41; background: #f0eddf; }
  .evidence-key { display: grid; grid-template-columns: auto 1fr; gap: .5rem; align-content: start; justify-items: start; }
  .status-marker { width: .5rem; height: .5rem; margin-top: .4rem; border-radius: 50%; background: var(--row-tone); }
  .evidence-label { color: #425a4b; font-size: .87rem; font-weight: 550; line-height: 1.45; }
  .evidence-key :global(.evidence-badge) { grid-column: 2; border: 0; background: none; padding: 0; font-size: .75rem; font-weight: 450; letter-spacing: .015em; }
  .evidence-key :global(.evidence-badge::before) { display: none; }
  .evidence-value { min-width: 0; }
  .evidence-value strong { color: var(--bright); font-size: .95rem; font-weight: 550; line-height: 1.5; overflow-wrap: anywhere; }
  .evidence-value p { margin: .4rem 0 0; color: var(--muted); font-size: .86rem; line-height: 1.6; overflow-wrap: anywhere; }
  [data-status="non_documented"] .evidence-value strong { color: #806137; }
  .evidence-sources { grid-column: 2; min-width: 0; }
  .evidence-sources summary { width: fit-content; padding-block: .45rem; color: #4c6b51; font-size: .76rem; cursor: pointer; }
  .evidence-sources summary:hover { color: var(--signal); }
  .evidence-sources summary:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .evidence-sources > div { display: grid; gap: .5rem; padding-block: .45rem; border-top: 1px dashed #bfcbb4; }
  .evidence-sources a { display: flex; justify-content: space-between; gap: .8rem; width: fit-content; color: var(--signal); font-size: .8rem; text-decoration: underline; text-underline-offset: .25em; }
  .evidence-sources > div > span, .evidence-sources small { font-size: .75rem; color: var(--muted); }
  @media (max-width: 620px) { .evidence-row { grid-template-columns: 1fr; padding: 1rem; } .evidence-key { grid-template-columns: auto 1fr; } .evidence-sources { grid-column: 1; } .evidence-value { margin-top: .35rem; } }
</style>
