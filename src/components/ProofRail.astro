<div class="hero-proof" aria-label="Schéma des quatre niveaux de preuve">
  <svg class="proof-svg" viewBox="0 0 620 460" role="img" aria-labelledby="proof-title proof-desc">
    <title id="proof-title">Du statut officiel aux zones non documentées</title>
    <desc id="proof-desc">Quatre niveaux permettent de distinguer les informations officielles, documentées, déclarées et non documentées.</desc>
    <defs>
      <linearGradient id="rail" x1="0" x2="1">
        <stop offset="0" stop-color="#71a9ff" />
        <stop offset=".4" stop-color="#58e7cc" />
        <stop offset=".72" stop-color="#f3b64f" />
        <stop offset="1" stop-color="#7e8d88" />
      </linearGradient>
      <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" fill="none" stroke="currentColor" stroke-opacity=".08" />
      </pattern>
    </defs>
    <rect width="620" height="460" fill="url(#grid)" />
    <text x="34" y="48" fill="currentColor" opacity=".55" font-family="ui-monospace,monospace" font-size="12" letter-spacing="2">CHAÎNE DE VÉRIFICATION</text>
    <path d="M70 116H550" stroke="url(#rail)" stroke-width="4" />
    <g font-family="ui-monospace,monospace">
      <g transform="translate(70 116)">
        <circle r="16" fill="#0b1114" stroke="#71a9ff" stroke-width="4" />
        <text x="0" y="48" fill="#71a9ff" font-size="13" text-anchor="middle">OFFICIEL</text>
        <text x="0" y="72" fill="currentColor" opacity=".72" font-size="10" text-anchor="middle">DGFiP</text>
      </g>
      <g transform="translate(230 116)">
        <circle r="16" fill="#0b1114" stroke="#58e7cc" stroke-width="4" />
        <text x="0" y="48" fill="#58e7cc" font-size="13" text-anchor="middle">DOCUMENTÉ</text>
        <text x="0" y="72" fill="currentColor" opacity=".72" font-size="10" text-anchor="middle">contrat · tarif</text>
      </g>
      <g transform="translate(390 116)">
        <circle r="16" fill="#0b1114" stroke="#f3b64f" stroke-width="4" />
        <text x="0" y="48" fill="#f3b64f" font-size="13" text-anchor="middle">DÉCLARÉ</text>
        <text x="0" y="72" fill="currentColor" opacity=".72" font-size="10" text-anchor="middle">éditeur</text>
      </g>
      <g transform="translate(550 116)">
        <circle r="16" fill="#0b1114" stroke="#7e8d88" stroke-width="4" />
        <text x="0" y="48" fill="#93a29d" font-size="13" text-anchor="middle">INCONNU</text>
        <text x="0" y="72" fill="currentColor" opacity=".72" font-size="10" text-anchor="middle">visible</text>
      </g>
    </g>
    <g transform="translate(34 232)">
      <rect width="552" height="164" rx="6" fill="currentColor" fill-opacity=".03" stroke="currentColor" stroke-opacity=".13" />
      <text x="22" y="31" fill="#ff527f" font-family="ui-monospace,monospace" font-size="11" font-weight="700">RÈGLE DU MOTEUR</text>
      <text x="22" y="69" fill="currentColor" font-family="ui-sans-serif,system-ui" font-size="23" font-weight="720">Une inconnue ne vaut jamais “oui”.</text>
      <text x="22" y="103" fill="currentColor" opacity=".7" font-family="ui-sans-serif,system-ui" font-size="14">Si votre critère est impératif et que la preuve manque,</text>
      <text x="22" y="127" fill="currentColor" opacity=".7" font-family="ui-sans-serif,system-ui" font-size="14">le parcours est écarté et la lacune reste affichée.</text>
      <rect x="409" y="22" width="119" height="28" fill="#ff527f" />
      <text x="468.5" y="41" fill="#fff" font-family="ui-monospace,monospace" font-size="10" text-anchor="middle">FAIL CLOSED</text>
    </g>
  </svg>
</div>
