---
import InterfaceIcon from "./InterfaceIcon.astro";
---

<aside class="choice-map" aria-label="Trois informations permettent de repérer les plateformes à examiner">
  <header>
    <span>Votre sélection</span>
    <small><i></i> calcul local</small>
  </header>
  <div class="choice-flow">
    <div class="choice-inputs">
      <div><span><InterfaceIcon name="proof" /></span><p><b>01</b><strong>Votre activité</strong></p></div>
      <div><span><InterfaceIcon name="invoice" /></span><p><b>02</b><strong>Votre volume</strong></p></div>
      <div><span><InterfaceIcon name="target" /></span><p><b>03</b><strong>Votre priorité</strong></p></div>
    </div>
    <div class="choice-router" aria-hidden="true">
      <svg viewBox="0 0 150 210" preserveAspectRatio="none">
        <path d="M0 35 C58 35 45 105 106 105" />
        <path d="M0 105 H106" />
        <path d="M0 175 C58 175 45 105 106 105" />
        <path class="route-out" d="M106 105 H150" />
      </svg>
      <span><InterfaceIcon name="route" /></span>
    </div>
    <div class="choice-output">
      <small>OPTIONS À EXAMINER</small>
      <div class="option-card primary"><span>01</span><p><b>Meilleur point de départ</b><i></i><i></i></p><InterfaceIcon name="arrow" /></div>
      <div class="option-card"><span>02</span><p><i></i><i></i></p></div>
      <div class="option-card"><span>03</span><p><i></i><i></i></p></div>
    </div>
  </div>
  <footer><InterfaceIcon name="shield" /><span>Aucun compte, aucun SIREN, aucun document demandé</span></footer>
</aside>

<style>
  .choice-map { position: relative; overflow: hidden; border: 1px solid color-mix(in srgb, var(--signal) 20%, var(--line)); border-radius: 1.4rem; padding: 1rem; background: linear-gradient(145deg, rgba(255,255,255,.92), rgba(247,249,255,.86)); box-shadow: 0 1.4rem 4rem rgba(41,57,86,.11); }
  .choice-map::before { position: absolute; top: -7rem; right: -5rem; width: 15rem; height: 15rem; border: 1px solid rgba(64,91,216,.12); border-radius: 50%; box-shadow: 0 0 0 2rem rgba(64,91,216,.025), 0 0 0 4rem rgba(117,87,214,.018); content: ""; }
  header, footer { position: relative; z-index: 1; display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  header { border-bottom: 1px solid var(--line); padding: .15rem .15rem .85rem; }
  header > span { color: var(--bright); font-size: .78rem; font-weight: 740; }
  header small { display: inline-flex; gap: .4rem; align-items: center; color: var(--muted); font-size: .75rem; font-weight: 620; }
  header i { width: .48rem; height: .48rem; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 .22rem var(--success-soft); }
  .choice-flow { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(125px,.85fr) minmax(70px,.55fr) minmax(155px,1fr); align-items: center; min-height: 14rem; padding: 1rem .1rem; }
  .choice-inputs { display: grid; gap: .55rem; }
  .choice-inputs > div { display: flex; gap: .62rem; align-items: center; border: 1px solid var(--line); border-radius: .78rem; padding: .58rem; background: rgba(255,255,255,.82); }
  .choice-inputs > div > span { display: grid; flex: 0 0 auto; place-items: center; width: 2rem; height: 2rem; border-radius: .6rem; background: var(--signal-soft); color: var(--signal); }
  .choice-inputs > div:nth-child(2) > span { background: #eef7ff; color: var(--blue); }
  .choice-inputs > div:nth-child(3) > span { background: var(--success-soft); color: var(--success); }
  .choice-inputs svg { width: 1rem; height: 1rem; }
  .choice-inputs p { display: grid; gap: .05rem; margin: 0; }
  .choice-inputs b { color: var(--muted); font: 650 .54rem/1 var(--font-mono); }
  .choice-inputs strong { color: var(--bright); font-size: .76rem; }
  .choice-router { position: relative; height: 13.1rem; }
  .choice-router > svg { width: 100%; height: 100%; overflow: visible; }
  .choice-router path { fill: none; stroke: color-mix(in srgb, var(--signal) 38%, var(--line)); stroke-width: 1.4; vector-effect: non-scaling-stroke; }
  .choice-router .route-out { stroke: var(--signal); stroke-width: 2; }
  .choice-router > span { position: absolute; top: 50%; left: 71%; display: grid; place-items: center; width: 2rem; height: 2rem; translate: -50% -50%; border-radius: 50%; background: var(--signal); color: #fff; box-shadow: 0 0 0 .38rem var(--signal-soft), 0 .5rem 1rem rgba(64,91,216,.22); }
  .choice-router span svg { width: 1rem; height: 1rem; }
  .choice-output { display: grid; gap: .48rem; }
  .choice-output > small { color: var(--muted); font: 700 .53rem/1.2 var(--font-sans); letter-spacing: .06em; }
  .option-card { display: grid; grid-template-columns: auto 1fr auto; gap: .55rem; align-items: center; min-height: 2.65rem; border: 1px solid var(--line); border-radius: .72rem; padding: .52rem .62rem; background: rgba(255,255,255,.75); }
  .option-card.primary { border-color: color-mix(in srgb, var(--signal) 35%, var(--line)); background: linear-gradient(100deg, var(--signal-soft), #fff); box-shadow: 0 .5rem 1.3rem rgba(64,91,216,.09); }
  .option-card > span { color: var(--signal); font: 720 .58rem/1 var(--font-mono); }
  .option-card p { display: grid; gap: .27rem; margin: 0; }
  .option-card b { color: var(--bright); font-size: .75rem; }
  .option-card i { display: block; width: 82%; height: .24rem; border-radius: 1rem; background: var(--surface-3); }
  .option-card i + i { width: 56%; }
  .option-card > svg { width: .9rem; height: .9rem; color: var(--signal); }
  footer { border-top: 1px solid var(--line); padding: .8rem .15rem .05rem; color: var(--muted); font-size: .75rem; font-weight: 570; }
  footer svg { flex: 0 0 auto; width: .95rem; height: .95rem; color: var(--success); }
  @media (max-width: 1000px) { .choice-flow { grid-template-columns: minmax(115px,.9fr) minmax(60px,.45fr) minmax(145px,1fr); } }
  @media (max-width: 760px) { .choice-map { margin-top: .5rem; } }
  @media (max-width: 460px) { .choice-map { padding: .8rem; } .choice-flow { grid-template-columns: 1fr; gap: .7rem; min-height: 0; } .choice-inputs { grid-template-columns: repeat(3,1fr); } .choice-inputs > div { display: grid; justify-items: center; gap: .35rem; padding: .5rem .2rem; text-align: center; } .choice-inputs p { justify-items: center; } .choice-inputs strong { font-size: .72rem; } .choice-router { display: none; } .choice-output { grid-template-columns: repeat(3,1fr); } .choice-output > small { grid-column: 1 / -1; } .option-card { grid-template-columns: 1fr; justify-items: center; min-height: 3.2rem; padding: .45rem; text-align: center; } .option-card p { justify-items: center; } .option-card b { font-size: .7rem; } .option-card i { width: 80%; } .option-card > svg { display: none; } footer { justify-content: flex-start; } }
</style>
