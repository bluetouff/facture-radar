---
type IconName =
  | "invoice"
  | "search"
  | "shield"
  | "verdict"
  | "action"
  | "proof"
  | "copy"
  | "arrow"
  | "check"
  | "question"
  | "alert"
  | "route"
  | "target"
  | "layers"
  | "directory"
  | "grid"
  | "lab"
  | "download"
  | "lock"
  | "menu"
  | "chevron";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  {name === "invoice" && (
    <>
      <path d="M5 6.5h10.5l3.5 3.5v9.5H5z" />
      <path d="M15.5 6.5V10H19M8.5 11.8H15M8.5 14.5h3.3" />
      <path d="m12.5 17 1.5 1.5 3.2-3.8" />
      <path d="M8 3.5h9" opacity=".55" />
    </>
  )}
  {name === "search" && (
    <>
      <circle cx="10.5" cy="10.5" r="5.5" />
      <path d="m15 15 4 4" />
    </>
  )}
  {name === "shield" && (
    <>
      <path d="M12 3.5 19 6v5.2c0 4.5-2.8 7.6-7 9.3-4.2-1.7-7-4.8-7-9.3V6z" />
      <path d="m9.2 12 1.8 1.8 3.8-4" />
    </>
  )}
  {name === "verdict" && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="m8.5 12 2.2 2.2 4.8-5" />
    </>
  )}
  {name === "action" && (
    <>
      <path d="M4 18.5h4.5l9-9-4-4-9 9zM12.5 6.5l4 4M4 18.5l3.3-1" />
      <path d="M15.5 18.5H20" />
    </>
  )}
  {name === "proof" && (
    <>
      <path d="M7 3.5h8l3 3v14H7z" />
      <path d="M15 3.5v3h3M9.5 10.5h6M9.5 14h6M9.5 17.5h3" />
    </>
  )}
  {name === "copy" && (
    <>
      <rect x="8" y="7" width="10" height="12" rx="1" />
      <path d="M15 7V5H6v11h2" />
    </>
  )}
  {name === "arrow" && <path d="M5 12h13M14 8l4 4-4 4" />}
  {name === "check" && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="m8.5 12 2.2 2.2 4.8-5" />
    </>
  )}
  {name === "question" && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M9.8 9.5a2.4 2.4 0 0 1 4.7.7c0 1.8-2.5 2-2.5 3.8M12 17h.01" />
    </>
  )}
  {name === "alert" && (
    <>
      <path d="M12 3.8 21 20H3z" />
      <path d="M12 9v5M12 17h.01" />
    </>
  )}
  {name === "route" && (
    <>
      <circle cx="5" cy="16.5" r="1.5" /><circle cx="19" cy="7.5" r="1.5" />
      <path d="M6.5 16.5h3.2c3.3 0 1.6-9 5.6-9H17.5M15 15.5h4M17 13.5l2 2-2 2" />
    </>
  )}
  {name === "target" && (
    <>
      <circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="1" />
      <path d="m15.5 8.5 4-4M16.8 4.5h2.7v2.7" />
    </>
  )}
  {name === "layers" && (
    <>
      <path d="m4 8 8-4 8 4-8 4zM4 12l8 4 8-4M4 16l8 4 8-4" />
    </>
  )}
  {name === "directory" && (
    <>
      <path d="M5 20V5.5h9V20M14 9h5v11M3 20h18" />
      <path d="M8 9h3M8 12.5h3M8 16h3M17 12.5h.01M17 16h.01" />
    </>
  )}
  {name === "grid" && (
    <>
      <rect x="4" y="4" width="6" height="6" rx="1.2" /><rect x="14" y="4" width="6" height="6" rx="1.2" />
      <rect x="4" y="14" width="6" height="6" rx="1.2" /><rect x="14" y="14" width="6" height="6" rx="1.2" />
    </>
  )}
  {name === "lab" && (
    <>
      <path d="M9 3.5h6M10 3.5v5.2l-5 8.5A2.2 2.2 0 0 0 6.9 20h10.2a2.2 2.2 0 0 0 1.9-2.8l-5-8.5V3.5" />
      <path d="M7.5 15h9M9.2 12h5.6" />
    </>
  )}
  {name === "download" && (
    <>
      <path d="M12 4v10M8.5 10.5 12 14l3.5-3.5" />
      <path d="M5 18.5h14" />
    </>
  )}
  {name === "lock" && (
    <>
      <rect x="5" y="10" width="14" height="10" rx="2" />
      <path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10M12 14v2" />
    </>
  )}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "chevron" && <path d="m8 10 4 4 4-4" />}
</svg>

<style>
  svg { width: 1.25rem; height: 1.25rem; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }
</style>
