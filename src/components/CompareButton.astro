---
interface Props { slug: string; name: string }
const { slug, name } = Astro.props;
---
<button type="button" class="compare-pick" data-compare-id={slug} data-compare-name={name} aria-pressed="false" hidden><span aria-hidden="true">+</span><span data-pick-label>Comparer</span></button>
<style is:global>
  .compare-pick { display: inline-flex; justify-content: center; align-items: center; gap: .4rem; min-height: 2.6rem; border: 1px solid var(--line); border-radius: .6rem; padding: .4rem .65rem; background: #fff; color: var(--signal); font-size: .78rem; font-weight: 600; cursor: pointer; transition: background 160ms ease, border-color 160ms ease; }
  .compare-pick[aria-pressed="true"] { background: var(--bright); color: #fffaf0; border-color: var(--bright); }
  .compare-pick:not([aria-pressed="true"]):hover { background: var(--signal-soft); }
  .compare-pick[aria-pressed="true"]:hover { background: #393c31; }
  .compare-pick > span:first-child { font-size: 1rem; }
</style>
