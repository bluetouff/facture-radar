---
import { knownTools } from "../lib/tool-verifier";
import { journeyProfiles } from "../data/journey-profiles";
import InterfaceIcon from "./InterfaceIcon.astro";

const suggestions = [...new Set(knownTools.flatMap((tool) => [tool.label, ...tool.aliases]))]
  .sort((a, b) => a.localeCompare(b, "fr"));
const quickTools = journeyProfiles.slice(0, 7).map((profile) => profile.toolLabel);
---

<div class="tool-verifier">
  <header class="tool-card-head">
    <span class="tool-card-icon"><InterfaceIcon name="invoice" /></span>
    <span><small>Votre parcours facture</small><strong>Une réponse adaptée à votre outil</strong></span>
    <b>100 % local</b>
  </header>

  <form class="tool-search" id="tool-verifier-form">
    <span class="step-label">Commencez ici</span>
    <label for="tool-name">Quel outil utilisez-vous aujourd'hui&nbsp;?</label>
    <div class="tool-search-row">
      <span class="search-icon"><InterfaceIcon name="search" /></span>
      <input
        id="tool-name"
        name="tool"
        type="text"
        list="known-tools"
        maxlength="80"
        autocomplete="off"
        spellcheck="false"
        placeholder="Tiime, Sage 50, Qonto, Sellsy…"
        required
      />
      <button type="submit">Obtenir ma réponse <InterfaceIcon name="arrow" /></button>
    </div>
    <datalist id="known-tools">
      {suggestions.map((suggestion) => <option value={suggestion} />)}
    </datalist>
    <div class="quick-tools" aria-label="Outils souvent recherchés">
      <span>Parcours détaillés</span>
      {quickTools.map((tool) => <button type="button" data-tool-example={tool}>{tool}</button>)}
    </div>
    <p class="privacy-line"><InterfaceIcon name="shield" /> Aucune facture ni donnée d'entreprise n'est demandée.</p>
    <a class="choose-link" href="/diagnostic/">Je n'ai pas encore d'outil&nbsp;: trouver des plateformes adaptées <InterfaceIcon name="arrow" /></a>
  </form>

  <section class="journey-context" id="journey-context" hidden>
    <div class="context-heading">
      <span class="step-label">Deux questions</span>
      <h2 id="journey-context-title" tabindex="-1">Deux précisions, puis votre parcours.</h2>
      <p>Nous les utilisons uniquement pour afficher la bonne échéance et l'action utile.</p>
    </div>
    <form id="journey-context-form">
      <fieldset>
        <legend>Votre situation</legend>
        <label class="choice-card">
          <input type="radio" name="audience" value="micro" required />
          <span><strong>Micro-entrepreneur</strong><small>Émission obligatoire en 2027</small></span>
        </label>
        <label class="choice-card">
          <input type="radio" name="audience" value="tpe-pme" required />
          <span><strong>TPE ou PME</strong><small>Émission obligatoire en 2027</small></span>
        </label>
        <label class="choice-card">
          <input type="radio" name="audience" value="eti-ge" required />
          <span><strong>ETI ou grande entreprise</strong><small>Émission obligatoire en 2026</small></span>
        </label>
      </fieldset>
      <fieldset>
        <legend id="activation-question">La plateforme agréée est-elle active pour votre entreprise&nbsp;?</legend>
        <label class="choice-card compact"><input type="radio" name="activation" value="yes" required /><span><strong>Oui</strong></span></label>
        <label class="choice-card compact"><input type="radio" name="activation" value="no" required /><span><strong>Non</strong></span></label>
        <label class="choice-card compact"><input type="radio" name="activation" value="unknown" required /><span><strong>Je ne sais pas</strong></span></label>
      </fieldset>
      <button class="primary-action" type="submit">Voir mon parcours <InterfaceIcon name="arrow" /></button>
    </form>
    <p class="privacy-line"><InterfaceIcon name="shield" /> Vos réponses restent dans ce navigateur.</p>
  </section>

  <section class="journey-result" id="journey-result" aria-live="polite" hidden>
    <div class="journey-verdict">
      <span class="verdict-dot" aria-hidden="true"></span>
      <span><small id="journey-status"></small><strong id="journey-tool"></strong></span>
    </div>
    <h2 id="journey-title"></h2>
    <p class="journey-summary" id="journey-summary"></p>

    <section class="result-block">
      <div class="block-heading"><span>01</span><div><small>Votre circuit</small><h3>Ce qui se passe avec vos factures</h3></div></div>
      <ol class="journey-rail" id="journey-rail"></ol>
    </section>

    <section class="result-grid">
      <div class="result-block deadlines-block">
        <div class="block-heading"><span>02</span><div><small>Votre calendrier</small><h3>Les dates qui vous concernent</h3></div></div>
        <div class="deadline-list" id="journey-deadlines"></div>
      </div>
      <div class="result-block cost-block">
        <div class="block-heading"><span>03</span><div><small>Budget visible</small><h3>Le coût minimum connu</h3></div></div>
        <div class="cost-lead"><span>Surcoût mensuel PA</span><strong id="journey-pa-cost"></strong></div>
        <p id="journey-cost-label"></p>
        <div class="cost-horizons" id="journey-cost-horizons"></div>
        <small class="cost-caveat" id="journey-cost-caveat"></small>
      </div>
    </section>

    <section class="result-block action-block">
      <div class="block-heading"><span>04</span><div><small>Votre prochaine étape</small><h3>Ce que vous pouvez faire maintenant</h3></div></div>
      <ol class="action-list" id="journey-actions"></ol>
    </section>

    <div class="verdict-actions journey-actions-bar">
      <button type="button" id="edit-journey">Modifier mes réponses</button>
      <button type="button" id="copy-journey"><InterfaceIcon name="copy" /> Copier les actions</button>
      <a id="journey-profile-link" href="/diagnostic/">Voir la fiche complète</a>
    </div>
    <details id="journey-sources-details">
      <summary><InterfaceIcon name="proof" /> D'où viennent ces informations&nbsp;?</summary>
      <ul id="journey-source-list"></ul>
    </details>
  </section>

  <section class="tool-result" id="tool-verifier-result" aria-live="polite" hidden>
    <div class="verdict-head">
      <span class="verdict-symbol" aria-hidden="true">
        <InterfaceIcon name="check" class="status-icon status-keep" />
        <InterfaceIcon name="alert" class="status-icon status-act" />
        <InterfaceIcon name="question" class="status-icon status-unconfirmed" />
      </span>
      <span class="verdict-meta"><span id="tool-verdict-label"></span><p id="tool-platform-name"></p></span>
    </div>
    <h2 id="tool-verdict-title"></h2>
    <p class="verdict-explanation" id="tool-verdict-explanation"></p>
    <div class="verdict-lines" id="tool-verdict-lines"></div>
    <div class="next-action">
      <InterfaceIcon name="action" />
      <span><small>À faire maintenant</small><p id="tool-next-action"></p></span>
    </div>
    <p class="vertical-note">Les {journeyProfiles.length} plateformes étudiées disposent d'un parcours détaillé. Les autres logiciels conservent une vérification courte lorsqu'une édition ou un raccordement reste à confirmer.</p>
    <div class="verdict-actions">
      <button type="button" id="refine-journey" hidden>Voir mon calendrier et mon coût</button>
      <button type="button" id="copy-tool-answer"><InterfaceIcon name="copy" /> Copier le résumé</button>
      <a id="tool-profile-link" href="/diagnostic/">Voir les plateformes étudiées</a>
    </div>
    <details id="tool-sources-details" hidden>
      <summary><InterfaceIcon name="proof" /> D'où viennent ces informations&nbsp;?</summary>
      <ul id="tool-source-list"></ul>
    </details>
  </section>
</div>

<script>
  import { platforms } from "../data/platforms";
  import sources from "../data/sources.json";
  import { buildInvoiceJourney, findJourneyProfile, type ActivationAnswer, type InvoiceJourney, type JourneyAudience } from "../lib/journey";
  import { verifyKnownTool } from "../lib/tool-verifier";

  const form = document.querySelector<HTMLFormElement>("#tool-verifier-form");
  const input = document.querySelector<HTMLInputElement>("#tool-name");
  const context = document.querySelector<HTMLElement>("#journey-context");
  const contextForm = document.querySelector<HTMLFormElement>("#journey-context-form");
  const activationQuestion = document.querySelector<HTMLElement>("#activation-question");
  const contextTitle = document.querySelector<HTMLElement>("#journey-context-title");
  const journeyResult = document.querySelector<HTMLElement>("#journey-result");
  const genericResult = document.querySelector<HTMLElement>("#tool-verifier-result");
  const quickToolButtons = document.querySelectorAll<HTMLButtonElement>("[data-tool-example]");
  const refineJourney = document.querySelector<HTMLButtonElement>("#refine-journey");
  const homeHero = form?.closest<HTMLElement>(".hero");

  const verdictLabels = { keep: "Garder", act: "Changer", unconfirmed: "Compléter" } as const;
  const journeyStatusLabels = { ready: "Prêt selon vos réponses", action: "Action nécessaire", confirm: "À vérifier" } as const;
  let copyText = "";
  let currentInput: { tool: string; audience: JourneyAudience; activation: ActivationAnswer } | null = null;

  const byId = <T extends HTMLElement>(id: string) => document.querySelector<T>(`#${id}`);
  const element = (tag: string, value: string, className?: string) => {
    const node = document.createElement(tag);
    node.textContent = value;
    if (className) node.className = className;
    return node;
  };
  const formatDate = (value: string) => /^\d{4}-\d{2}-\d{2}$/.test(value) ? value.split("-").reverse().join("/") : value;
  const formatEuro = (value: number) => new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(value);
  const scrollTo = (node: HTMLElement) => node.scrollIntoView({
    behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
    block: "nearest",
  });
  const linkedSources = (sourceIds: Iterable<string>) => {
    const selected = new Set(sourceIds);
    return sources.filter((source) => selected.has(source.id));
  };
  const expandHomeJourney = (expanded: boolean) => homeHero?.classList.toggle("journey-expanded", expanded);
  const renderSources = (list: HTMLElement, sourceIds: Iterable<string>) => {
    list.replaceChildren(...linkedSources(sourceIds).map((source) => {
      const item = document.createElement("li");
      const link = document.createElement("a");
      link.href = source.url;
      link.rel = "noopener";
      link.textContent = `${source.title} · ${source.publisher}`;
      item.append(link, element("small", `Consulté le ${formatDate(source.accessedAt)}`));
      return item;
    }));
  };

  const renderGeneric = () => {
    if (!input || !genericResult || !context || !journeyResult) return;
    const verification = verifyKnownTool(platforms, input.value);
    const verdictLabel = byId<HTMLElement>("tool-verdict-label");
    const platformName = byId<HTMLElement>("tool-platform-name");
    const verdictTitle = byId<HTMLElement>("tool-verdict-title");
    const verdictExplanation = byId<HTMLElement>("tool-verdict-explanation");
    const verdictLines = byId<HTMLElement>("tool-verdict-lines");
    const nextAction = byId<HTMLElement>("tool-next-action");
    const profileLink = byId<HTMLAnchorElement>("tool-profile-link");
    const sourceDetails = byId<HTMLDetailsElement>("tool-sources-details");
    const sourceList = byId<HTMLElement>("tool-source-list");
    if (!verdictLabel || !platformName || !verdictTitle || !verdictExplanation || !verdictLines || !nextAction || !profileLink || !sourceDetails || !sourceList) return;

    genericResult.dataset.verdict = verification.verdict;
    verdictLabel.textContent = verdictLabels[verification.verdict];
    platformName.textContent = verification.tool?.label ?? "Outil absent de notre sélection actuelle";
    verdictTitle.textContent = verification.headline;
    verdictExplanation.textContent = verification.explanation;
    nextAction.textContent = verification.action;
    verdictLines.replaceChildren(...verification.lines.map((line) => {
      const row = document.createElement("div");
      row.dataset.state = line.state;
      row.append(element("span", line.label), element("strong", line.value));
      return row;
    }));
    profileLink.href = verification.platform ? `/plateformes/${verification.platform.slug}/` : "/diagnostic/";
    profileLink.textContent = verification.platform ? "Voir la fiche complète" : "Voir les plateformes étudiées";
    if (refineJourney) refineJourney.hidden = findJourneyProfile(input.value) === null;

    const sourceIds = verification.lines.flatMap((line) => line.evidence?.sourceIds ?? []);
    renderSources(sourceList, sourceIds);
    sourceDetails.hidden = sourceIds.length === 0;
    const checkedAt = verification.lines.map((line) => line.evidence?.checkedAt).filter((date): date is string => Boolean(date)).sort().at(-1);
    copyText = [
      "PA Check · Point sur mon outil",
      `Outil : ${verification.tool?.label ?? "absent de la sélection actuelle"}`,
      `Conclusion : ${verdictLabels[verification.verdict]}`,
      verification.explanation,
      `Action : ${verification.action}`,
      ...verification.lines.map((line) => `${line.label} : ${line.value}`),
      checkedAt ? `Informations vérifiées le ${formatDate(checkedAt)}` : "",
      ...linkedSources(sourceIds).map((source) => source.url),
    ].filter(Boolean).join("\n");
    context.hidden = true;
    journeyResult.hidden = true;
    genericResult.hidden = false;
    expandHomeJourney(false);
    scrollTo(genericResult);
  };

  const prepareJourney = () => {
    if (!input || !context || !activationQuestion || !journeyResult || !genericResult) return;
    const draft = buildInvoiceJourney(platforms, { tool: input.value, audience: "micro", activation: "unknown" });
    if (!draft) return renderGeneric();
    activationQuestion.textContent = draft.activationQuestion;
    genericResult.hidden = true;
    journeyResult.hidden = true;
    context.hidden = false;
    expandHomeJourney(false);
    scrollTo(context);
    contextTitle?.focus({ preventScroll: true });
  };

  const renderJourney = (journey: InvoiceJourney) => {
    if (!journeyResult || !context || !genericResult) return;
    const status = byId<HTMLElement>("journey-status");
    const tool = byId<HTMLElement>("journey-tool");
    const title = byId<HTMLElement>("journey-title");
    const summary = byId<HTMLElement>("journey-summary");
    const rail = byId<HTMLOListElement>("journey-rail");
    const deadlines = byId<HTMLElement>("journey-deadlines");
    const paCost = byId<HTMLElement>("journey-pa-cost");
    const costLabel = byId<HTMLElement>("journey-cost-label");
    const costHorizons = byId<HTMLElement>("journey-cost-horizons");
    const costCaveat = byId<HTMLElement>("journey-cost-caveat");
    const actions = byId<HTMLOListElement>("journey-actions");
    const profileLink = byId<HTMLAnchorElement>("journey-profile-link");
    const sourceList = byId<HTMLElement>("journey-source-list");
    if (!status || !tool || !title || !summary || !rail || !deadlines || !paCost || !costLabel || !costHorizons || !costCaveat || !actions || !profileLink || !sourceList) return;

    journeyResult.dataset.status = journey.status;
    status.textContent = journeyStatusLabels[journey.status];
    tool.textContent = journey.toolLabel;
    title.textContent = journey.headline;
    summary.textContent = journey.summary;
    const usefulNodes = [journey.nodes[0], journey.nodes[1], journey.nodes[3]].filter((node): node is InvoiceJourney["nodes"][number] => Boolean(node));
    rail.replaceChildren(...usefulNodes.map((node, index) => {
      const item = document.createElement("li");
      item.dataset.state = node.state;
      item.append(element("span", String(index + 1).padStart(2, "0"), "rail-index"), element("small", node.label), element("strong", node.value), element("p", node.detail));
      return item;
    }));
    deadlines.replaceChildren(...journey.deadlines.map((deadline) => {
      const card = document.createElement("div");
      card.append(element("span", deadline.label), element("strong", deadline.date), element("p", deadline.detail));
      return card;
    }));
    paCost.textContent = journey.cost.paMonthlySurcharge === null
      ? "À confirmer"
      : `${formatEuro(journey.cost.paMonthlySurcharge)} HT`;
    paCost.dataset.known = journey.cost.paMonthlySurcharge === null ? "false" : "true";
    costLabel.textContent = journey.cost.label;
    costHorizons.dataset.known = journey.cost.baseMonthlyFrom === null ? "false" : "true";
    costHorizons.replaceChildren(...(journey.cost.horizons.length > 0
      ? journey.cost.horizons.map((horizon) => {
          const card = document.createElement("div");
          const amount = journey.cost.baseMonthlyFrom === 0 ? `${formatEuro(horizon.minimum)} HT` : `dès ${formatEuro(horizon.minimum)} HT`;
          card.append(element("span", `${horizon.months} mois`), element("strong", amount));
          return card;
        })
      : [(() => {
          const card = document.createElement("div");
          card.append(element("span", "Projection 12, 24 et 36 mois"), element("strong", "Impossible sans minimum public"));
          return card;
        })()]));
    costCaveat.textContent = journey.cost.caveat;
    actions.replaceChildren(...journey.actions.map((action) => {
      const item = document.createElement("li");
      item.append(element("strong", action.title), element("p", action.detail));
      return item;
    }));
    profileLink.href = `/plateformes/${journey.platformSlug}/`;

    const sourceIds = new Set([
      ...journey.nodes.flatMap((node) => node.sourceIds),
      ...journey.deadlines.flatMap((deadline) => deadline.sourceIds),
      ...journey.cost.sourceIds,
      ...journey.actions.flatMap((action) => action.sourceIds),
    ]);
    renderSources(sourceList, sourceIds);
    const audience = currentInput?.audience === "eti-ge"
      ? "ETI ou grande entreprise"
      : currentInput?.audience === "tpe-pme"
        ? "TPE ou PME"
        : "Micro-entrepreneur";
    copyText = [
      "PA Check · Mon parcours facture",
      `Outil : ${journey.toolLabel}`,
      `Entreprise : ${audience}`,
      `Situation : ${journeyStatusLabels[journey.status]}`,
      journey.summary,
      "", "Circuit",
      ...usefulNodes.map((node) => `${node.label} : ${node.value}`),
      "", "Échéances",
      ...journey.deadlines.map((deadline) => `${deadline.label} : ${deadline.date}`),
      "", `Surcoût PA : ${journey.cost.paMonthlySurcharge === null ? "à confirmer" : `${formatEuro(journey.cost.paMonthlySurcharge)} HT par mois`}`,
      ...journey.cost.horizons.map((horizon) => `${horizon.months} mois : ${journey.cost.baseMonthlyFrom === 0 ? "" : "dès "}${formatEuro(horizon.minimum)} HT`),
      ...(journey.cost.baseMonthlyFrom === null ? ["Projection 12, 24 et 36 mois : impossible sans minimum public"] : []),
      journey.cost.caveat,
      "", "Prochaines étapes",
      ...journey.actions.map((action, index) => `${index + 1}. ${action.title} : ${action.detail}`),
      "", ...linkedSources(sourceIds).map((source) => source.url),
    ].join("\n");
    genericResult.hidden = true;
    context.hidden = true;
    journeyResult.hidden = false;
    expandHomeJourney(true);
    scrollTo(journeyResult);
  };

  const startVerification = () => {
    if (!input) return;
    renderGeneric();
  };
  form?.addEventListener("submit", (event) => { event.preventDefault(); startVerification(); });
  refineJourney?.addEventListener("click", prepareJourney);
  quickToolButtons.forEach((button) => button.addEventListener("click", () => {
    if (!input) return;
    input.value = button.dataset.toolExample ?? "";
    startVerification();
  }));
  contextForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!input || !contextForm) return;
    const values = new FormData(contextForm);
    const audience = values.get("audience");
    const activation = values.get("activation");
    if (audience !== "micro" && audience !== "tpe-pme" && audience !== "eti-ge") return;
    if (activation !== "yes" && activation !== "no" && activation !== "unknown") return;
    currentInput = { tool: input.value, audience, activation };
    const journey = buildInvoiceJourney(platforms, currentInput);
    if (journey) renderJourney(journey);
  });
  byId<HTMLButtonElement>("copy-tool-answer")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(copyText); button.textContent = "Résumé copié"; }
    catch { button.textContent = "Copie refusée par le navigateur"; }
  });
  byId<HTMLButtonElement>("copy-journey")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(copyText); button.textContent = "Actions copiées"; }
    catch { button.textContent = "Copie refusée par le navigateur"; }
  });
  byId<HTMLButtonElement>("edit-journey")?.addEventListener("click", () => {
    if (!context || !journeyResult) return;
    journeyResult.hidden = true;
    context.hidden = false;
    expandHomeJourney(false);
    scrollTo(context);
    contextTitle?.focus({ preventScroll: true });
  });
  const requestedTool = new URLSearchParams(location.hash.slice(1)).get("outil")?.trim();
  if (input && requestedTool && requestedTool.length <= 80) {
    input.value = requestedTool;
    startVerification();
  }
</script>

<style>
  .tool-verifier [hidden] { display: none !important; }
  .tool-verifier { overflow: hidden; border: 1px solid color-mix(in srgb, var(--signal) 20%, var(--line)); border-radius: 1.35rem; background: rgba(255,255,255,.94); box-shadow: 0 1.6rem 4.5rem rgba(41,57,86,.12); }
  .tool-card-head { display: grid; grid-template-columns: auto 1fr auto; gap: .75rem; align-items: center; padding: .85rem 1rem; background: linear-gradient(135deg, var(--signal-soft), rgba(255,255,255,.72)); }
  .tool-card-icon { display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border-radius: .7rem; background: #fff; color: var(--signal); box-shadow: inset 0 0 0 1px var(--line); }
  .tool-card-head > span:nth-child(2) { display: grid; }
  .tool-card-head small, .tool-card-head b, .step-label { color: var(--signal); font-size: .78rem; font-weight: 740; letter-spacing: .05em; text-transform: uppercase; }
  .tool-card-head strong { color: var(--bright); font-size: .82rem; font-weight: 660; }
  .tool-card-head b { color: var(--muted); }
  .tool-search, .journey-context, .tool-result, .journey-result { padding: clamp(1.2rem, 3vw, 1.7rem); }
  .tool-search > label { display: block; margin: .45rem 0 .75rem; color: var(--bright); font-size: clamp(1.15rem, 2vw, 1.35rem); font-weight: 720; letter-spacing: -.025em; }
  .tool-search-row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .55rem; }
  .search-icon { position: absolute; top: 50%; left: .9rem; z-index: 1; translate: 0 -50%; color: var(--muted); pointer-events: none; }
  .tool-search input { min-width: 0; min-height: 3.45rem; border: 1px solid var(--line-strong); border-radius: .75rem; padding: .8rem 1rem .8rem 2.8rem; outline: 0; background: #fff; color: var(--bright); }
  .tool-search input:focus { border-color: var(--signal); box-shadow: 0 0 0 3px color-mix(in srgb, var(--signal) 14%, transparent); }
  .tool-search button, .primary-action, .verdict-actions button { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 3.15rem; border: 1px solid var(--signal); border-radius: .75rem; padding: .75rem 1rem; background: var(--signal); color: #fff; cursor: pointer; font-size: .76rem; font-weight: 740; }
  .tool-search button:hover, .primary-action:hover { background: #334cc8; }
  .tool-search button :global(svg), .primary-action :global(svg), .verdict-actions :global(svg) { width: 1rem; height: 1rem; }
  .quick-tools { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; margin-top: .8rem; }
  .quick-tools > span { margin-right: .15rem; color: var(--muted); font-size: .78rem; font-weight: 620; }
  .quick-tools button { min-height: 1.9rem; border: 0; border-radius: 999px; padding: .4rem .62rem; background: var(--surface-2); color: var(--paper); font-size: .78rem; }
  .quick-tools button:hover, .quick-tools button:focus-visible { background: var(--signal-soft); color: var(--signal); }
