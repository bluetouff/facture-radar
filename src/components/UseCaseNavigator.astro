---
import InterfaceIcon from "./InterfaceIcon.astro";

const useCases = [
  { href: "/verifier-mon-outil/#verifier-logiciel", label: "Puis-je garder mon outil actuel ?", detail: "Entrez son nom et obtenez la prochaine action", icon: "search", tone: "violet" },
  { href: "/diagnostic/", label: "Quelle plateforme regarder ?", detail: "Trois questions, puis toutes les options pertinentes", icon: "target", tone: "green" },
  { href: "/verifier-une-facture/", label: "Ma facture est-elle prête ?", detail: "Contrôlez un Factur-X ou un XML sur votre appareil", icon: "invoice", tone: "blue" },
] as const;
---

<section class="usecase-navigator" aria-labelledby="usecase-title">
  <header>
    <div><small>Choisissez votre situation</small><h2 id="usecase-title">Quelle question vous amène&nbsp;?</h2></div>
    <span><i></i> 3 réponses sans compte</span>
  </header>
  <div class="usecase-grid">
    {useCases.map(({ href, label, detail, icon, tone }, index) => (
      <a class={`usecase tone-${tone}`} href={href}>
        <span class="case-number">{String(index + 1).padStart(2, "0")}</span>
        <span class="case-icon"><InterfaceIcon name={icon} /></span>
        <span class="case-copy"><strong>{label}</strong><small>{detail}</small></span>
        <InterfaceIcon name="arrow" />
      </a>
    ))}
  </div>
  <a class="question-library-link" href="/questions/"><span>Voir les 10 questions pratiques</span><InterfaceIcon name="arrow" /></a>
</section>

<style>
  .usecase-navigator { overflow: hidden; border: 1px solid rgba(187,199,255,.2); border-radius: 1.35rem; background: rgba(249,251,255,.97); color: var(--paper); box-shadow: 0 1.6rem 4rem rgba(2,8,25,.24); }
  header { display: flex; justify-content: space-between; gap: 1rem; align-items: center; border-bottom: 1px solid var(--line); padding: 1rem 1.1rem; background: linear-gradient(115deg,#fff,var(--signal-soft)); }
  header > div { min-width: 0; }
  header small { color: var(--signal); font-size: .76rem; font-weight: 750; letter-spacing: .05em; text-transform: uppercase; }
  header h2 { margin: .12rem 0 0; color: var(--bright); font-size: 1.08rem; letter-spacing: -.025em; }
  header > span { display: inline-flex; gap: .4rem; align-items: center; color: var(--muted); font-size: .76rem; font-weight: 620; white-space: nowrap; }
  header i { width: .5rem; height: .5rem; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 .2rem var(--success-soft); }
  .usecase-grid { display: grid; gap: .55rem; padding: .75rem; }
  .usecase { --case-tone: var(--signal); --case-soft: var(--signal-soft); display: grid; min-width: 0; grid-template-columns: auto auto 1fr auto; gap: .75rem; align-items: center; border: 1px solid var(--line); border-radius: .9rem; padding: .85rem; background: #fff; color: var(--paper); transition: border-color 160ms ease,translate 160ms ease,box-shadow 160ms ease; }
  .usecase.tone-violet { --case-tone: #7256d7; --case-soft: #f2efff; }
  .usecase.tone-blue { --case-tone: #3574b4; --case-soft: #edf6ff; }
  .usecase.tone-green { --case-tone: #168065; --case-soft: #eaf8f3; }
  .usecase:hover { translate: 0 -2px; border-color: color-mix(in srgb,var(--case-tone) 35%,var(--line)); color: inherit; box-shadow: 0 .55rem 1.2rem rgba(41,57,86,.08); }
  .case-number { color: var(--muted); font: 650 .75rem/1 var(--font-mono); }
  .case-icon { display: grid; flex: 0 0 auto; place-items: center; width: 2.35rem; height: 2.35rem; border-radius: .72rem; background: var(--case-soft); color: var(--case-tone); }
  .case-icon :global(svg) { width: 1.05rem; height: 1.05rem; }
  .case-copy { display: grid; min-width: 0; }
  .case-copy strong { color: var(--bright); font-size: .9rem; line-height: 1.3; }
  .case-copy small { margin-top: .12rem; color: var(--muted); font-size: .78rem; line-height: 1.4; }
  .usecase > :global(svg) { width: .85rem; height: .85rem; color: var(--case-tone); }
  .question-library-link { display: flex; justify-content: space-between; gap: 1rem; align-items: center; border-top: 1px solid var(--line); padding: .8rem 1rem; background: var(--surface-2); color: var(--signal); font-size: .76rem; font-weight: 710; }
  .question-library-link :global(svg) { width: .85rem; }
  @media (max-width: 620px) { header { align-items: flex-start; } header > span { display: none; } }
</style>
