---
import InterfaceIcon from "./InterfaceIcon.astro";
import { practicalQuestions } from "../data/practical-questions";

const useCases = [
  { href: "/verifier-mon-outil/#verifier-logiciel", label: "Garder mon outil", detail: "Entrez son nom et obtenez la prochaine action", icon: "search", tone: "violet" },
  { href: "/diagnostic/", label: "Choisir ma plateforme", detail: "Trois questions, puis toutes les options pertinentes", icon: "target", tone: "green" },
  { href: "/verifier-une-facture/", label: "Contrôler une facture", detail: "Contrôlez un Factur-X ou un XML sur votre appareil", icon: "invoice", tone: "blue" },
] as const;
---

<section class="usecase-navigator" aria-labelledby="usecase-title">
  <div class="finder-console">
  <header>
    <div><small>01 / Une question, un point de départ</small><h2 id="usecase-title">On commence par vous.</h2></div>
    <span><i></i> Sans compte · recherche locale</span>
  </header>
  <div class="answer-finder" id="answer-finder" role="search" hidden>
    <label for="answer-query">Écrivez quelques mots ou le nom de votre outil</label>
    <div class="answer-search-row">
      <span class="answer-search-icon"><InterfaceIcon name="search" /></span>
      <input
        id="answer-query"
        name="question"
        type="search"
        role="combobox"
        aria-autocomplete="list"
        maxlength="120"
        autocomplete="off"
        spellcheck="false"
        aria-controls="answer-suggestions"
        aria-expanded="false"
        placeholder="Un outil, une question… Ex. Tiime, offre gratuite"
      />
      <button type="button" id="answer-submit">Trouver la réponse <InterfaceIcon name="arrow" /></button>
    </div>
    <div class="answer-examples" aria-label="Exemples de recherches">
      <span>Réponses rapides</span>
      <button type="button" data-answer-example="quand dois-je être prêt">Mes échéances</button>
      <button type="button" data-answer-example="plateforme vraiment agréée">Vérifier un agrément</button>
      <button type="button" data-answer-example="factur-x sans intermédiaire">Factur-X déjà prêt</button>
      <button type="button" data-answer-example="garder mon logiciel">Garder mon outil</button>
      <button type="button" data-answer-example="pdf envoyé par email">PDF par email</button>
      <button type="button" data-answer-example="facture électronique e-reporting">Comprendre l'e-reporting</button>
    </div>
    <div class="answer-suggestions" id="answer-suggestions" role="listbox" aria-label="Réponses proposées" hidden></div>
    <p class="answer-empty" id="answer-empty" hidden>Cette formulation ne correspond pas encore à une réponse directe. Consultez les questions pratiques ou utilisez l'un des trois parcours ci-dessous.</p>
  </div>
  </div>
  <p class="shortcut-label">02 / Ou avancez directement</p>
  <div class="usecase-grid">
    {useCases.map(({ href, label, detail, icon, tone }, index) => (
      <a class={`usecase tone-${tone}`} href={href}>
        <span class="case-number">{String(index + 1).padStart(2, "0")}</span>
        <span class="case-icon"><InterfaceIcon name={icon} /></span>
        <span class="case-copy"><strong>{label}</strong><small>{detail}</small></span>
        <InterfaceIcon name="arrow" />
      </a>
    ))}
  </div>
  <a class="question-library-link" href="/questions/"><span>Voir les {practicalQuestions.length} questions pratiques</span><InterfaceIcon name="arrow" /></a>
</section>

<script>
  import { findAnswers, type FinderEntry } from "../lib/answer-finder";

  const finder = document.querySelector<HTMLElement>("#answer-finder");
  if (finder) finder.hidden = false;
  const input = document.querySelector<HTMLInputElement>("#answer-query");
  const submit = document.querySelector<HTMLButtonElement>("#answer-submit");
  const suggestions = document.querySelector<HTMLElement>("#answer-suggestions");
  const empty = document.querySelector<HTMLElement>("#answer-empty");
  const exampleButtons = document.querySelectorAll<HTMLButtonElement>("[data-answer-example]");
  let visibleEntries: FinderEntry[] = [];

  const closeSuggestions = () => {
    if (!suggestions || !input) return;
    suggestions.hidden = true;
    input.setAttribute("aria-expanded", "false");
  };

  const render = () => {
    if (!input || !suggestions || !empty) return;
    suggestions.replaceChildren();
    empty.hidden = true;
    if (input.value.trim().length < 2) {
      visibleEntries = [];
      closeSuggestions();
      return;
    }
    visibleEntries = findAnswers(input.value);
    if (!visibleEntries.length) {
      closeSuggestions();
      empty.hidden = false;
      return;
    }
    suggestions.replaceChildren(...visibleEntries.map((entry, index) => {
      const link = document.createElement("a");
      link.href = entry.href;
      link.setAttribute("role", "option");
      link.dataset.index = String(index);
      const copy = document.createElement("span");
      const kind = document.createElement("small");
      const label = document.createElement("strong");
      const detail = document.createElement("p");
      kind.textContent = entry.kind;
      label.textContent = entry.label;
      detail.textContent = entry.detail;
      copy.append(kind, label, detail);
      const arrow = document.createElement("b");
      arrow.setAttribute("aria-hidden", "true");
      arrow.textContent = "→";
      link.append(copy, arrow);
      return link;
    }));
    suggestions.hidden = false;
    input.setAttribute("aria-expanded", "true");
  };

  document.querySelectorAll<HTMLAnchorElement>("[data-answer-open]").forEach(link => link.addEventListener("click", event => {
    if (!finder || !input) return;
    event.preventDefault();
    input.focus({ preventScroll: true });
    finder.scrollIntoView({ block: "start" });
  }));
  input?.addEventListener("input", render);
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSuggestions();
    if (event.key === "Enter") {
      event.preventDefault();
      if (visibleEntries[0]) location.assign(visibleEntries[0].href);
      else render();
    }
    if (event.key === "ArrowDown" && !suggestions?.hidden) {
      event.preventDefault();
      suggestions?.querySelector<HTMLAnchorElement>("a")?.focus();
    }
  });
  suggestions?.addEventListener("keydown", (event) => {
    const links = [...suggestions.querySelectorAll<HTMLAnchorElement>("a")];
    const current = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (event.key === "ArrowDown" && current < links.length - 1) {
      event.preventDefault();
      links[current + 1]?.focus();
    }
    if (event.key === "ArrowUp") {
      event.preventDefault();
      if (current <= 0) input?.focus();
      else links[current - 1]?.focus();
    }
    if (event.key === "Escape") {
      closeSuggestions();
      input?.focus();
    }
  });
  submit?.addEventListener("click", () => {
    if (visibleEntries[0]) location.assign(visibleEntries[0].href);
    else render();
  });
  exampleButtons.forEach((button) => button.addEventListener("click", () => {
    if (!input) return;
    input.value = button.dataset.answerExample ?? "";
    input.focus();
    render();
  }));
</script>

<style>
  .usecase-navigator { min-width: 0; }
  .finder-console { border-radius: .9rem; background: var(--bright); color: #eeeae0; padding: clamp(1.25rem,3vw,2.5rem); }
  header { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-bottom: 1.7rem; }
  header small, .shortcut-label { font: .68rem/1.5 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
  header small { color: #c1c0b5; }
  header h2 { margin: .65rem 0 0; color: #fffaf0; font: 520 clamp(1.8rem,3.2vw,2.7rem)/1.1 var(--font-sans); letter-spacing: -.055em; }
  header > span { display: inline-flex; gap: .5rem; align-items: center; color: #cbc9bd; font-size: .72rem; white-space: nowrap; }
  header i { width: .35rem; height: .35rem; border-radius: 50%; background: #f6a078; }
  .answer-finder { scroll-margin-top: 7rem; }
  .answer-finder > label { display: block; margin-bottom: .65rem; color: #d0cec3; font-size: .8rem; }
  .answer-search-row { display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; border: 1px solid #ece9dd; border-radius: .5rem; background: #fffdf8; }
  .answer-search-row:focus-within { outline: 2px solid #ffab87; outline-offset: 4px; }
  .answer-search-icon { display: grid; place-items: center; width: 3.4rem; color: var(--signal); }
  .answer-search-icon :global(svg) { width: 1.3rem; height: 1.3rem; }
  .answer-search-row input { min-width: 0; min-height: 4.2rem; border: 0; outline: 0; background: transparent; color: var(--bright); font: 450 1rem/1.3 var(--font-sans); }
  .answer-search-row input::placeholder { color: #76766c; }
  .answer-search-row button { display: inline-flex; justify-content: center; gap: .7rem; align-items: center; min-height: 3.25rem; margin: .4rem; border: 0; border-radius: .3rem; padding: .8rem 1.2rem; background: var(--signal); color: #fff; cursor: pointer; font: 550 .85rem/1.3 var(--font-sans); }
  .answer-search-row button:hover { background: #972d16; }
  .answer-search-row button :global(svg) { width: 1rem; }
  .answer-examples { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-top: 1.1rem; }
  .answer-examples span { color: #c6c5ba; font-size: .72rem; margin-right: .2rem; }
  .answer-examples button { border: 1px solid #626357; border-radius: .3rem; min-height: 2.25rem; padding: .45rem .65rem; background: transparent; color: #e9e6dd; cursor: pointer; font: 450 .73rem/1.2 var(--font-sans); transition: background 160ms; }
  .answer-examples button:hover { background: #414337; border-color: #9a9d8b; }
  .answer-suggestions { margin-top: 1rem; border-radius: .5rem; overflow: hidden; background: #fffdf8; }
  .answer-suggestions :global(a) { display: grid; grid-template-columns: 1fr auto; gap: .8rem; align-items: center; border-top: 1px solid var(--line); padding: 1rem 1.2rem; color: var(--paper); }
  .answer-suggestions :global(a:first-child) { border-top: 0; }
  .answer-suggestions :global(a:hover), .answer-suggestions :global(a:focus-visible) { background: var(--signal-soft); outline: 2px solid var(--signal); outline-offset: -2px; }
  .answer-suggestions :global(small) { display: block; color: var(--signal); font: .65rem/1.4 var(--font-mono); text-transform: uppercase; }
  .answer-suggestions :global(strong) { display: block; margin-top: .3rem; color: var(--bright); font-size: 1rem; }
  .answer-suggestions :global(p) { margin: .25rem 0 0; color: var(--muted); font-size: .82rem; line-height: 1.5; }
  .answer-suggestions :global(b) { color: var(--signal); }
  .answer-empty { margin: 1rem 0 0; border-left: 2px solid #ffa279; padding-left: .8rem; font-size: .88rem; }
  .shortcut-label { margin: 2rem 0 1rem; color: var(--muted); }
  .usecase-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .usecase { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: start; min-width: 0; padding: 1.5rem; border: 1px solid var(--line); border-radius: .5rem; background: #fffcf6; transition: border-color 180ms ease, translate 180ms ease, box-shadow 180ms ease; }
  .usecase:hover { translate: 0 -4px; box-shadow: 0 10px 20px #23251f08; border-color: #c47150; color: inherit; }
  .case-number { grid-column: 2; grid-row: 1; color: #c6c3b6; font: 420 2.7rem/1 var(--font-sans); letter-spacing: -.06em; }
  .case-icon { display: grid; place-items: center; grid-column: 1; grid-row: 1; width: 2.7rem; height: 2.7rem; border: 1px solid #dedbd2; border-radius: .6rem; color: var(--signal); }
  .case-icon :global(svg) { width: 1.3rem; height: 1.3rem; }
  .case-copy { grid-column: 1 / -1; display: grid; gap: .55rem; min-width: 0; }
  .case-copy strong { color: var(--bright); font-size: 1.15rem; font-weight: 580; line-height: 1.3; letter-spacing: -.025em; }
  .case-copy small { color: var(--muted); font-size: .84rem; line-height: 1.65; max-width: 28ch; }
  .usecase > :global(svg) { grid-column: 2; grid-row: 3; justify-self: end; color: var(--signal); width: 1.2rem; transition: translate 160ms; }
  .usecase:hover > :global(svg) { translate: 3px 0; }
  .question-library-link { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem 0; margin-top: .7rem; border-bottom: 1px solid var(--line); color: var(--bright); font-size: .8rem; }
  .question-library-link :global(svg) { width: 1rem; }
  .finder-console button:focus-visible { outline-color: #ffa279; }
  @media (max-width: 700px) {
    .usecase-grid { grid-template-columns: 1fr; gap: .6rem; }
    .usecase { grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; padding: 1.2rem 1rem; }
    .case-number { display: none; }
    .case-icon { grid-column: 1; grid-row: 1; width: 2.6rem; }
    .case-copy { grid-column: 2; grid-row: 1; }
    .case-copy strong { font-size: 1rem; }
    .case-copy small { max-width: none; font-size: .8rem; }
    .usecase > :global(svg) { grid-column: 3; grid-row: 1; }
    header > span { display: none; }
    .answer-search-row { grid-template-columns: auto minmax(0,1fr); }
    .answer-search-icon { width: 2.5rem; }
    .answer-search-row input { min-height: 3.5rem; }
    .answer-search-row button { grid-column: 1 / -1; margin: .2rem .4rem .4rem; }
    .answer-examples span { flex-basis: 100%; }
  }
</style>
