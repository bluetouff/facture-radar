---
import InterfaceIcon from "./InterfaceIcon.astro";
import ChapterIcon from "./ChapterIcon.astro";
import { practicalQuestions } from "../data/practical-questions";

const useCases = [
  { href: "/verifier-mon-outil/#verifier-logiciel", label: "Puis-je garder mon outil actuel ?", detail: "Entrez son nom et obtenez la prochaine action", icon: "search", tone: "violet" },
  { href: "/diagnostic/", label: "Quelle plateforme regarder ?", detail: "Trois questions, puis toutes les options pertinentes", icon: "target", tone: "green" },
  { href: "/verifier-une-facture/", label: "Ma facture est-elle prête ?", detail: "Contrôlez un Factur-X ou un XML sur votre appareil", icon: "invoice", tone: "blue" },
] as const;
---

<section class="usecase-navigator" aria-labelledby="usecase-title">
  <header>
    <div><small>Décrivez simplement votre besoin</small><h2 id="usecase-title">Quelle question vous amène&nbsp;?</h2></div>
    <span><i></i> réponse locale, sans compte</span>
  </header>
  <div class="answer-finder" id="answer-finder" role="search">
    <label for="answer-query">Écrivez quelques mots ou le nom de votre outil</label>
    <div class="answer-search-row">
      <span class="answer-search-icon"><InterfaceIcon name="search" /></span>
      <input
        id="answer-query"
        name="question"
        type="search"
        maxlength="120"
        autocomplete="off"
        spellcheck="false"
        aria-controls="answer-suggestions"
        aria-expanded="false"
        placeholder="Ex. Factur-X sans intermédiaire, Tiime, offre gratuite…"
      />
      <button type="button" id="answer-submit">Trouver la réponse <InterfaceIcon name="arrow" /></button>
    </div>
    <div class="answer-examples" aria-label="Exemples de recherches">
      <span>Réponses rapides</span>
      <button type="button" data-answer-example="quand dois-je être prêt">Mes échéances</button>
      <button type="button" data-answer-example="plateforme vraiment agréée">Vérifier un agrément</button>
      <button type="button" data-answer-example="factur-x sans intermédiaire">Factur-X déjà prêt</button>
      <button type="button" data-answer-example="garder mon logiciel">Garder mon outil</button>
      <button type="button" data-answer-example="pdf envoyé par email">PDF par email</button>
      <button type="button" data-answer-example="facture électronique e-reporting">Comprendre l'e-reporting</button>
    </div>
    <div class="answer-suggestions" id="answer-suggestions" role="listbox" aria-label="Réponses proposées" hidden></div>
    <p class="answer-empty" id="answer-empty" hidden>Cette formulation ne correspond pas encore à une réponse directe. Consultez les questions pratiques ou utilisez l'un des trois parcours ci-dessous.</p>
  </div>
  <p class="shortcut-label">Ou choisissez votre situation</p>
  <div class="usecase-grid">
    {useCases.map(({ href, label, detail, icon, tone }, index) => (
      <a class={`usecase tone-${tone}`} href={href}>
        <span class="case-number">{String(index + 1).padStart(2, "0")}</span>
        <span class="case-icon"><ChapterIcon kind={icon === "search" ? "tool" : icon === "target" ? "platform" : "invoice"} /></span>
        <span class="case-copy"><strong>{label}</strong><small>{detail}</small></span>
        <InterfaceIcon name="arrow" />
      </a>
    ))}
  </div>
  <a class="question-library-link" href="/questions/"><span>Voir les {practicalQuestions.length} questions pratiques</span><InterfaceIcon name="arrow" /></a>
</section>

<script>
  import { findAnswers, type FinderEntry } from "../lib/answer-finder";

  const input = document.querySelector<HTMLInputElement>("#answer-query");
  const submit = document.querySelector<HTMLButtonElement>("#answer-submit");
  const suggestions = document.querySelector<HTMLElement>("#answer-suggestions");
  const empty = document.querySelector<HTMLElement>("#answer-empty");
  const exampleButtons = document.querySelectorAll<HTMLButtonElement>("[data-answer-example]");
  let visibleEntries: FinderEntry[] = [];

  const closeSuggestions = () => {
    if (!suggestions || !input) return;
    suggestions.hidden = true;
    input.setAttribute("aria-expanded", "false");
  };

  const render = () => {
    if (!input || !suggestions || !empty) return;
    suggestions.replaceChildren();
    empty.hidden = true;
    if (input.value.trim().length < 2) {
      visibleEntries = [];
      closeSuggestions();
      return;
    }
    visibleEntries = findAnswers(input.value);
    if (!visibleEntries.length) {
      closeSuggestions();
      empty.hidden = false;
      return;
    }
    suggestions.replaceChildren(...visibleEntries.map((entry, index) => {
      const link = document.createElement("a");
      link.href = entry.href;
      link.setAttribute("role", "option");
      link.dataset.index = String(index);
      const copy = document.createElement("span");
      const kind = document.createElement("small");
      const label = document.createElement("strong");
      const detail = document.createElement("p");
      kind.textContent = entry.kind;
      label.textContent = entry.label;
      detail.textContent = entry.detail;
      copy.append(kind, label, detail);
      const arrow = document.createElement("b");
      arrow.setAttribute("aria-hidden", "true");
      arrow.textContent = "→";
      link.append(copy, arrow);
      return link;
    }));
    suggestions.hidden = false;
    input.setAttribute("aria-expanded", "true");
  };

  input?.addEventListener("input", render);
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSuggestions();
    if (event.key === "Enter") {
      event.preventDefault();
      if (visibleEntries[0]) location.assign(visibleEntries[0].href);
      else render();
    }
    if (event.key === "ArrowDown" && !suggestions?.hidden) {
      event.preventDefault();
      suggestions?.querySelector<HTMLAnchorElement>("a")?.focus();
    }
  });
  suggestions?.addEventListener("keydown", (event) => {
    const links = [...suggestions.querySelectorAll<HTMLAnchorElement>("a")];
    const current = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (event.key === "ArrowDown" && current < links.length - 1) {
      event.preventDefault();
      links[current + 1]?.focus();
    }
    if (event.key === "ArrowUp") {
      event.preventDefault();
      if (current <= 0) input?.focus();
      else links[current - 1]?.focus();
    }
    if (event.key === "Escape") {
      closeSuggestions();
      input?.focus();
    }
  });
  submit?.addEventListener("click", () => {
    if (visibleEntries[0]) location.assign(visibleEntries[0].href);
    else render();
  });
  exampleButtons.forEach((button) => button.addEventListener("click", () => {
    if (!input) return;
    input.value = button.dataset.answerExample ?? "";
    input.focus();
    render();
  }));
</script>

<style>
  .usecase-navigator { border: 1px solid #c0cbbc; border-radius: .7rem; background: var(--surface); color: var(--paper); box-shadow: 0 12px 30px #19362d10,0 5px 0 #d3d8cc; }
  header { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1.3rem 1.8rem .8rem; }
  header small { color: #67765e; font-size: .7rem; font-weight: 550; letter-spacing: .09em; text-transform: uppercase; }
  header h2 { margin: .25rem 0 0; color: var(--bright); font: 450 1.8rem/1.1 var(--font-serif); }
  header > span { display: inline-flex; gap: .4rem; align-items: center; color: var(--muted); font-size: .78rem; white-space: nowrap; }
  header i { width: .4rem; height: .4rem; border-radius: 50%; background: var(--success); }
  .answer-finder { position: relative; padding: .6rem 1.8rem 1.3rem; }
  .answer-finder > label { display: block; margin-bottom: .55rem; color: var(--paper); font-size: .82rem; }
  .answer-search-row { display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; border: 1px solid #a3b5a0; border-radius: .5rem; background: #fffdf7; box-shadow: 0 2px 0 #bcc9b94d; }
  .answer-search-row:focus-within { outline: 2px solid var(--signal); outline-offset: 2px; }
  .answer-search-icon { display: grid; place-items: center; width: 3.2rem; color: #59826b; }
  .answer-search-icon :global(svg) { width: 1.3rem; height: 1.3rem; }
  .answer-search-row input { min-width: 0; min-height: 3.6rem; border: 0; outline: 0; background: transparent; color: var(--bright); font: 450 1rem/1.3 var(--font-sans); }
  .answer-search-row input::placeholder { color: #6e7b6a; }
  .answer-search-row button { display: inline-flex; justify-content: center; gap: .7rem; align-items: center; min-height: 2.85rem; margin: .3rem; border: 0; border-radius: .35rem; padding: .7rem 1.2rem; background: var(--signal); color: #fff; cursor: pointer; font: 550 .88rem/1.3 var(--font-sans); }
  .answer-search-row button:hover { background: #293da2; }
  .answer-search-row button :global(svg) { width: 1rem; }
  .answer-examples { display: flex; flex-wrap: wrap; gap: .35rem .6rem; align-items: center; margin-top: .85rem; }
  .answer-examples span { color: var(--muted); font-size: .74rem; margin-right: .3rem; }
  .answer-examples button { border: 1px solid #c7d0bf; border-radius: .3rem; padding: .42rem .6rem; background: #ecefe5; color: #3c584a; cursor: pointer; font: 500 .76rem/1.2 var(--font-sans); }
  .answer-examples button:hover { background: #dce7d5; border-color: #8ca385; }
  .answer-suggestions { margin-top: .9rem; border: 1px solid #c0cbbc; border-radius: .5rem; background: #fffdf7; }
  .answer-suggestions :global(a) { display: grid; grid-template-columns: 1fr auto; gap: .8rem; align-items: center; border-top: 1px solid var(--line); padding: .9rem 1rem; color: var(--paper); }
  .answer-suggestions :global(a:first-child) { border-top: 0; }
  .answer-suggestions :global(a:hover), .answer-suggestions :global(a:focus-visible) { background: #e4eddc; outline: 2px solid var(--signal); outline-offset: -2px; }
  .answer-suggestions :global(small) { display: block; color: #5d7156; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; }
  .answer-suggestions :global(strong) { display: block; margin-top: .25rem; color: var(--bright); font-size: .95rem; }
  .answer-suggestions :global(p) { margin: .2rem 0 0; color: var(--muted); font-size: .84rem; line-height: 1.5; }
  .answer-suggestions :global(b) { color: var(--signal); }
  .answer-empty { margin: 1rem 0 0; border-left: 2px solid var(--amber); padding-left: .8rem; font-size: .88rem; }
  .shortcut-label { margin: 0 1.8rem; border-top: 1px solid #ccd3c4; padding-top: 1rem; color: #607457; font-size: .73rem; letter-spacing: .04em; }
  .usecase-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; padding: 1rem 1.8rem 1.5rem; }
  .usecase { --case-tone: #577363; position: relative; display: grid; grid-template-columns: 1fr auto; gap: .3rem .6rem; align-items: start; min-width: 0; padding: 1rem 1.1rem; border: 1px solid #c8d1c0; border-radius: .4rem; background: #edf0e5; color: var(--paper); transition: background 160ms ease, border-color 160ms ease; }
  .usecase.tone-blue { --case-tone: #456a8b; background: #e9eeee; }
  .usecase.tone-green { --case-tone: #687244; background: #eeeedf; }
  .usecase:hover { border-color: var(--case-tone); background: #e1e8d7; color: inherit; }
  .case-number { grid-column: 2; grid-row: 1; color: #617457; font: .7rem/1 var(--font-mono); }
  .case-icon { grid-column: 1; grid-row: 1; width: 4.5rem; color: var(--case-tone); }
  .case-icon :global(svg) { width: 100%; height: auto; }
  .case-copy { grid-column: 1 / -1; display: grid; gap: .3rem; min-width: 0; padding-top: .2rem; }
  .case-copy strong { color: var(--bright); font-size: .98rem; font-weight: 580; line-height: 1.4; }
  .case-copy small { color: var(--muted); font-size: .82rem; line-height: 1.55; max-width: 27ch; }
  .usecase > :global(svg) { grid-column: 2; grid-row: 3; justify-self: end; color: var(--case-tone); width: 1.1rem; }
  .question-library-link { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .9rem 1.8rem; border-top: 1px solid #c8d1c0; color: #47634e; font-size: .82rem; }
  .question-library-link:hover { background: #e6eadf; color: #213f2b; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
  @media (max-width: 700px) {
    .usecase-grid { grid-template-columns: 1fr; gap: .6rem; }
    .usecase { grid-template-columns: auto 1fr auto; gap: .8rem; align-items: center; padding: .9rem; }
    .case-number { display: none; }
    .case-icon { grid-column: 1; grid-row: 1; width: 3.7rem; }
    .case-copy { grid-column: 2; grid-row: 1; padding: 0; }
    .case-copy small { max-width: none; }
    .usecase > :global(svg) { grid-column: 3; grid-row: 1; }
    header, .answer-finder, .usecase-grid, .question-library-link { padding-inline: 1rem; }
    .shortcut-label { margin-inline: 1rem; }
    header > span { display: none; }
    .answer-search-row { grid-template-columns: auto minmax(0,1fr); }
    .answer-search-row input { font-size: 1rem; }
    .answer-search-row button { grid-column: 1 / -1; margin: .2rem .45rem .45rem; }
    .answer-examples span { flex-basis: 100%; }
  }
</style>
