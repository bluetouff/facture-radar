---
import type { Platform } from "../data/types";
import { sourceCount } from "../lib/evidence";
import EvidenceBadge from "./EvidenceBadge.astro";

interface Props {
  platform: Platform;
  index: number;
}

const { platform, index } = Astro.props;
const sources = sourceCount(platform);
const pricingLabels = {
  free: "gratuit",
  paid: "payant",
  included: "inclus",
  quote: "sur devis",
} as const;
const pricingLabel = platform.pricing.value ? pricingLabels[platform.pricing.value.kind] : "prix à confirmer";
const targetLabels = { micro: "indépendants", tpe: "TPE", pme: "PME", eti: "ETI", ge: "grandes entreprises" } as const;
const initials = platform.displayName.replace(/[^\p{L}\p{N}]/gu, "").slice(0, 2).toLocaleUpperCase("fr");
const proofSlots = Array.from({ length: 5 }, (_, slot) => slot < Math.min(sources, 5));
---

<article class={`platform-card tone-${index % 6}`}>
  <div class="card-top">
    <div class="platform-identity">
      <span class="platform-monogram" aria-hidden="true">{initials}</span>
      <div>
        <span class="card-index">Dossier {String(index + 1).padStart(2, "0")}</span>
        <h3>{platform.displayName}</h3>
      </div>
    </div>
    <EvidenceBadge status={platform.officialStatus.status} label="DGFiP" />
  </div>
  <p class="card-summary">{platform.summary}</p>
  <div class="tag-row">
    {platform.targets.map((target) => <span class="tag">{targetLabels[target]}</span>)}
    <span class="tag">{pricingLabel}</span>
  </div>
  <div class="proof-density" aria-label={`${sources} sources consultées`}>
    <div class="proof-bars" aria-hidden="true">
      {proofSlots.map((filled) => <span class:list={{ filled }}></span>)}
    </div>
    <span><strong>{sources}</strong> sources consultées</span>
  </div>
  <div class="card-metrics">
    <div><span>Dernière mise à jour</span><strong>{platform.officialStatus.checkedAt.split("-").reverse().join("/")}</strong></div>
    <div><span>Tarif</span><strong>{pricingLabel}</strong></div>
  </div>
  <a class="card-link" href={`/plateformes/${platform.slug}/`}>
    <span>Voir la fiche</span><span aria-hidden="true">↗</span>
  </a>
</article>
