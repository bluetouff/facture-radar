---
import type { Platform } from "../data/types";
import { sourceCount } from "../lib/evidence";
import EvidenceBadge from "./EvidenceBadge.astro";

interface Props {
  platform: Platform;
  index: number;
}

const { platform, index } = Astro.props;
const sources = sourceCount(platform);
const pricingLabels = {
  free: "gratuit",
  paid: "payant",
  included: "inclus",
  quote: "sur devis",
} as const;
const pricingLabel = platform.pricing.value ? pricingLabels[platform.pricing.value.kind] : "prix à confirmer";
---

<article class="platform-card">
  <div class="card-top">
    <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
    <EvidenceBadge status={platform.officialStatus.status} label="DGFiP" />
  </div>
  <h3>{platform.displayName}</h3>
  <p>{platform.summary}</p>
  <div class="tag-row">
    {platform.targets.map((target) => <span class="tag">{target}</span>)}
    <span class="tag">{pricingLabel}</span>
  </div>
  <div class="card-metrics">
    <div><span>Dernière vérification</span><strong>{platform.officialStatus.checkedAt.split("-").reverse().join("/")}</strong></div>
    <div><span>Sources liées</span><strong>{sources}</strong></div>
  </div>
  <a class="card-link" href={`/plateformes/${platform.slug}/`}>
    <span>Ouvrir le dossier</span><span aria-hidden="true">↗</span>
  </a>
</article>
