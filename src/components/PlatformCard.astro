---
import type { Platform } from "../data/types";
import { sourceCount } from "../lib/evidence";
import InterfaceIcon from "./InterfaceIcon.astro";

interface Props {
  platform: Platform;
  index: number;
}

const { platform, index } = Astro.props;
const targets = { micro: "indépendants", tpe: "TPE", pme: "PME", eti: "ETI", ge: "grands comptes" } as const;
const price = platform.pricing.value;
const mainSignal = price?.kind === "free"
  ? "Une entrée gratuite est documentée"
  : price?.kind === "included"
    ? "La PA est incluse dans une offre"
    : price?.monthlyFrom !== null && price?.monthlyFrom !== undefined
      ? `Prix public dès ${price.monthlyFrom} € HT / mois`
      : "Le budget passe par un devis";
const counter = String(index + 1).padStart(2, "0");
---

<article class={`dossier-teaser tone-${index % 4}`}>
  <a href={`/plateformes/${platform.slug}/`}>
    <div class="teaser-meta"><span>dossier {counter}</span><small>{sourceCount(platform)} sources consultées</small></div>
    <div class="teaser-heading">
      <span class="teaser-mark" aria-hidden="true"><InterfaceIcon name="proof" /></span>
      <h3>{platform.displayName}</h3>
    </div>
    <p>{platform.summary}</p>
    <div class="teaser-signal"><InterfaceIcon name="verdict" /><strong>{mainSignal}</strong></div>
    <footer>
      <span>{platform.targets.slice(0, 3).map((target) => targets[target]).join(" · ")}</span>
      <strong>Lire le dossier <InterfaceIcon name="arrow" /></strong>
    </footer>
  </a>
</article>

<style>
  .dossier-teaser { position: relative; border: 1px solid #bcc9b7; border-radius: .4rem; background: #f5f2e8; transition: border-color 160ms ease, box-shadow 160ms ease; }
  .dossier-teaser::after { position: absolute; top: 0; right: 0; border-width: 0 1.7rem 1.7rem 0; border-style: solid; border-color: transparent #d1d9c6 transparent transparent; content: ""; }
  .dossier-teaser:hover { border-color: #6b8662; box-shadow: 4px 4px 0 #b8c6ad; }
  .dossier-teaser > a { display: flex; height: 100%; flex-direction: column; padding: 1.5rem; color: inherit; }
  .teaser-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .8rem; border-bottom: 1px solid #c7d0be; padding-bottom: .9rem; padding-right: .5rem; font-size: .72rem; color: #64775a; }
  .teaser-meta span { letter-spacing: .06em; text-transform: uppercase; }
  .teaser-meta small { font-size: .75rem; color: var(--muted); }
  .teaser-heading { display: flex; gap: .8rem; align-items: center; margin-top: 1.4rem; }
  .teaser-mark { color: #74946b; }
  .teaser-mark :global(svg) { width: 1.7rem; height: 1.7rem; stroke-width: 1.2; }
  .teaser-heading h3 { margin: 0; color: var(--bright); font: 430 1.8rem/1.1 var(--font-serif); }
  .dossier-teaser a > p { margin: 1rem 0; color: var(--muted); font-size: .9rem; line-height: 1.7; }
  .teaser-signal { display: flex; gap: .65rem; align-items: center; padding-block: .7rem 1.2rem; }
  .teaser-signal :global(svg) { flex-shrink: 0; width: 1.1rem; height: 1.1rem; color: #65875b; }
  .teaser-signal strong { color: var(--paper); font-size: .86rem; font-weight: 500; }
  .dossier-teaser footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .8rem; align-items: center; margin-top: auto; border-top: 1px solid #c7d0be; padding-top: 1rem; }
  .dossier-teaser footer > span { color: var(--muted); font-size: .74rem; }
  .dossier-teaser footer > strong { display: inline-flex; gap: .6rem; align-items: center; color: #456e42; font-size: .84rem; font-weight: 550; }
  .dossier-teaser footer :global(svg) { width: 1rem; }
</style>
