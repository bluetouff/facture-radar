---
import type { Platform } from "../data/types";
import { sourceCount } from "../lib/evidence";
import InterfaceIcon from "./InterfaceIcon.astro";
import CompareButton from "./CompareButton.astro";

interface Props {
  platform: Platform;
  index: number;
}

const { platform, index } = Astro.props;
const targets = { micro: "indépendants", tpe: "TPE", pme: "PME", eti: "ETI", ge: "grands comptes" } as const;
const price = platform.pricing.value;
const mainSignal = price?.kind === "free"
  ? "Une entrée gratuite est documentée"
  : price?.kind === "included"
    ? "La PA est incluse dans une offre"
    : price?.monthlyFrom !== null && price?.monthlyFrom !== undefined
      ? `Prix public dès ${price.monthlyFrom.toLocaleString("fr-FR", { maximumFractionDigits: 2 })} € HT / mois`
      : "Le budget passe par un devis";
const counter = String(index + 1).padStart(2, "0");
---

<article class={`dossier-teaser tone-${index % 4}`}>
  <a href={`/plateformes/${platform.slug}/`}>
    <div class="teaser-meta"><span>dossier {counter}</span><small>{sourceCount(platform)} sources consultées</small></div>
    <div class="teaser-heading">
      <span class="teaser-mark" aria-hidden="true">{platform.displayName.slice(0, 2).toLocaleUpperCase("fr")}</span>
      <h3>{platform.displayName}</h3>
    </div>
    <p>{platform.summary}</p>
    <div class="teaser-signal"><InterfaceIcon name="verdict" /><strong>{mainSignal}</strong></div>
    <footer>
      <span>{platform.targets.slice(0, 3).map((target) => targets[target]).join(" · ")}</span>
      <strong>Lire le dossier <InterfaceIcon name="arrow" /></strong>
    </footer>
  </a>
  <div class="teaser-compare"><CompareButton slug={platform.slug} name={platform.displayName} /></div>
</article>

<style>
  .dossier-teaser { --teaser-color: #4259bd; --teaser-fill: #eef1ff; position: relative; border: 1px solid #dfe5f0; border-radius: 1.1rem; background: #fff; transition: border-color 180ms ease, box-shadow 180ms ease, translate 180ms ease; }
  .tone-1 { --teaser-color: #277761; --teaser-fill: #eaf7f1; }
  .tone-2 { --teaser-color: #936029; --teaser-fill: #fff4e6; }
  .tone-3 { --teaser-color: #7b54af; --teaser-fill: #f4eeff; }
  .dossier-teaser:hover { border-color: #b8c7ed; translate: 0 -4px; box-shadow: 0 12px 30px #263d7310; }
  .dossier-teaser { display: flex; flex-direction: column; }
  .dossier-teaser > a { display: flex; flex: 1; flex-direction: column; padding: 1.5rem; color: inherit; border-radius: inherit; }
  .teaser-compare { padding: 0 1.5rem 1rem; }
  .teaser-compare:has([hidden]) { display: none; }
  .teaser-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .8rem; font-size: .68rem; color: var(--muted); }
  .teaser-meta span { color: var(--teaser-color); background: var(--teaser-fill); padding: .2rem .5rem; border-radius: .4rem; font-weight: 550; }
  .teaser-meta small { font-size: .72rem; align-self: center; }
  .teaser-heading { display: flex; gap: .85rem; align-items: center; margin-top: 1.4rem; }
  .teaser-mark { display: grid; place-items: center; flex-shrink: 0; width: 2.8rem; height: 2.8rem; border-radius: .85rem; background: var(--teaser-fill); color: var(--teaser-color); font-size: .82rem; font-weight: 650; }
  .teaser-heading h3 { margin: 0; color: var(--bright); font: 620 1.35rem/1.2 var(--font-sans); letter-spacing: -.035em; }
  .dossier-teaser a > p { margin: 1rem 0; color: var(--muted); font-size: .88rem; line-height: 1.75; }
  .teaser-signal { display: flex; gap: .6rem; align-items: center; padding: .75rem .85rem; margin-bottom: 1.3rem; border-radius: .7rem; background: #f6f8fc; }
  .teaser-signal :global(svg) { flex-shrink: 0; width: 1.1rem; height: 1.1rem; color: var(--teaser-color); }
  .teaser-signal strong { color: var(--paper); font-size: .8rem; font-weight: 500; }
  .dossier-teaser footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .8rem; align-items: center; margin-top: auto; border-top: 1px solid #edf0f7; padding-top: 1rem; }
  .dossier-teaser footer > span { color: var(--muted); font-size: .72rem; }
  .dossier-teaser footer > strong { display: inline-flex; gap: .6rem; align-items: center; color: var(--signal); font-size: .8rem; font-weight: 550; }
  .dossier-teaser footer :global(svg) { width: 1rem; transition: translate 180ms ease; }
  .dossier-teaser:hover footer :global(svg) { translate: 3px 0; }
</style>
