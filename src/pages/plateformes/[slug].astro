---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import EvidenceRow from "../../components/EvidenceRow.astro";
import InterfaceIcon from "../../components/InterfaceIcon.astro";
import { platforms } from "../../data/platforms";
import { collectResearchSourceIds, researchForPlatform } from "../../data/platform-research";
import { publicSiteObservationForPlatform, TRACKER_OBSERVATION_SOURCE_IDS } from "../../data/public-site-observations";
import sources from "../../data/sources.json";
import type { Evidence, EvidenceStatus } from "../../data/types";

export function getStaticPaths() {
  return platforms.map((platform) => ({ params: { slug: platform.slug }, props: { platform } }));
}

const { platform } = Astro.props;
const research = researchForPlatform(platform.slug);
const publicSiteObservation = publicSiteObservationForPlatform(platform.slug);
const targetLabels = { micro: "indépendants", tpe: "TPE", pme: "PME", eti: "ETI", ge: "grands comptes" } as const;
const profileTone = "folio-profile";
const linkedSourceIds = new Set<string>();
const collectSourceIds = (value: unknown): void => {
  if (Array.isArray(value)) {
    for (const item of value) collectSourceIds(item);
    return;
  }
  if (!value || typeof value !== "object") return;
  for (const [key, item] of Object.entries(value)) {
    if (key === "sourceIds" && Array.isArray(item)) {
      for (const sourceId of item) if (typeof sourceId === "string") linkedSourceIds.add(sourceId);
    } else collectSourceIds(item);
  }
};
collectSourceIds(platform);
for (const sourceId of collectResearchSourceIds(research)) linkedSourceIds.add(sourceId);
if (publicSiteObservation.status === "observed") {
  for (const sourceId of TRACKER_OBSERVATION_SOURCE_IDS) linkedSourceIds.add(sourceId);
}
linkedSourceIds.add("legifrance-pa-iso27001-scope-2026");
const linkedSources = sources.filter((source) => linkedSourceIds.has(source.id));

const rows = [
  ["Statut DGFiP", platform.officialStatus],
  ["Date d'immatriculation", platform.registeredAt],
  ["Prix de l'offre étudiée", platform.pricing],
  ["Volume inclus", platform.allowance],
  ["Émission", platform.sendsInvoices],
  ["Réception", platform.receivesInvoices],
  ["E-reporting", platform.eReporting],
  ["Compte bancaire requis", platform.bankAccountRequired],
  ["Accès pour le comptable", platform.accountantAccess],
  ["API publique", platform.publicApi],
  ["Export des données", platform.exportDocumented],
  ["Intégrations", platform.integrations],
  ["Formats", platform.formats],
  ["Pays d'hébergement", platform.hostingCountries],
  ["ISO 27001", platform.iso27001],
  ["Engagement minimal", platform.commitmentMonths],
] as const;

const choiceRows = rows.slice(0, 9);
const availabilityRows = [
  ["Émission aujourd'hui", research.availability.sendsInvoices],
  ["Réception aujourd'hui", research.availability.receivesInvoices],
  ["E-reporting aujourd'hui", research.availability.eReporting],
] as const;
const technicalRows = [
  ["API publique", platform.publicApi],
  ["Intégrations", platform.integrations],
  ["Formats", platform.formats],
  ["Pays d'hébergement", platform.hostingCountries],
  ["Hébergeurs nommés", research.hostingProviders],
  ["Sous-traitants déclarés", research.declaredSubprocessors],
] as const;
const contractRows = [
  ["Export des données", platform.exportDocumented],
  ["Engagement minimal", platform.commitmentMonths],
  ["Import d'un Factur-X tiers", research.directImport],
  ["Dépassements et paliers", research.overagePricing],
  ["Données remises au départ", research.exitTerms],
  ["Résiliation", research.terminationTerms],
] as const;

type DocumentationRow = readonly [string, Evidence<unknown>];
const countStatuses = (sectionRows: readonly DocumentationRow[]) => sectionRows.reduce((counts, [, evidence]) => {
  counts[evidence.status] += 1;
  return counts;
}, { official: 0, documented: 0, declared: 0, non_documented: 0 } satisfies Record<EvidenceStatus, number>);
const isoCoverageRow = ["Périmètre ISO 27001 public", research.iso27001Scope] as const;
const documentationSections = [
  { id: "decision", eyebrow: "L'essentiel", label: "Prix, flux et accès", rows: choiceRows },
  { id: "disponibilite", eyebrow: "Aujourd'hui", label: "Fonctions réellement ouvertes", rows: availabilityRows },
  { id: "technique", eyebrow: "Infrastructure", label: "Technique et sécurité", rows: [...technicalRows, isoCoverageRow] },
  { id: "contrat", eyebrow: "À la sortie", label: "Contrat et récupération", rows: contractRows },
] as const;
const documentationRows = [
  ...choiceRows,
  ...availabilityRows,
  ...technicalRows,
  isoCoverageRow,
  ...contractRows,
] as DocumentationRow[];
const documentationCounts = countStatuses(documentationRows);
const confirmedCount = documentationCounts.official + documentationCounts.documented;
const declaredCount = documentationCounts.declared;
const unknownCount = documentationCounts.non_documented;
const knownCount = confirmedCount + declaredCount;
const documentationLabel = unknownCount <= 3
  ? "Fiche très bien renseignée"
  : knownCount >= 18
    ? "Fiche bien renseignée"
    : knownCount >= 12
      ? "Fiche partiellement renseignée"
      : "Fiche encore incomplète";
const sectionSummary = (sectionRows: readonly DocumentationRow[]) => {
  const counts = countStatuses(sectionRows);
  const known = counts.official + counts.documented + counts.declared;
  return {
    known,
    total: sectionRows.length,
    level: counts.official + counts.documented === sectionRows.length ? "complete" : known > 0 ? "partial" : "missing",
    label: counts.official + counts.documented === sectionRows.length ? "Renseigné" : counts.official + counts.documented > 0 ? "Partiellement renseigné" : counts.declared > 0 ? "Déclaré, à vérifier" : "À documenter",
  } as const;
};
const isoDetail = research.iso27001Scope.value;
const isoRelationLabels = {
  explicit_platform: "La facturation électronique figure explicitement dans le périmètre publié",
  service_family: "Le périmètre publié couvre la famille de services cloud",
  organization_only: "La certification est reliée à l'organisation, pas précisément à la plateforme",
  not_established: "Le lien avec la plateforme n'est pas établi publiquement",
} as const;
const isoValidityLabel = isoDetail?.validity === "valid"
  ? "Certificat public en cours de validité"
  : isoDetail?.validity === "expired"
    ? "Document public arrivé à échéance"
    : "Dates du certificat non publiées";
const isoSourceRecords = research.iso27001Scope.sourceIds
  .map((id) => sources.find((source) => source.id === id))
  .filter((source) => source !== undefined);
const pricing = platform.pricing.value;
const priceValue = pricing?.kind === "free"
  ? "0 € HT"
  : pricing?.kind === "included"
    ? "Inclus dans une offre"
    : pricing?.monthlyFrom !== null && pricing?.monthlyFrom !== undefined
      ? `Dès ${pricing.monthlyFrom} € HT / mois`
      : pricing?.kind === "quote"
        ? "Sur devis"
        : "À confirmer";
const bankValue = platform.bankAccountRequired.value === true
  ? "Connexion requise"
  : platform.bankAccountRequired.value === false
    ? "Compte pro non requis"
    : "À confirmer";
const accountantValue = platform.accountantAccess.value === true
  ? "Accès documenté"
  : platform.accountantAccess.value === false
    ? "Accès non prévu"
    : "À confirmer";
const reviewedAt = platform.officialStatus.checkedAt.split("-").reverse().map((part, index) => index === 2 ? part.slice(-2) : part).join(".");
const observationDate = publicSiteObservation.checkedAt?.split("-").reverse().join("/") ?? null;
const observedTrackerLabel = publicSiteObservation.status !== "observed"
  ? "Observation non publiée"
  : publicSiteObservation.trackers.length === 0
    ? "Aucun domaine classé identifié pendant cette observation"
    : `${publicSiteObservation.trackers.length} domaine${publicSiteObservation.trackers.length > 1 ? "s" : ""} classé${publicSiteObservation.trackers.length > 1 ? "s" : ""}`;
---

<BaseLayout
  title={`${platform.displayName} : plateforme agréée, prix et fonctions | PA Check`}
  description={`Prix, fonctions, conditions et points à confirmer pour ${platform.displayName}, plateforme agréée de facturation électronique.`}
>
  <section class:list={["profile-cover", profileTone]}>
    <div class="shell profile-cover-inner">
      <div class="profile-copy">
        <nav class="page-breadcrumb" aria-label="Fil d’Ariane" itemscope itemtype="https://schema.org/BreadcrumbList">
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a class="back-link" itemprop="item" href="/plateformes/"><InterfaceIcon name="arrow" /><span itemprop="name">Plateformes agréées</span></a>
            <meta itemprop="position" content="1" />
          </span>
          <span class="breadcrumb-separator" aria-hidden="true">/</span>
          <span class="breadcrumb-current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
            <span itemprop="name">{platform.displayName}</span>
            <meta itemprop="position" content="2" />
          </span>
        </nav>
        <div class="profile-reference">
          <span>Le dossier plateforme</span>
          <i></i>
          <span>revu le {reviewedAt}</span>
        </div>
        <h1>{platform.displayName}</h1>
        <span class="official-name">Nom dans la liste DGFiP : {platform.officialName}</span>
        <p>{platform.summary}</p>
        <div class="profile-audiences">{platform.targets.map((target) => <span>{targetLabels[target]}</span>)}</div>
      </div>

      <aside class="profile-ledger" aria-label="Repères documentaires">
        <header><span>Repères de lecture</span><EvidenceBadge status="official" label="Liste DGFiP" /></header>
        <a class="ledger-sources" href="#sources-reliees">
          <span class="ledger-sources-icon"><InterfaceIcon name="proof" /></span>
          <span><strong>Sources consultables</strong><small>Chaque information renvoie au document public utilisé.</small></span>
          <InterfaceIcon name="arrow" />
        </a>
        <dl>
          <div><dt>Immatriculation</dt><dd>{platform.registeredAt.value?.split("-").reverse().join(".")}</dd></div>
          <div><dt>État de la fiche</dt><dd>{documentationLabel}</dd></div>
          <div><dt>Publicité</dt><dd>Aucune offre sponsorisée</dd></div>
        </dl>
        <p>Les points à confirmer sont indiqués dans chaque rubrique.</p>
      </aside>
    </div>
  </section>

  <section class="shell choice-snapshot" aria-label="L’essentiel en six repères">
    <article>
      <span><InterfaceIcon name="verdict" /></span>
      <div><p>Budget public</p><strong>{priceValue}</strong><small>{platform.pricing.value?.label ?? platform.pricing.note}</small></div>
    </article>
    <article class:list={{ warning: platform.bankAccountRequired.value === true }}>
      <span><InterfaceIcon name="route" /></span>
      <div><p>Compte ou banque</p><strong>{bankValue}</strong><small>{platform.bankAccountRequired.note ?? "Le prérequis est indiqué dans la documentation consultée."}</small></div>
    </article>
    <article>
      <span><InterfaceIcon name="layers" /></span>
      <div><p>Travail avec votre comptable</p><strong>{accountantValue}</strong><small>{platform.accountantAccess.note ?? "Le périmètre exact dépend de l'offre et des droits accordés."}</small></div>
    </article>
    <article>
      <span><InterfaceIcon name="invoice" /></span>
      <div><p>Volume inclus</p><strong>{platform.allowance.value?.label ?? "À confirmer"}</strong><small>{platform.allowance.note ?? "Consultez les conditions de l’offre ci-dessous."}</small></div>
    </article>
    <article>
      <span><InterfaceIcon name="route" /></span>
      <div><p>Émission aujourd’hui</p><strong>{research.availability.sendsInvoices.value ? ({ available: "Disponible", limited: "Accès limité", beta: "En bêta", announced: "Annoncée" } as const)[research.availability.sendsInvoices.value.stage] : "À confirmer"}</strong><small>{research.availability.sendsInvoices.value?.scope ?? "Le périmètre d’accès n’est pas renseigné."}</small></div>
    </article>
    <article>
      <span><InterfaceIcon name="download" /></span>
      <div><p>Factur-X créé ailleurs</p><strong>{research.directImport.value?.acceptsThirdPartyFile === true ? "Import tiers publié" : research.directImport.value?.acceptsThirdPartyFile === false ? "Import non pris en charge" : "Import à confirmer"}</strong><small>Les formats et les conditions figurent dans la rubrique « À la sortie ».</small></div>
    </article>
  </section>

  <section class="shell documentation-map" aria-labelledby="documentation-map-title">
    <div class="documentation-map-intro">
      <p class="mono-label">Les informations disponibles</p>
      <h2 id="documentation-map-title">{documentationLabel}</h2>
      <p>Parcourez les rubriques renseignées et repérez celles où des informations restent à obtenir.</p>
    </div>
    <nav class="documentation-sections" aria-label="Aller aux parties de la fiche">
      {documentationSections.map((section, index) => {
        const summary = sectionSummary(section.rows);
        return (
          <a href={`#${section.id}`} data-level={summary.level}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><small>{section.eyebrow}</small><strong>{section.label}</strong><em>{summary.label}</em></div>
            <InterfaceIcon name="arrow" />
          </a>
        );
      })}
    </nav>
  </section>

  <section class="shell profile-layout">
    <nav class="profile-toc" aria-label="Sommaire du dossier">
      <p>Dans ce dossier</p>
      {documentationSections.map((section, index) => <a href={`#${section.id}`}><span>{String(index + 1).padStart(2, "0")}</span>{section.eyebrow}</a>)}
      <a href="#site-public"><span>05</span>Site public</a>
      <a href="#sources-reliees"><InterfaceIcon name="proof" />Sources</a>
      <a class="toc-compare" href={`/comparer/?ids=${platform.slug}`}>Comparer<InterfaceIcon name="arrow" /></a>
    </nav>
    <article class="profile-facts">
      <header class="matrix-head" id="decision">
        <div><p class="mono-label">pour décider</p><span>01</span></div>
        <h2>Le prix, les fonctions et l’accès.</h2>
        <p>Les conditions publiées pour l’offre étudiée. Chaque réponse vous donne accès au document utilisé.</p>
      </header>
      <div class="evidence-matrix">
        {choiceRows.map(([label, evidence]) => <EvidenceRow label={label} evidence={evidence} />)}
      </div>

      <header class="matrix-head secondary-head" id="disponibilite">
        <div><p class="mono-label">utilisable aujourd'hui</p><span>02</span></div>
        <h2>Ce que vous pouvez utiliser aujourd’hui.</h2>
        <p>Vérifiez si la fonction est ouverte à tous, limitée à certains clients, en bêta ou encore annoncée.</p>
      </header>
      <div class="evidence-matrix">
        {availabilityRows.map(([label, evidence]) => <EvidenceRow label={label} evidence={evidence} />)}
      </div>

      <header class="matrix-head secondary-head" id="technique">
        <div><p class="mono-label">infrastructure</p><span>03</span></div>
        <h2>Infrastructure, échanges et sécurité.</h2>
        <p>API, formats et hébergement sont séparés des déclarations de l'éditeur. Le périmètre ISO n'est jamais déduit d'un simple logo.</p>
      </header>
      <div class="evidence-matrix">
        {technicalRows.map(([label, evidence]) => <EvidenceRow label={label} evidence={evidence} />)}
      </div>

      <section class:list={["iso-scope-card", { expired: isoDetail?.validity === "expired", missing: !isoDetail }]} aria-labelledby="iso-scope-title">
        <header>
          <div class="iso-mark" aria-hidden="true"><InterfaceIcon name="verdict" /></div>
          <div>
            <p class="mono-label">ISO/IEC 27001 · périmètre public</p>
            <h3 id="iso-scope-title">La certification couvre-t-elle cette plateforme ?</h3>
          </div>
          <EvidenceBadge
            status={research.iso27001Scope.status}
            label={isoDetail?.validity === "expired" ? "Document public expiré" : isoDetail?.validity === "valid" ? "Certificat public" : isoDetail ? "Périmètre déclaré" : "À confirmer"}
          />
        </header>
        <div class="iso-regulatory-line">
          <span>Exigence réglementaire</span>
          <p>Le dossier d'immatriculation d'une plateforme agréée doit couvrir l'ensemble des systèmes qui participent aux factures et aux données réglementaires, y compris les tiers qui peuvent y accéder.</p>
          <a href="https://www.legifrance.gouv.fr/codes/id/LEGISCTA000054552492/2026-07-29" rel="noopener">Lire l'article 242 nonies B ↗</a>
        </div>
        {isoDetail ? (
          <div class="iso-public-detail">
            <div class="iso-conclusion">
              <small>Conclusion pour cette fiche</small>
              <strong>{isoRelationLabels[isoDetail.platformRelation]}</strong>
              <p>{isoDetail.scopeText ?? research.iso27001Scope.note}</p>
            </div>
            <dl>
              <div><dt>Entité certifiée</dt><dd>{isoDetail.legalEntity ?? "Non publiée"}</dd></div>
              <div><dt>Organisme</dt><dd>{isoDetail.certificationBody ?? "Non publié"}</dd></div>
              <div><dt>Certificat</dt><dd>{isoDetail.certificateNumber ?? "Numéro non publié"}</dd></div>
              <div><dt>Validité publique</dt><dd>{isoValidityLabel}{isoDetail.validUntil ? ` · jusqu'au ${isoDetail.validUntil.split("-").reverse().join("/")}` : ""}</dd></div>
            </dl>
            {research.iso27001Scope.note && <p class="iso-caveat">{research.iso27001Scope.note}</p>}
            {isoSourceRecords.length > 0 && <div class="iso-links">{isoSourceRecords.map((source) => <a href={source.url} rel="noopener">{source.title} ↗</a>)}</div>}
          </div>
        ) : (
          <div class="iso-missing-detail">
            <strong>Périmètre public non retrouvé</strong>
            <p>{research.iso27001Scope.note}</p>
            <small>Cela ne signifie pas que la plateforme n'est pas certifiée : l'exigence est contrôlée dans le dossier d'immatriculation. Cela signifie que le certificat, son titulaire, ses dates et son périmètre ne sont pas consultables depuis les sources reliées ici.</small>
          </div>
        )}
      </section>

      <header class="matrix-head secondary-head" id="contrat">
        <div><p class="mono-label">le contrat concret</p><span>04</span></div>
        <h2>Les détails qui évitent les mauvaises surprises.</h2>
        <p>Import d'un fichier produit ailleurs, coût après le quota, restitution, résiliation et prestataires nommés. Une réponse partielle reste affichée comme telle.</p>
      </header>
      <div class="evidence-matrix">
        {contractRows.map(([label, evidence]) => <EvidenceRow label={label} evidence={evidence} />)}
      </div>

      <section class="site-observation" id="site-public" aria-labelledby="site-observation-title">
        <header>
          <div><p class="mono-label">site public observé</p><span>05</span></div>
          <div>
            <h2 id="site-observation-title">Ce que la page vitrine charge avant votre choix.</h2>
            <p>Cette observation ne porte ni sur l'espace connecté, ni sur les factures, ni sur leur hébergement. Elle n'intervient jamais dans l'ordre des résultats.</p>
          </div>
        </header>
        {publicSiteObservation.status === "observed" ? (
          <div class="observation-body">
            <div class="observation-summary">
              <strong>{observedTrackerLabel}</strong>
              <span>{publicSiteObservation.thirdPartyDomains.length} domaine{publicSiteObservation.thirdPartyDomains.length > 1 ? "s" : ""} tiers chargé{publicSiteObservation.thirdPartyDomains.length > 1 ? "s" : ""} au total</span>
              <small>Page chargée le {observationDate}, profil neuf, aucun choix dans le bandeau.</small>
              <a href={publicSiteObservation.finalUrl ?? publicSiteObservation.scanUrl ?? "#"} rel="noopener">Voir la page observée ↗</a>
            </div>
            {publicSiteObservation.trackers.length > 0 ? (
              <div class="tracker-list">
                {publicSiteObservation.trackers.slice(0, 8).map((tracker) => (
                  <article><strong>{tracker.entity}</strong><code>{tracker.domain}</code><small>{tracker.categories.join(" · ")}</small></article>
                ))}
                {publicSiteObservation.trackers.length > 8 && (
                  <details>
                    <summary>Afficher les {publicSiteObservation.trackers.length - 8} autres domaines classés</summary>
                    <div>{publicSiteObservation.trackers.slice(8).map((tracker) => (
                      <article><strong>{tracker.entity}</strong><code>{tracker.domain}</code><small>{tracker.categories.join(" · ")}</small></article>
                    ))}</div>
                  </details>
                )}
              </div>
            ) : (
              <p class="no-tracker">Aucun domaine chargé pendant ce test ne correspondait aux catégories de suivi retenues dans la version indiquée de Tracker Radar. Ce résultat ponctuel ne garantit pas l'absence de traceur sur les autres pages ou à une autre date.</p>
            )}
          </div>
        ) : (
          <p class="observation-pending">Aucune observation technique relue n'est encore publiée pour ce site. La fiche reste vide plutôt que d'afficher une détection incertaine.</p>
        )}
        <footer><a href="/methodologie/#observation-sites-publics">Lire les règles, les limites et la version du référentiel</a></footer>
      </section>
    </article>

    <aside class="profile-aside">
      <section class="unknown-panel">
        <p class="panel-index">QUESTIONS À POSER</p>
        <h2>Avant de signer</h2>
        <ol>{platform.importantUnknowns.map((unknown) => <li>{unknown}</li>)}</ol>
      </section>
      <section class="source-panel" id="sources-reliees">
        <p class="panel-index">Pour aller au document</p>
        <h2>Les sources de cette fiche</h2>
        <ol>{linkedSources.map((source) => <li><a href={source.url} rel="noopener"><strong>{source.title}</strong><span>{source.publisher} · consulté le {source.accessedAt.split("-").reverse().join("/")}</span></a></li>)}</ol>
      </section>
      <div class="profile-actions">
        <a class="button" href={`/comparer/?ids=${platform.slug}`}>Comparer cette plateforme</a>
        <a class="contribute-link" href={`/contribuer/?plateforme=${encodeURIComponent(platform.displayName)}`}>
          <InterfaceIcon name="action" />
          <span><strong>Vous représentez {platform.displayName} ?</strong><small>Apportez une source ou signalez une erreur.</small></span>
        </a>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .profile-cover { background: #142c30; color: #e8eee0; border-bottom: 1px solid #758671; }
  .profile-cover-inner { display: grid; grid-template-columns: minmax(0,1fr) 22rem; gap: clamp(2rem,5vw,5rem); align-items: center; padding-block: 2.6rem 3.2rem; }
  .back-link { display: inline-flex; gap: .5rem; align-items: center; color: #c0d0c0; font-size: .8rem; }
  .back-link :global(svg) { width: .95rem; rotate: 180deg; }
  .page-breadcrumb { display: flex; flex-wrap: wrap; gap: .6rem; color: #a6b8a8; font-size: .8rem; }
  .breadcrumb-current { overflow-wrap: anywhere; }
  .breadcrumb-separator { color: #7c9680; }
  .profile-reference { display: flex; gap: .8rem; flex-wrap: wrap; align-items: center; margin-top: 2rem; color: #c8b296; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .profile-reference i { width: 2rem; height: 1px; background: #ad9270; }
  .profile-cover h1 { margin: .8rem 0 0; color: #f3eee1; font: 400 clamp(2.5rem,4.8vw,4.2rem)/1.06 var(--font-serif); letter-spacing: -.03em; overflow-wrap: anywhere; }
  .official-name { display: block; margin-top: 1rem; color: #b2c6b5; font-size: .78rem; }
  .profile-copy > p { max-width: 42rem; color: #c6d4c3; font-size: 1rem; line-height: 1.7; }
  .profile-audiences { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.3rem; }
  .profile-audiences span { padding: .32rem .65rem; border: 1px solid #5d7664; border-radius: .3rem; color: #d1ddc8; font-size: .78rem; }
  .profile-ledger { position: relative; padding: 1.2rem 1.4rem; border: 1px solid #c0cbb8; background: #f2eee2; border-radius: .3rem; color: var(--bright); box-shadow: 5px 5px 0 #839781; }
  .profile-ledger header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; align-items: center; padding-bottom: .9rem; border-bottom: 1px dashed #b5c1ad; }
  .profile-ledger header > span { font-size: .75rem; letter-spacing: .035em; color: #597251; }
