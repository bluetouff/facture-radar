---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import EvidenceRow from "../../components/EvidenceRow.astro";
import InterfaceIcon from "../../components/InterfaceIcon.astro";
import { platforms } from "../../data/platforms";
import sources from "../../data/sources.json";
import { sourceCount } from "../../lib/evidence";

export function getStaticPaths() {
  return platforms.map((platform) => ({ params: { slug: platform.slug }, props: { platform } }));
}

const { platform } = Astro.props;
const targetLabels = { micro: "indépendants", tpe: "TPE", pme: "PME", eti: "ETI", ge: "grands comptes" } as const;
const platformIndex = Math.max(0, platforms.findIndex((candidate) => candidate.slug === platform.slug));
const profileTone = `tone-${platformIndex % 5}`;
const linkedSourceIds = new Set<string>();
for (const value of Object.values(platform)) {
  if (!value || typeof value !== "object" || !("sourceIds" in value)) continue;
  for (const sourceId of value.sourceIds as string[]) linkedSourceIds.add(sourceId);
}
const linkedSources = sources.filter((source) => linkedSourceIds.has(source.id));

const rows = [
  ["Statut DGFiP", platform.officialStatus],
  ["Date d'immatriculation", platform.registeredAt],
  ["Prix de l'offre étudiée", platform.pricing],
  ["Volume inclus", platform.allowance],
  ["Émission", platform.sendsInvoices],
  ["Réception", platform.receivesInvoices],
  ["E-reporting", platform.eReporting],
  ["Compte bancaire requis", platform.bankAccountRequired],
  ["Accès pour le comptable", platform.accountantAccess],
  ["API publique", platform.publicApi],
  ["Export des données", platform.exportDocumented],
  ["Intégrations", platform.integrations],
  ["Formats", platform.formats],
  ["Pays d'hébergement", platform.hostingCountries],
  ["ISO 27001", platform.iso27001],
  ["Engagement minimal", platform.commitmentMonths],
] as const;

const choiceRows = rows.slice(0, 9);
const technicalRows = rows.slice(9);
const pricing = platform.pricing.value;
const priceValue = pricing?.kind === "free"
  ? "0 € HT"
  : pricing?.kind === "included"
    ? "Inclus dans une offre"
    : pricing?.monthlyFrom !== null && pricing?.monthlyFrom !== undefined
      ? `Dès ${pricing.monthlyFrom} € HT / mois`
      : pricing?.kind === "quote"
        ? "Sur devis"
        : "À confirmer";
const bankValue = platform.bankAccountRequired.value === true
  ? "Connexion requise"
  : platform.bankAccountRequired.value === false
    ? "Compte pro non requis"
    : "À confirmer";
const accountantValue = platform.accountantAccess.value === true
  ? "Accès documenté"
  : platform.accountantAccess.value === false
    ? "Accès non prévu"
    : "À confirmer";
const reviewedAt = platform.officialStatus.checkedAt.split("-").reverse().map((part, index) => index === 2 ? part.slice(-2) : part).join(".");
---

<BaseLayout
  title={`${platform.displayName} : prix, fonctions et informations utiles | PA Check`}
  description={`Prix, fonctions, conditions et points à confirmer pour ${platform.displayName}, plateforme agréée de facturation électronique.`}
>
  <section class:list={["profile-cover", profileTone]}>
    <div class="shell profile-cover-inner">
      <div class="profile-copy">
        <a class="back-link" href="/plateformes/"><InterfaceIcon name="arrow" /> Retour à l'atlas</a>
        <div class="profile-reference">
          <span>dossier {String(platformIndex + 1).padStart(2, "0")} / {platforms.length}</span>
          <i></i>
          <span>revu le {reviewedAt}</span>
        </div>
        <h1>{platform.displayName}</h1>
        <span class="official-name">Nom dans la liste DGFiP : {platform.officialName}</span>
        <p>{platform.summary}</p>
        <div class="profile-audiences">{platform.targets.map((target) => <span>{targetLabels[target]}</span>)}</div>
      </div>

      <aside class="profile-ledger" aria-label="Repères documentaires">
        <header><span>FICHE ACTIVE</span><EvidenceBadge status="official" label="Liste DGFiP" /></header>
        <div class="ledger-number"><strong>{sourceCount(platform)}</strong><span>sources publiques<br />reliées à cette fiche</span></div>
        <dl>
          <div><dt>Immatriculation</dt><dd>{platform.registeredAt.value?.split("-").reverse().join(".")}</dd></div>
          <div><dt>Points à confirmer</dt><dd>{platform.importantUnknowns.length}</dd></div>
          <div><dt>Publicité</dt><dd>Aucune offre sponsorisée</dd></div>
        </dl>
        <p>Les absences d'information ne deviennent jamais des réponses positives.</p>
      </aside>
    </div>
  </section>

  <section class="shell choice-snapshot" aria-label="Les trois premiers repères">
    <article>
      <span><InterfaceIcon name="verdict" /></span>
      <div><p>Budget public</p><strong>{priceValue}</strong><small>{platform.pricing.value?.label ?? platform.pricing.note}</small></div>
    </article>
    <article class:list={{ warning: platform.bankAccountRequired.value === true }}>
      <span><InterfaceIcon name="route" /></span>
      <div><p>Compte ou banque</p><strong>{bankValue}</strong><small>{platform.bankAccountRequired.note ?? "Le prérequis est indiqué dans la documentation consultée."}</small></div>
    </article>
    <article>
      <span><InterfaceIcon name="layers" /></span>
      <div><p>Travail avec votre comptable</p><strong>{accountantValue}</strong><small>{platform.accountantAccess.note ?? "Le périmètre exact dépend de l'offre et des droits accordés."}</small></div>
    </article>
  </section>

  <section class="shell profile-layout">
    <article class="profile-facts">
      <header class="matrix-head">
        <div><p class="mono-label">pour décider</p><span>01</span></div>
        <h2>Ce que les sources permettent de dire aujourd'hui.</h2>
        <p>Les premiers critères concernent le prix, les flux couverts et les conditions d'accès. Ouvrez chaque source si un point est déterminant pour votre entreprise.</p>
      </header>
      <div class="evidence-matrix">
        {choiceRows.map(([label, evidence]) => <EvidenceRow label={label} evidence={evidence} />)}
      </div>

      <header class="matrix-head secondary-head">
        <div><p class="mono-label">pour intégrer et sortir</p><span>02</span></div>
        <h2>La partie technique et les conditions de continuité.</h2>
        <p>API, exports, formats, hébergement et engagement deviennent importants dès qu'un autre logiciel ou plusieurs entités entrent dans le circuit.</p>
      </header>
      <div class="evidence-matrix">
        {technicalRows.map(([label, evidence]) => <EvidenceRow label={label} evidence={evidence} />)}
      </div>
    </article>

    <aside class="profile-aside">
      <section class="unknown-panel">
        <p class="panel-index">QUESTIONS À POSER</p>
        <h2>Avant de signer</h2>
        <ol>{platform.importantUnknowns.map((unknown) => <li>{unknown}</li>)}</ol>
      </section>
      <section class="source-panel">
        <p class="panel-index">SOURCES RELIÉES</p>
        <h2>Remonter au document</h2>
        <ol>{linkedSources.map((source) => <li><a href={source.url} rel="noopener"><strong>{source.title}</strong><span>{source.publisher} · consulté le {source.accessedAt.split("-").reverse().join("/")}</span></a></li>)}</ol>
      </section>
      <div class="profile-actions">
        <a class="button" href={`/comparer/?ids=${platform.slug}`}>Comparer cette plateforme</a>
        <a class="contribute-link" href={`/contribuer/?plateforme=${encodeURIComponent(platform.displayName)}`}>
          <InterfaceIcon name="action" />
          <span><strong>Vous représentez {platform.displayName} ?</strong><small>Apportez une source ou signalez une erreur.</small></span>
        </a>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .profile-cover { --profile-tone: #5368d9; position: relative; overflow: hidden; background: #101a2c; }
  .profile-cover.tone-1 { --profile-tone: #775acb; }
  .profile-cover.tone-2 { --profile-tone: #198a75; }
  .profile-cover.tone-3 { --profile-tone: #b06040; }
  .profile-cover.tone-4 { --profile-tone: #3574ad; }
  .profile-cover::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px); background-size: 30px 30px; mask-image: linear-gradient(90deg,#000,transparent 70%); content: ""; }
  .profile-cover::after { position: absolute; top: -16rem; right: -10rem; width: 35rem; height: 35rem; border: 1px solid color-mix(in srgb,var(--profile-tone) 42%,transparent); border-radius: 50%; box-shadow: 0 0 0 4rem color-mix(in srgb,var(--profile-tone) 5%,transparent),0 0 0 8rem color-mix(in srgb,var(--profile-tone) 3%,transparent); content: ""; }
  .profile-cover-inner { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0,1fr) 19rem; gap: clamp(2.5rem,7vw,7rem); align-items: center; padding-block: clamp(2.8rem,6vw,5.4rem); }
  .back-link { display: inline-flex; gap: .45rem; align-items: center; color: rgba(225,232,247,.68); font-size: .76rem; font-weight: 640; }
  .back-link :global(svg) { width: .9rem; height: .9rem; rotate: 180deg; }
  .profile-reference { display: flex; gap: .7rem; align-items: center; margin-top: 2rem; color: #9eb0ff; font: 660 .62rem/1 var(--font-mono); letter-spacing: .055em; text-transform: uppercase; }
  .profile-reference i { width: 3rem; height: 1px; background: linear-gradient(90deg,var(--profile-tone),#78d9c6); }
  .profile-cover h1 { max-width: 16ch; margin: .75rem 0 0; color: #fff; font-size: clamp(2.3rem,4.8vw,3.65rem); font-weight: 470; line-height: 1.04; letter-spacing: -.05em; text-wrap: balance; }
  .official-name { display: block; margin-top: .85rem; color: rgba(224,231,246,.56); font: .7rem/1.5 var(--font-mono); }
  .profile-copy > p { max-width: 47rem; margin: 1.15rem 0 0; color: rgba(239,244,255,.72); font-size: .95rem; line-height: 1.7; }
  .profile-audiences { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.2rem; }
  .profile-audiences span { border: 1px solid rgba(255,255,255,.13); border-radius: 999px; padding: .35rem .58rem; background: rgba(255,255,255,.05); color: rgba(255,255,255,.74); font-size: .75rem; font-weight: 650; }
  .profile-ledger { position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,.14); border-radius: 1.1rem; padding: 1rem; background: rgba(255,255,255,.96); box-shadow: 0 1.5rem 4rem rgba(0,0,0,.2); }
  .profile-ledger::before { position: absolute; inset: 0 0 auto; height: 4px; background: linear-gradient(90deg,var(--profile-tone),#78d9c6); content: ""; }
  .profile-ledger header { display: flex; justify-content: space-between; gap: .6rem; align-items: center; border-bottom: 1px solid var(--line); padding: .15rem 0 .8rem; }
  .profile-ledger header > span { color: var(--profile-tone); font: 690 .68rem/1 var(--font-mono); letter-spacing: .06em; }
  .ledger-number { display: flex; gap: .7rem; align-items: end; padding-block: 1.15rem; }
  .ledger-number strong { color: var(--bright); font-size: 3.2rem; font-weight: 520; line-height: .85; letter-spacing: -.07em; }
  .ledger-number span { color: var(--muted); font-size: .76rem; line-height: 1.4; }
  .profile-ledger dl { margin: 0; border-block: 1px solid var(--line); }
  .profile-ledger dl > div { display: flex; justify-content: space-between; gap: .7rem; padding-block: .58rem; }
  .profile-ledger dl > div + div { border-top: 1px solid var(--line); }
  .profile-ledger dt { color: var(--muted); font-size: .76rem; }
  .profile-ledger dd { margin: 0; color: var(--bright); font-size: .76rem; font-weight: 680; text-align: right; }
  .profile-ledger > p { margin: .8rem 0 0; color: var(--muted); font-size: .75rem; line-height: 1.5; }
  .choice-snapshot { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3,1fr); gap: .75rem; margin-top: -1.5rem; }
  .choice-snapshot article { display: grid; grid-template-columns: auto 1fr; gap: .8rem; align-items: start; border: 1px solid var(--line); border-radius: 1rem; padding: 1rem; background: rgba(255,255,255,.97); box-shadow: 0 .8rem 2.2rem rgba(27,40,72,.09); }
  .choice-snapshot article > span { display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border-radius: .7rem; background: var(--signal-soft); color: var(--signal); }
  .choice-snapshot article.warning > span { background: var(--amber-soft); color: var(--amber); }
  .choice-snapshot :global(svg) { width: 1rem; height: 1rem; }
  .choice-snapshot p { margin: 0; color: var(--muted); font-size: .75rem; font-weight: 680; text-transform: uppercase; }
  .choice-snapshot strong { display: block; margin-top: .2rem; color: var(--bright); font-size: .83rem; }
  .choice-snapshot small { display: block; margin-top: .25rem; color: var(--muted); font-size: .76rem; line-height: 1.45; }
  .profile-layout { display: grid; grid-template-columns: minmax(0,1fr) 20rem; gap: 1.4rem; padding-top: clamp(3rem,6vw,5rem); }
  .matrix-head { display: grid; grid-template-columns: 10rem minmax(18rem,.8fr) minmax(17rem,1fr); gap: 1.2rem; align-items: end; border-bottom: 1px solid var(--line); padding: 0 .2rem 1.25rem; }
  .matrix-head > div { display: grid; gap: .7rem; justify-items: start; }
  .matrix-head > div > span { color: var(--signal); font: 690 .7rem/1 var(--font-mono); }
  .matrix-head h2 { margin: 0; color: var(--bright); font-size: clamp(1.5rem,2.8vw,2.1rem); font-weight: 500; line-height: 1.15; letter-spacing: -.037em; }
  .matrix-head > p { margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.6; }
  .secondary-head { margin-top: 3.8rem; }
  .evidence-matrix { display: grid; gap: .55rem; margin-top: .8rem; }
  .profile-aside { display: grid; gap: 1rem; align-content: start; }
  .unknown-panel,.source-panel { overflow: hidden; border: 1px solid var(--line); border-radius: 1.05rem; padding: 1rem; background: rgba(255,255,255,.82); box-shadow: 0 .6rem 2rem rgba(41,57,86,.045); }
  .unknown-panel { border-top: 3px solid var(--amber); }
  .source-panel { border-top: 3px solid var(--signal); }
  .panel-index { margin: 0; color: var(--muted); font: 680 .75rem/1 var(--font-mono); letter-spacing: .055em; }
  .profile-aside h2 { margin: .6rem 0 0; color: var(--bright); font-size: 1.1rem; font-weight: 510; }
  .unknown-panel ol { margin: 1rem 0 0; padding: 0; list-style: none; counter-reset: unknown; }
  .unknown-panel li { display: grid; grid-template-columns: auto 1fr; gap: .6rem; color: var(--paper); font-size: .8rem; counter-increment: unknown; }
  .unknown-panel li + li { margin-top: .7rem; }
  .unknown-panel li::before { display: grid; place-items: center; width: 1.45rem; height: 1.45rem; border-radius: 50%; background: var(--amber-soft); color: var(--amber); content: counter(unknown); font: 680 .58rem/1 var(--font-mono); }
  .source-panel ol { margin: .8rem 0 0; padding: 0; list-style: none; }
  .source-panel li { border-top: 1px solid var(--line); padding-block: .7rem; }
  .source-panel a { display: grid; }
  .source-panel strong { color: var(--paper); font-size: .76rem; line-height: 1.4; }
  .source-panel span { margin-top: .25rem; color: var(--muted); font: .7rem/1.45 var(--font-mono); }
  .profile-actions { display: grid; gap: .65rem; }
  .contribute-link { display: grid; grid-template-columns: auto 1fr; gap: .65rem; align-items: center; border: 1px solid color-mix(in srgb,var(--accent) 21%,var(--line)); border-radius: .9rem; padding: .85rem; background: linear-gradient(145deg,color-mix(in srgb,var(--accent) 7%,#fff),#fff); }
  .contribute-link > :global(svg) { width: 1.05rem; height: 1.05rem; color: var(--accent); }
  .contribute-link span { display: grid; }
  .contribute-link strong { color: var(--bright); font-size: .78rem; }
  .contribute-link small { color: var(--muted); font-size: .76rem; }
  @media (max-width: 1000px) { .profile-cover-inner,.profile-layout { grid-template-columns: 1fr; } .profile-ledger { display: grid; grid-template-columns: 1fr auto; gap: 0 1.5rem; } .profile-ledger header { grid-column: 1 / -1; } .profile-ledger dl { grid-column: 1; } .profile-ledger > p { grid-column: 1 / -1; } .profile-aside { grid-template-columns: repeat(2,1fr); } .profile-actions { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; } }
  @media (max-width: 820px) { .choice-snapshot { grid-template-columns: 1fr; } .matrix-head { grid-template-columns: 1fr; } .matrix-head > div { display: flex; justify-content: space-between; } }
  @media (max-width: 620px) { .profile-cover-inner { padding-top: 2.3rem; } .profile-cover h1 { font-size: 2.45rem; } .profile-ledger { display: block; } .choice-snapshot { margin-top: -1rem; } .profile-aside,.profile-actions { grid-template-columns: 1fr; } .profile-actions { grid-column: auto; } }
</style>
