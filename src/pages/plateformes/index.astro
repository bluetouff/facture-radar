---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlatformCard from "../../components/PlatformCard.astro";
import { platforms } from "../../data/platforms";
---

<BaseLayout
  title={`${platforms.length} plateformes étudiées | PA Check`}
  description="Prix, fonctions et conditions utiles pour quinze plateformes de facturation électronique destinées aux indépendants et aux entreprises."
>
  <section class="shell page-hero">
    <span class="eyebrow">{platforms.length} plateformes en détail</span>
    <h1>Comparez les informations utiles avant de choisir.</h1>
    <p>Prix, fonctions, conditions d'accès et de sortie&nbsp;: chaque fiche rassemble les informations disponibles et signale clairement les points qui restent à confirmer.</p>
  </section>
  <section class="shell">
    <div class="notice">Notre sélection compte {platforms.length} plateformes. L'<a href="/annuaire/">annuaire officiel</a> permet de consulter l'ensemble de la liste publiée par la DGFiP.</div>
    <div class="platform-grid section">
      {platforms.map((platform, index) => <PlatformCard platform={platform} index={index} />)}
    </div>
  </section>
</BaseLayout>
