---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InterfaceIcon from "../../components/InterfaceIcon.astro";
import { practicalQuestions, type PracticalQuestion } from "../../data/practical-questions";
import sources from "../../data/sources.json";

export function getStaticPaths() {
  return practicalQuestions.map((question) => ({ params: { slug: question.slug }, props: { question } }));
}

interface Props { question: PracticalQuestion }
const { question } = Astro.props as Props;
const questionIndex = practicalQuestions.findIndex((candidate) => candidate.slug === question.slug);
const sourceIds = new Set([
  ...question.sourceIds,
  ...question.recommendations.flatMap((recommendation) => recommendation.sourceIds),
]);
const linkedSources = sources.filter((source) => sourceIds.has(source.id));
const related = practicalQuestions.filter((candidate) => candidate.slug !== question.slug).slice(questionIndex % 4, (questionIndex % 4) + 3);
const stateLabels = { start: "Point de départ", consider: "À examiner", confirm: "À confirmer" } as const;
---

<BaseLayout title={`${question.title} | PA Check`} description={question.description}>
  <section class:list={["answer-cover", `tone-${question.tone}`]}>
    <div class="shell answer-cover-layout">
      <div class="answer-intro">
        <a class="back-link" href="/questions/"><InterfaceIcon name="arrow" /> Toutes les questions</a>
        <p class="answer-reference"><span>QUESTION {String(questionIndex + 1).padStart(2, "0")}</span><i></i><span>{question.category}</span></p>
        <h1>{question.title}</h1>
        <p>{question.description}</p>
      </div>
      <aside class="answer-map" aria-label="Lecture de la réponse">
        <header><span>LECTURE RAPIDE</span><small>moins de 2 minutes</small></header>
        <div class="map-flow">
          <span><b>01</b><InterfaceIcon name={question.icon} /><small>Votre question</small></span>
          <i></i>
          <span><b>02</b><InterfaceIcon name="layers" /><small>{question.recommendations.length} pistes</small></span>
          <i></i>
          <span><b>03</b><InterfaceIcon name="arrow" /><small>Prochaine action</small></span>
        </div>
        <footer><InterfaceIcon name="shield" /> Informations contrôlées le {question.checkedAt.split("-").reverse().join("/")}</footer>
      </aside>
    </div>
  </section>

  <section class="shell answer-layout">
    <article class="answer-main">
      <section class="short-answer" aria-labelledby="short-answer-title">
        <span><InterfaceIcon name="check" /></span>
        <div><p>Réponse courte</p><h2 id="short-answer-title">{question.shortAnswer}</h2><small>{question.answerDetail}</small></div>
      </section>

      <section class="recommendations" aria-labelledby="recommendations-title">
        <header><p class="mono-label">les options à regarder</p><h2 id="recommendations-title">Commencez par ces éléments.</h2></header>
        <div class="recommendation-grid">
          {question.recommendations.map((recommendation, index) => (
            <article class:list={["recommendation", `state-${recommendation.state}`]}>
              <header><span>{String(index + 1).padStart(2, "0")}</span><small>{stateLabels[recommendation.state]}</small></header>
              <h3>{recommendation.label}</h3>
              <p>{recommendation.detail}</p>
              {recommendation.href && <a href={recommendation.href}>Voir le détail <InterfaceIcon name="arrow" /></a>}
            </article>
          ))}
        </div>
      </section>

      <section class="checks" aria-labelledby="checks-title">
        <header><p class="mono-label">avant de décider</p><h2 id="checks-title">Quatre points à contrôler.</h2></header>
        <ol>{question.checks.map((check, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{check}</p></li>)}</ol>
      </section>
    </article>

    <aside class="answer-aside">
      <section class="next-action">
        <p>Votre prochaine étape</p>
        <span><InterfaceIcon name={question.icon} /></span>
        <h2>{question.nextAction.label}</h2>
        <a class="button" href={question.nextAction.href}>Continuer <InterfaceIcon name="arrow" /></a>
      </section>

      <section class="answer-sources">
        <p>Documents consultés</p>
        <h2>{linkedSources.length} sources reliées</h2>
        <ol>{linkedSources.map((source) => <li><a href={source.url} rel="noopener"><strong>{source.title}</strong><span>{source.publisher}</span></a></li>)}</ol>
        <a class="method-link" href="/methodologie/">Comment PA Check met à jour ces informations</a>
      </section>
    </aside>
  </section>

  <section class="shell related-questions">
    <header><p class="mono-label">autres questions</p><h2>Vous pouvez aussi partir d'ici.</h2></header>
    <div>{related.map((candidate) => <a href={`/questions/${candidate.slug}/`}><span><InterfaceIcon name={candidate.icon} /></span><p><small>{candidate.category}</small><strong>{candidate.shortLabel}</strong></p><InterfaceIcon name="arrow" /></a>)}</div>
  </section>
</BaseLayout>

<style>
  .answer-cover { --tone: var(--signal); --soft: #9eafff; position: relative; overflow: hidden; background: #111d32; }
  .answer-cover.tone-violet { --tone: #8065df; --soft: #b9a9f7; }
  .answer-cover.tone-blue { --tone: #4b8bc4; --soft: #9ec7e8; }
  .answer-cover.tone-green { --tone: #229477; --soft: #8dd6c3; }
  .answer-cover.tone-amber { --tone: #be741f; --soft: #e6b06d; }
  .answer-cover.tone-coral { --tone: #c56d5b; --soft: #e8a99d; }
  .answer-cover::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px); background-size: 28px 28px; mask-image: linear-gradient(90deg,#000,transparent 70%); content: ""; }
  .answer-cover::after { position: absolute; top: -16rem; right: -10rem; width: 37rem; height: 37rem; border: 1px solid color-mix(in srgb,var(--tone) 38%,transparent); border-radius: 50%; box-shadow: 0 0 0 4rem color-mix(in srgb,var(--tone) 6%,transparent),0 0 0 8rem color-mix(in srgb,var(--tone) 3%,transparent); content: ""; }
  .answer-cover-layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0,1fr) 22rem; gap: clamp(3rem,8vw,7rem); align-items: center; padding-block: clamp(3rem,6vw,5.2rem); }
  .back-link { display: inline-flex; gap: .45rem; align-items: center; color: rgba(228,234,248,.62); font-size: .78rem; }
  .back-link :global(svg) { width: .85rem; rotate: 180deg; }
  .answer-reference { display: flex; gap: .7rem; align-items: center; margin: 1.8rem 0 0; color: var(--soft); font: 680 .69rem/1 var(--font-mono); letter-spacing: .055em; text-transform: uppercase; }
  .answer-reference i { width: 3rem; height: 1px; background: linear-gradient(90deg,var(--tone),var(--soft)); }
  .answer-intro h1 { max-width: 19ch; margin: .8rem 0 0; color: #fff; font-size: clamp(2.1rem,4.2vw,3.25rem); font-weight: 470; line-height: 1.07; letter-spacing: -.048em; text-wrap: balance; }
  .answer-intro > p:last-child { max-width: 49rem; margin: 1.1rem 0 0; color: rgba(236,241,252,.7); font-size: .96rem; line-height: 1.7; }
  .answer-map { overflow: hidden; border: 1px solid rgba(255,255,255,.14); border-radius: 1.05rem; background: rgba(255,255,255,.97); box-shadow: 0 1.7rem 4.5rem rgba(0,0,0,.22); }
  .answer-map header { display: flex; justify-content: space-between; gap: .6rem; border-bottom: 1px solid var(--line); padding: .85rem .9rem; color: var(--muted); font: 660 .7rem/1 var(--font-mono); letter-spacing: .05em; }
  .map-flow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: .3rem; align-items: center; padding: 1.2rem .8rem; }
  .map-flow > span { display: grid; gap: .45rem; justify-items: center; color: var(--tone); text-align: center; }
  .map-flow b { color: var(--muted); font: 650 .68rem/1 var(--font-mono); }
  .map-flow :global(svg) { width: 1.15rem; height: 1.15rem; }
  .map-flow small { min-height: 2.3em; color: var(--paper); font-size: .75rem; line-height: 1.3; }
  .map-flow > i { width: 1.2rem; height: 1px; background: var(--line-strong); }
  .answer-map footer { display: flex; gap: .45rem; align-items: center; border-top: 1px solid var(--line); padding: .75rem .9rem; background: var(--surface-2); color: var(--muted); font-size: .75rem; }
  .answer-map footer :global(svg) { width: .9rem; color: var(--success); }
  .answer-layout { display: grid; grid-template-columns: minmax(0,1fr) 20rem; gap: 1.2rem; padding-top: clamp(2rem,5vw,4rem); }
  .answer-main { min-width: 0; }
  .short-answer { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; border: 1px solid color-mix(in srgb,var(--success) 25%,var(--line)); border-radius: 1.15rem; padding: 1.25rem; background: linear-gradient(120deg,var(--success-soft),rgba(255,255,255,.94) 68%); box-shadow: 0 .7rem 2rem rgba(41,57,86,.055); }
  .short-answer > span { display: grid; place-items: center; width: 2.7rem; height: 2.7rem; border-radius: .8rem; background: var(--success); color: #fff; }
  .short-answer > span :global(svg) { width: 1.15rem; }
  .short-answer p { margin: 0; color: var(--success); font-size: .76rem; font-weight: 730; text-transform: uppercase; }
  .short-answer h2 { max-width: 30ch; margin: .28rem 0 0; color: var(--bright); font-size: clamp(1.35rem,2.5vw,1.85rem); font-weight: 510; line-height: 1.2; letter-spacing: -.035em; }
  .short-answer small { display: block; max-width: 75ch; margin-top: .65rem; color: var(--paper); font-size: .84rem; line-height: 1.62; }
  .recommendations,.checks { margin-top: 3.2rem; }
  .recommendations > header h2,.checks > header h2,.related-questions > header h2 { margin: .65rem 0 0; color: var(--bright); font-size: clamp(1.55rem,2.7vw,2rem); font-weight: 490; line-height: 1.15; letter-spacing: -.035em; }
  .recommendation-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .75rem; margin-top: 1.2rem; }
  .recommendation { --state: var(--signal); position: relative; overflow: hidden; min-height: 14.5rem; border: 1px solid color-mix(in srgb,var(--state) 20%,var(--line)); border-radius: 1rem; padding: 1rem; background: rgba(255,255,255,.86); }
  .recommendation::before { position: absolute; inset: 0 auto 0 0; width: .22rem; background: var(--state); content: ""; }
  .recommendation.state-consider { --state: var(--blue); }
  .recommendation.state-confirm { --state: var(--amber); }
  .recommendation header { display: flex; justify-content: space-between; gap: .6rem; align-items: center; }
  .recommendation header span { color: var(--state); font: 700 .7rem/1 var(--font-mono); }
  .recommendation header small { border-radius: 999px; padding: .28rem .48rem; background: color-mix(in srgb,var(--state) 9%,#fff); color: var(--state); font-size: .75rem; font-weight: 700; }
  .recommendation h3 { margin: 1.2rem 0 0; color: var(--bright); font-size: 1.05rem; font-weight: 540; letter-spacing: -.02em; }
  .recommendation p { margin: .55rem 0 0; color: var(--muted); font-size: .8rem; line-height: 1.58; }
  .recommendation a { position: absolute; right: 1rem; bottom: .9rem; left: 1rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--line); padding-top: .65rem; color: var(--state); font-size: .78rem; font-weight: 700; }
  .recommendation a :global(svg) { width: .82rem; }
  .checks ol { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .65rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }
  .checks li { display: grid; grid-template-columns: auto 1fr; gap: .75rem; align-items: start; border: 1px solid var(--line); border-radius: .9rem; padding: .85rem; background: rgba(255,255,255,.7); }
  .checks li span { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .6rem; background: var(--signal-soft); color: var(--signal); font: 680 .64rem/1 var(--font-mono); }
  .checks li p { margin: .05rem 0 0; color: var(--paper); font-size: .8rem; line-height: 1.5; }
  .answer-aside { display: grid; gap: .9rem; align-content: start; }
  .next-action,.answer-sources { overflow: hidden; border: 1px solid var(--line); border-radius: 1.05rem; padding: 1rem; background: rgba(255,255,255,.86); }
  .next-action { border-top: 3px solid var(--tone); }
  .next-action > p,.answer-sources > p { margin: 0; color: var(--muted); font: 680 .72rem/1 var(--font-mono); letter-spacing: .045em; text-transform: uppercase; }
  .next-action > span { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; margin-top: 1.5rem; border-radius: .75rem; background: color-mix(in srgb,var(--tone) 10%,#fff); color: var(--tone); }
  .next-action > span :global(svg) { width: 1.1rem; }
  .next-action h2 { margin: .7rem 0 0; color: var(--bright); font-size: 1.2rem; font-weight: 510; line-height: 1.25; }
  .next-action .button { display: flex; gap: .5rem; margin-top: 1.2rem; }
  .next-action .button :global(svg) { width: .85rem; }
  .answer-sources { border-top: 3px solid var(--signal); }
  .answer-sources h2 { margin: .6rem 0 0; color: var(--bright); font-size: 1rem; font-weight: 540; }
  .answer-sources ol { margin: .8rem 0 0; padding: 0; list-style: none; }
  .answer-sources li { border-top: 1px solid var(--line); padding-block: .7rem; }
  .answer-sources a { display: grid; }
  .answer-sources strong { color: var(--paper); font-size: .76rem; line-height: 1.4; }
  .answer-sources span { margin-top: .22rem; color: var(--muted); font-size: .75rem; }
  .answer-sources .method-link { margin-top: .5rem; color: var(--signal); font-size: .76rem; line-height: 1.4; }
  .related-questions { margin-top: 3.5rem; border-top: 1px solid var(--line); padding-top: 2.5rem; }
  .related-questions > div { display: grid; grid-template-columns: repeat(3,1fr); gap: .7rem; margin-top: 1.2rem; }
  .related-questions a { display: grid; grid-template-columns: auto 1fr auto; gap: .65rem; align-items: center; border: 1px solid var(--line); border-radius: .9rem; padding: .8rem; background: rgba(255,255,255,.74); }
  .related-questions a > span { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: .65rem; background: var(--signal-soft); color: var(--signal); }
  .related-questions a > span :global(svg),.related-questions a > :global(svg) { width: .9rem; }
  .related-questions p { display: grid; margin: 0; }
  .related-questions small { color: var(--muted); font-size: .75rem; }
  .related-questions strong { margin-top: .1rem; color: var(--bright); font-size: .78rem; line-height: 1.35; }
  @media (max-width: 950px) { .answer-cover-layout,.answer-layout { grid-template-columns: 1fr; } .answer-map { max-width: 28rem; } .answer-aside { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 750px) { .recommendation-grid,.checks ol,.related-questions > div { grid-template-columns: 1fr; } .recommendation { min-height: auto; padding-bottom: 1rem; } .recommendation a { position: static; margin-top: .8rem; } }
  @media (max-width: 560px) { .answer-intro h1 { font-size: 2.15rem; } .answer-map { display: none; } .answer-aside { grid-template-columns: 1fr; } .short-answer { grid-template-columns: 1fr; } }
</style>
