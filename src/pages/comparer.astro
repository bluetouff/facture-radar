---
import BaseLayout from "../layouts/BaseLayout.astro";
import CompareTool from "../components/CompareTool.astro";
---

<BaseLayout
  title="Comparer trois plateformes | PA Check"
  description="Comparez côte à côte le prix, les fonctions et les conditions de trois plateformes de facturation électronique."
>
  <section class="shell page-hero">
    <span class="eyebrow">jusqu'à trois plateformes</span>
    <h1>Comparez les plateformes point par point.</h1>
    <p>Prix, fonctions, accès et conditions sont présentés côte à côte. Les informations à confirmer restent clairement signalées.</p>
  </section>
  <section class="shell">
    <CompareTool />
  </section>
</BaseLayout>
