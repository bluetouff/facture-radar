---
import BaseLayout from "../layouts/BaseLayout.astro";
import { platforms } from "../data/platforms";
---

<BaseLayout title="Page introuvable | PA Check" description="Cette page n'existe pas ou a changé d'adresse.">
  <section class="shell page-hero">
    <span class="eyebrow">erreur 404</span>
    <h1>Cette page a changé d'adresse.</h1>
    <p>Revenez à l'accueil ou consultez les {platforms.length} plateformes étudiées.</p>
    <div class="hero-actions"><a class="button" href="/verifier-mon-outil/">Faire le point sur mon outil</a><a class="button secondary" href="/diagnostic/">Choisir une plateforme</a></div>
  </section>
</BaseLayout>
