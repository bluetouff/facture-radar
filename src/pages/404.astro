---
import BaseLayout from "../layouts/BaseLayout.astro";
import { platforms } from "../data/platforms";
---

<BaseLayout title="Page introuvable | PA Check" description="Cette page n'existe pas ou a changé d'adresse.">
  <section class="shell page-hero">
    <span class="eyebrow">erreur 404</span>
    <h1>Cette preuve a changé d'adresse.</h1>
    <p>Revenez au vérificateur ou consultez les {platforms.length} fiches documentées.</p>
    <div class="hero-actions"><a class="button" href="/verifier-mon-outil/">Vérifier un outil</a><a class="button secondary" href="/plateformes/">Voir les fiches</a></div>
  </section>
</BaseLayout>
