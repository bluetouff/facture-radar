---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChoiceMap from "../components/ChoiceMap.astro";
import DiagnosticEngine from "../components/DiagnosticEngine.astro";
---

<BaseLayout
  title="Trouver une plateforme adaptée | PA Check"
  description="Trois questions simples pour repérer les plateformes adaptées à votre activité, votre volume de factures et votre priorité."
>
  <section class="shell page-hero diagnostic-hero">
    <div>
      <span class="eyebrow">3 questions · toutes les options accessibles</span>
      <h1>Quelle plateforme répond à votre besoin&nbsp;?</h1>
      <p>Indiquez votre taille, votre volume mensuel de factures et votre priorité. PA Check met en avant les fiches les mieux renseignées sans masquer les autres résultats.</p>
    </div>
    <div class="choice-map-visual"><ChoiceMap /></div>
  </section>
  <section class="shell">
    <DiagnosticEngine />
  </section>
</BaseLayout>

<style>
  .diagnostic-hero { display: grid; grid-template-columns: minmax(0, .95fr) minmax(440px, .85fr); gap: clamp(2.4rem, 6vw, 6rem); align-items: center; }
  .diagnostic-hero h1 { max-width: 14ch; }
  .diagnostic-hero > div > p { max-width: 42rem; margin: 1.25rem 0 0; color: var(--paper); font-size: clamp(.98rem, 1.8vw, 1.14rem); line-height: 1.7; }
  @media (max-width: 900px) { .diagnostic-hero { grid-template-columns: 1fr; gap: 1rem; } .diagnostic-hero h1 { max-width: 18ch; } .choice-map-visual { display: none; } }
</style>
