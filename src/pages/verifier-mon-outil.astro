---
import BaseLayout from "../layouts/BaseLayout.astro";
import InterfaceIcon from "../components/InterfaceIcon.astro";
import ToolJourney from "../components/ToolJourney.astro";
import { journeyProfiles } from "../data/journey-profiles";
---

<BaseLayout
  title="Puis-je garder mon logiciel de facturation ? | PA Check"
  description="Entrez le nom de votre outil et obtenez une réponse immédiate : le garder, le compléter ou prévoir une autre solution."
>
  <section class="decision-hero">
    <div class="shell decision-hero-layout">
      <div class="decision-copy">
        <p class="decision-kicker"><span>01</span> une question suffit</p>
        <h1>Pouvez-vous garder votre outil&nbsp;?</h1>
        <p>Entrez son nom. Vous saurez tout de suite ce qui est déjà couvert et ce qu'il reste à faire.</p>
      </div>
      <div class="decision-promise" aria-label="Ce que donne ce parcours">
        <span><b>01</b><strong>Une conclusion claire</strong><small>Garder, compléter ou changer</small></span>
        <i></i>
        <span><b>02</b><strong>La prochaine action</strong><small>Sans formulaire préalable</small></span>
      </div>
    </div>
  </section>

  <section class="shell section existing-tool" id="verifier-logiciel">
    <ToolJourney />
    <p class="covered-note">{journeyProfiles.length} logiciels ou plateformes disposent d'un parcours détaillé.</p>
  </section>

  <section class="shell section next-needs" aria-labelledby="next-needs-title">
    <header>
      <p class="mono-label">un autre besoin&nbsp;?</p>
      <h2 id="next-needs-title">Passez directement à la bonne réponse.</h2>
    </header>
    <div class="next-needs-grid">
      <a href="/questions/envoyer-factur-x-sans-solution-compatible/">
        <span><InterfaceIcon name="invoice" /></span>
        <p><small>Votre fichier est déjà prêt</small><strong>Où envoyer un Factur-X sans intermédiaire&nbsp;?</strong></p>
        <InterfaceIcon name="arrow" />
      </a>
      <a href="/diagnostic/">
        <span><InterfaceIcon name="target" /></span>
        <p><small>Vous cherchez une solution</small><strong>Quelles plateformes regarder pour votre activité&nbsp;?</strong></p>
        <InterfaceIcon name="arrow" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .decision-hero { position: relative; overflow: hidden; border-bottom: 1px solid rgba(255,255,255,.08); padding-block: clamp(1.6rem,3vw,2.5rem); background: radial-gradient(circle at 80% 15%,rgba(64,91,216,.24),transparent 24rem),radial-gradient(circle at 12% 100%,rgba(22,128,101,.11),transparent 24rem),#111d32; }
  .decision-hero::before { position: absolute; top: -11rem; right: -9rem; width: 28rem; height: 28rem; border: 1px solid rgba(155,171,250,.2); border-radius: 50%; box-shadow: 0 0 0 4rem rgba(64,91,216,.045),0 0 0 8rem rgba(22,128,101,.025); content: ""; }
  .decision-hero-layout { position: relative; display: grid; grid-template-columns: minmax(0,1fr) minmax(25rem,.8fr); gap: clamp(2rem,6vw,5rem); align-items: center; }
  .decision-kicker { display: flex; gap: .65rem; align-items: center; margin: 0; color: #aebaff; font: 680 .76rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }
  .decision-kicker span { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid rgba(173,186,255,.28); border-radius: 50%; background: rgba(255,255,255,.06); }
  .decision-copy h1 { max-width: 18ch; margin: .75rem 0 0; color: #f7f9ff; font-size: clamp(1.9rem,3.4vw,2.8rem); font-weight: 460; line-height: 1.06; letter-spacing: -.044em; }
  .decision-copy > p:last-child { max-width: 42rem; margin: 1rem 0 0; color: rgba(235,240,250,.72); font-size: 1rem; line-height: 1.65; }
  .decision-promise { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; border: 1px solid rgba(255,255,255,.12); border-radius: 1rem; padding: 1rem; background: rgba(255,255,255,.045); }
  .decision-promise > span { display: grid; }
  .decision-promise b { color: #9eadff; font: 680 .67rem/1 var(--font-mono); }
  .decision-promise strong { margin-top: .4rem; color: #f5f8ff; font-size: .84rem; font-weight: 620; }
  .decision-promise small { margin-top: .18rem; color: rgba(235,240,250,.68); font-size: .76rem; }
  .decision-promise i { width: 2rem; height: 1px; background: linear-gradient(90deg,#9eadff,#73d8c0); }
  .existing-tool { max-width: 72rem; scroll-margin-top: 5.5rem; }
  .existing-tool.section { padding-top: clamp(2rem,4vw,3rem); }
  .covered-note { margin: .7rem 0 0; color: var(--muted); font-size: .76rem; }
  .next-needs { padding-top: 1rem; }
  .next-needs > header h2 { margin: .45rem 0 0; color: var(--bright); font-size: clamp(1.35rem,2.5vw,1.8rem); font-weight: 490; letter-spacing: -.035em; }
  .next-needs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin-top: 1rem; }
  .next-needs-grid > a { display: grid; grid-template-columns: auto 1fr auto; gap: .85rem; align-items: center; border: 1px solid var(--line); border-radius: 1rem; padding: 1rem; background: rgba(255,255,255,.78); color: var(--paper); box-shadow: 0 .6rem 1.8rem rgba(41,57,86,.05); }
  .next-needs-grid > a:hover { border-color: color-mix(in srgb,var(--signal) 35%,var(--line)); color: var(--paper); }
  .next-needs-grid > a > span { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: .75rem; background: var(--signal-soft); color: var(--signal); }
  .next-needs-grid > a > span :global(svg), .next-needs-grid > a > :global(svg) { width: 1rem; height: 1rem; }
  .next-needs-grid p { display: grid; margin: 0; }
  .next-needs-grid small { color: var(--muted); font-size: .76rem; }
  .next-needs-grid strong { margin-top: .15rem; color: var(--bright); font-size: .84rem; font-weight: 640; }
  .next-needs-grid > a > :global(svg) { color: var(--signal); }
  @media (max-width: 950px) { .decision-hero-layout { grid-template-columns: 1fr; gap: 1.25rem; } .decision-copy h1 { max-width: 18ch; } }
  @media (max-width: 700px) { .next-needs-grid { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .decision-promise { display: none; } .decision-copy h1 { font-size: 2.05rem; } .existing-tool.section { padding-top: 1.2rem; } }
</style>
