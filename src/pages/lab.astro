---
import BaseLayout from "../layouts/BaseLayout.astro";
import InterfaceIcon from "../components/InterfaceIcon.astro";
import { lab } from "../data/lab";
import sourcesData from "../data/sources.json";

const sources = new Map(sourcesData.map((source) => [source.id, source]));
const statusLabels = {
  tested: "Oui, dans notre test",
  failed: "Non, dans notre test",
  partial: "Oui, avec une limite",
  not_tested: "Pas encore vérifié",
} as const;
const statusIcons = {
  tested: "check",
  failed: "alert",
  partial: "check",
  not_tested: "question",
} as const;
const displayedPlatforms = [...lab.platforms].sort((left, right) => Number(right.slug === "b2brouter") - Number(left.slug === "b2brouter"));
---

<BaseLayout
  title="PA Check Lab | Est-ce que votre facture passe vraiment ?"
  description="PA Check essaie les mêmes factures auprès des plateformes et publie une réponse courte, la limite rencontrée et l’action utile."
>
  <section class="lab-hero">
    <div class="shell lab-hero-grid">
      <div class="lab-hero-copy">
        <span class="lab-label"><InterfaceIcon name="lab" /> Tests en conditions réelles</span>
        <h1>Votre facture <span>passe-t-elle</span> <em>vraiment&nbsp;?</em></h1>
        <p>Nous essayons les mêmes factures chez chaque plateforme. Vous obtenez une réponse courte, la limite rencontrée et ce qu’il faut faire ensuite.</p>
        <a class="button lab-button" href="#resultats">Voir les réponses actuelles <InterfaceIcon name="arrow" /></a>
      </div>

      <aside class="current-test" aria-label="Premier test en préparation">
        <div class="test-illustration" aria-hidden="true">
          <div class="mini-file"><span>PDF</span><i></i><i></i><strong>€</strong></div>
          <div class="test-path"><i></i><i></i><i></i></div>
          <div class="arrival"><InterfaceIcon name="check" /></div>
        </div>
        <p>Premier essai en préparation</p>
        <h2>B2Brouter</h2>
        <strong>Pas encore vérifié</strong>
        <span>Nous commençons par vérifier que les trois fichiers sont bien importés et correctement lus.</span>
      </aside>
    </div>
  </section>

  <main>
    <section class="shell results-section" id="resultats" aria-labelledby="results-title">
      <header class="section-head">
        <div>
          <p class="section-kicker">Les réponses actuelles</p>
          <h2 id="results-title">Est-ce que ça marche&nbsp;?</h2>
        </div>
        <p>Dès qu’un essai complet est terminé, la réponse apparaît ici avec la date et l’éventuelle limite à connaître.</p>
      </header>

      <div class="platform-results">
        {displayedPlatforms.map((platform) => (
          <article class:list={["platform-result", { featured: platform.slug === "b2brouter" }]}>
            {platform.slug === "b2brouter" && <span class="campaign-tag">Premier essai en préparation</span>}
            <header>
              <div class="platform-monogram" aria-hidden="true">{platform.name.slice(0, 2).toUpperCase()}</div>
              <div><p>Plateforme agréée</p><h3>{platform.name}</h3></div>
            </header>
            <div class={`answer answer-${platform.status.replace("_", "-")}`}>
              <InterfaceIcon name={statusIcons[platform.status]} />
              <strong>{statusLabels[platform.status]}</strong>
            </div>
            <p class="platform-summary">{platform.summary}</p>
            <div class="next-action">
              <span>Prochaine étape</span>
              <p>{platform.nextAction}</p>
            </div>
            <details>
              <summary>Ce que la plateforme publie</summary>
              <div class="source-list">
                {platform.sourceIds.map((sourceId) => {
                  const source = sources.get(sourceId);
                  return source ? <a href={source.url} rel="noopener">{source.title} <InterfaceIcon name="arrow" /></a> : null;
                })}
              </div>
            </details>
          </article>
        ))}
      </div>
    </section>

    <section class="test-kit" id="kit" aria-labelledby="kit-title">
      <div class="shell">
        <header class="section-head kit-head">
          <div>
            <p class="section-kicker">Ce que nous essayons</p>
            <h2 id="kit-title">Trois factures, trois difficultés fréquentes.</h2>
          </div>
          <p>Ce sont des fichiers fictifs et téléchargeables. Chaque plateforme reçoit exactement les mêmes.</p>
        </header>

        <div class="fixture-grid">
          {lab.cases.map((testCase, index) => (
            <article class={`fixture-card fixture-${index + 1}`}>
              <header>
                <span>0{index + 1}</span>
                <div class="file-symbol" aria-hidden="true"><i></i><i></i><b>{testCase.documentTypeCode}</b></div>
              </header>
              <p class="file-kind">{"facturXHref" in testCase ? "Facture Factur-X de test" : "Facture XML de test"}</p>
              <h3>{testCase.title}</h3>
              <p>{testCase.purpose}</p>
              <dl>
                <div><dt>Lignes</dt><dd>{testCase.expected.lineCount}</dd></div>
                <div><dt>TVA</dt><dd>{testCase.expected.vatRates.map((rate) => `${rate} %`).join(" + ")}</dd></div>
                <div><dt>Total</dt><dd>{testCase.expected.grandTotal} €</dd></div>
              </dl>
              <div class="fixture-downloads">
                {"facturXHref" in testCase && testCase.facturXHref && (
                  <a class="primary-download" href={testCase.facturXHref} download><InterfaceIcon name="download" /> Télécharger le Factur-X</a>
                )}
                <a href={testCase.fileHref} download><InterfaceIcon name="download" /> {"facturXHref" in testCase ? "XML seul" : "Télécharger"}</a>
              </div>
              <details>
                <summary>Détails du fichier</summary>
                {"facturXBytes" in testCase && testCase.facturXBytes
                  ? <p>Version {testCase.fileVersion} · PDF {Math.round(testCase.facturXBytes / 1024)} Ko · XML {Math.round(testCase.bytes / 1024)} Ko</p>
                  : <p>Version {testCase.fileVersion} · {Math.round(testCase.bytes / 1024)} Ko</p>}
              </details>
            </article>
          ))}
        </div>

        <div class="fixture-note"><InterfaceIcon name="alert" /><p>Ces factures utilisent des identifiants fictifs. Elles sont réservées aux espaces de démonstration et ne doivent jamais être envoyées à une vraie entreprise.</p></div>
      </div>
    </section>

    <section class="shell simple-method" aria-labelledby="method-title">
      <details>
        <summary id="method-title"><span><InterfaceIcon name="route" /> Comment se déroule un essai&nbsp;?</span><InterfaceIcon name="chevron" /></summary>
        <ol>
          <li><span>1</span><div><h3>Nous déposons les fichiers</h3><p>La plateforme doit les accepter sans ressaisie.</p></div></li>
          <li><span>2</span><div><h3>Nous relisons le résultat</h3><p>Lignes, TVA, total et type de document doivent rester corrects.</p></div></li>
          <li><span>3</span><div><h3>Nous suivons l’envoi</h3><p>Le document doit partir dans le circuit de test et son état doit revenir clairement.</p></div></li>
        </ol>
        <p class="method-limit">Un import réussi ne suffit pas à conclure que tout le parcours fonctionne. La réponse ne change qu’une fois l’essai terminé.</p>
      </details>
    </section>

    <section class="shell contribute-card">
      <div class="contribute-art" aria-hidden="true">
        <span></span><span></span><span></span>
        <InterfaceIcon name="lab" />
      </div>
      <div>
        <p class="section-kicker">Accélérer un test</p>
        <h2>Vous représentez une plateforme&nbsp;?</h2>
        <p>Vous pouvez nous ouvrir un espace de démonstration ou compléter les informations disponibles. PA Check conduit le test et publie le résultat obtenu.</p>
      </div>
      <a class="button secondary" href="/contribuer/">Nous contacter <InterfaceIcon name="arrow" /></a>
    </section>

    <section class="shell lab-sources">
      <p>Les fichiers sont construits à partir des spécifications françaises V3.2 et de la documentation Factur-X consultées le 25 août 2026.</p>
      <div>{lab.sourceIds.map((sourceId) => {
        const source = sources.get(sourceId);
        return source ? <a href={source.url} rel="noopener">{source.title}</a> : null;
      })}</div>
    </section>
  </main>
</BaseLayout>

<style>
  .lab-hero { position: relative; overflow: hidden; background: #0d1b2b; color: #fff; }
  .lab-hero::before { position: absolute; inset: 0; background: radial-gradient(circle at 78% 28%,rgba(98,219,190,.12),transparent 24%),radial-gradient(circle at 8% 95%,rgba(101,122,226,.13),transparent 30%); content: ""; }
  .lab-hero::after { position: absolute; top: -8rem; right: -5rem; width: 35rem; height: 35rem; border: 1px solid rgba(126,222,202,.13); border-radius: 48% 52% 43% 57%; transform: rotate(24deg); content: ""; }
  .lab-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0,1.05fr) minmax(320px,.66fr); gap: clamp(3rem,9vw,8rem); align-items: center; padding-block: clamp(4rem,8vw,6.6rem); }
  .lab-label { display: inline-flex; gap: .5rem; align-items: center; color: #8bdfcc; font-size: .79rem; font-weight: 690; letter-spacing: .025em; }
  .lab-label :global(svg) { width: 1.1rem; height: 1.1rem; }
  .lab-hero h1 { max-width: 14ch; margin: 1.15rem 0 0; color: #f8fbff; font-size: clamp(2.4rem,5.2vw,4.6rem); font-weight: 390; line-height: 1.02; letter-spacing: -.052em; }
  .lab-hero h1 span { white-space: nowrap; }
  .lab-hero h1 em { color: #7edbc6; font-style: normal; font-weight: 410; }
  .lab-hero-copy > p { max-width: 42rem; margin: 1.35rem 0 0; color: #bdc9d4; font-size: clamp(1rem,1.7vw,1.12rem); line-height: 1.7; }
  .lab-button { gap: .5rem; margin-top: 1.6rem; background: #7edbc6; color: #102139; }
  .lab-button:hover { color: #102139; }
  .lab-button :global(svg) { width: .95rem; height: .95rem; }
  .current-test { position: relative; overflow: hidden; border: 1px solid rgba(170,211,210,.22); border-radius: 1.4rem; padding: 1.3rem; background: rgba(8,25,40,.8); box-shadow: 0 2.2rem 5rem rgba(0,0,0,.23); }
  .test-illustration { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; min-height: 7rem; margin-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,.1); padding: .45rem .35rem 1.3rem; }
  .mini-file { position: relative; display: grid; width: 4.4rem; height: 5.5rem; align-content: start; gap: .5rem; border: 1px solid rgba(127,224,202,.35); border-radius: .6rem; padding: .75rem; background: rgba(127,224,202,.06); transform: rotate(-3deg); }
  .mini-file span { color: #7edbc6; font: 700 .7rem/1 var(--font-mono); }
  .mini-file i { height: .25rem; border-radius: 1rem; background: rgba(255,255,255,.16); }
  .mini-file strong { position: absolute; right: -.55rem; bottom: .55rem; display: grid; width: 1.8rem; height: 1.8rem; place-items: center; border-radius: .5rem; background: #6176df; color: #fff; font-size: .78rem; }
  .test-path { display: grid; grid-template-columns: 1fr auto auto; gap: .5rem; align-items: center; }
  .test-path i:first-child { height: 1px; background: linear-gradient(90deg,#6579de,#78d8c3); }
  .test-path i:not(:first-child) { width: .42rem; height: .42rem; border-radius: 50%; background: #7edbc6; box-shadow: 0 0 0 .3rem rgba(126,219,198,.08); }
  .arrival { display: grid; width: 3rem; height: 3rem; place-items: center; border: 1px solid rgba(126,219,198,.35); border-radius: 50%; color: #7edbc6; }
  .arrival :global(svg) { width: 1.25rem; height: 1.25rem; }
  .current-test > p { margin: 0; color: #8293a5; font-size: .76rem; font-weight: 680; text-transform: uppercase; }
  .current-test h2 { margin: .45rem 0 .75rem; color: #f5f9fc; font-size: 1.45rem; font-weight: 480; }
  .current-test > strong { display: inline-flex; border-radius: 999px; padding: .42rem .65rem; background: #28374a; color: #d4dde5; font-size: .78rem; }
  .current-test > span { display: block; margin-top: .9rem; color: #9faebe; font-size: .82rem; line-height: 1.55; }
  .results-section { scroll-margin-top: 7rem; padding-block: clamp(4.5rem,8vw,7rem); }
  .section-head { display: grid; grid-template-columns: minmax(0,1fr) minmax(280px,.65fr); gap: 2.5rem; align-items: end; margin-bottom: 1.6rem; }
  .section-kicker { margin: 0; color: var(--signal); font-size: .76rem; font-weight: 720; letter-spacing: .045em; text-transform: uppercase; }
  .section-head h2, .contribute-card h2 { max-width: 21ch; margin: .65rem 0 0; color: var(--bright); font-size: clamp(1.85rem,3.4vw,2.75rem); font-weight: 430; line-height: 1.12; letter-spacing: -.04em; }
  .section-head > p { margin: 0; color: var(--paper); font-size: .88rem; line-height: 1.7; }
  .platform-results { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .85rem; }
  .platform-result { position: relative; display: flex; min-width: 0; flex-direction: column; border: 1px solid var(--line); border-radius: 1.15rem; padding: 1rem; background: #fff; box-shadow: 0 1.2rem 3rem rgba(30,49,77,.06); }
  .platform-result.featured { border-color: #9bd8cb; background: linear-gradient(145deg,#fff 55%,#f0fbf8); box-shadow: 0 1.4rem 3.5rem rgba(24,119,98,.09); }
  .campaign-tag { align-self: flex-start; margin: -.25rem 0 .9rem; border-radius: 999px; padding: .36rem .55rem; background: #e8f8f4; color: #177862; font-size: .7rem; font-weight: 720; }
  .platform-result > header { display: grid; grid-template-columns: auto 1fr; gap: .75rem; align-items: center; }
  .platform-monogram { display: grid; width: 2.7rem; height: 2.7rem; place-items: center; border-radius: .75rem; background: #152943; color: #91decf; font: 680 .7rem/1 var(--font-mono); }
  .platform-result header p { margin: 0; color: var(--muted); font-size: .7rem; }
  .platform-result h3 { margin: .22rem 0 0; color: var(--bright); font-size: 1.15rem; font-weight: 530; }
  .answer { display: flex; gap: .55rem; align-items: center; margin-top: 1.25rem; border-radius: .8rem; padding: .8rem; background: #f1f4f7; color: #697789; }
  .answer :global(svg) { width: 1.2rem; height: 1.2rem; }
  .answer strong { font-size: .95rem; font-weight: 650; }
  .answer-tested { background: #e8f7f3; color: #14725e; }
  .answer-failed { background: #fff0f0; color: #a43841; }
  .answer-partial { background: #fff6e9; color: #98601e; }
  .platform-summary { min-height: 4rem; margin: .95rem 0 0; color: var(--paper); font-size: .82rem; line-height: 1.6; }
  .next-action { margin-top: auto; border-top: 1px solid var(--line); padding-top: .9rem; }
  .next-action span { color: var(--muted); font-size: .7rem; font-weight: 710; text-transform: uppercase; }
  .next-action p { margin: .35rem 0 0; color: var(--bright); font-size: .78rem; line-height: 1.55; }
  .platform-result details { margin-top: .8rem; }
  .platform-result summary, .fixture-card summary { color: var(--signal); cursor: pointer; font-size: .75rem; font-weight: 680; }
  .source-list { display: grid; gap: .45rem; margin-top: .65rem; }
  .source-list a { display: flex; gap: .35rem; justify-content: space-between; color: var(--paper); font-size: .72rem; line-height: 1.4; }
  .source-list a :global(svg) { width: .85rem; min-width: .85rem; height: .85rem; }
  .test-kit { padding-block: clamp(4rem,8vw,6.5rem); background: #f0f5f4; }
  .kit-head h2 { max-width: 24ch; }
  .fixture-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .85rem; }
  .fixture-card { --tone: #5e71d7; position: relative; overflow: hidden; border: 1px solid color-mix(in srgb,var(--tone) 22%,var(--line)); border-radius: 1.15rem; padding: 1rem; background: #fff; box-shadow: 0 1rem 2.5rem rgba(32,50,79,.05); }
  .fixture-2 { --tone: #188b74; }
  .fixture-3 { --tone: #aa6724; }
  .fixture-card > header { display: flex; justify-content: space-between; align-items: start; }
  .fixture-card > header > span { color: var(--tone); font: 700 .76rem/1 var(--font-mono); }
  .file-symbol { position: relative; display: grid; width: 3.4rem; height: 4.2rem; align-content: center; gap: .38rem; border: 1px solid color-mix(in srgb,var(--tone) 30%,#fff); border-radius: .45rem; padding: .65rem; background: color-mix(in srgb,var(--tone) 7%,#fff); transform: rotate(3deg); }
  .file-symbol i { height: .22rem; border-radius: 1rem; background: color-mix(in srgb,var(--tone) 20%,#fff); }
  .file-symbol i:nth-child(2) { width: 65%; }
  .file-symbol b { position: absolute; right: -.4rem; bottom: .35rem; display: grid; width: 1.55rem; height: 1.55rem; place-items: center; border-radius: .42rem; background: var(--tone); color: #fff; font: 690 .62rem/1 var(--font-mono); }
  .file-kind { margin: .4rem 0 0; color: var(--tone); font-size: .68rem; font-weight: 710; text-transform: uppercase; }
  .fixture-card h3 { margin: .45rem 0 0; color: var(--bright); font-size: 1.2rem; font-weight: 520; }
  .fixture-card > p:not(.file-kind) { min-height: 4.3rem; margin: .55rem 0 0; color: var(--paper); font-size: .79rem; line-height: 1.62; }
  .fixture-card dl { display: grid; grid-template-columns: repeat(3,1fr); margin: 1rem 0 0; border-block: 1px solid var(--line); padding-block: .7rem; }
  .fixture-card dl div { display: grid; gap: .2rem; border-left: 1px solid var(--line); padding-inline: .55rem; }
  .fixture-card dl div:first-child { border-left: 0; padding-left: 0; }
  .fixture-card dt { color: var(--muted); font-size: .69rem; }
  .fixture-card dd { margin: 0; color: var(--bright); font-size: .76rem; font-weight: 680; }
  .fixture-downloads { display: flex; flex-wrap: wrap; gap: .45rem .8rem; align-items: center; margin-top: .9rem; }
  .fixture-downloads a { display: inline-flex; gap: .4rem; align-items: center; color: var(--tone); font-size: .76rem; font-weight: 720; }
  .fixture-downloads a.primary-download { border-radius: .65rem; padding: .55rem .7rem; background: color-mix(in srgb,var(--tone) 10%,#fff); }
  .fixture-downloads a :global(svg) { width: .9rem; height: .9rem; }
  .fixture-card details { margin-top: .75rem; }
  .fixture-card details p { margin: .55rem 0 .3rem; color: var(--muted); font-size: .7rem; }
  .fixture-card code { display: block; overflow-wrap: anywhere; color: var(--muted); font-size: .66rem; line-height: 1.45; }
  .fixture-note { display: grid; grid-template-columns: auto 1fr; gap: .7rem; align-items: start; margin-top: .9rem; border: 1px solid #e2ceb0; border-radius: .8rem; padding: .85rem; background: #fffaf1; color: #795d38; }
  .fixture-note :global(svg) { width: 1rem; height: 1rem; }
  .fixture-note p { margin: 0; font-size: .76rem; line-height: 1.55; }
  .simple-method { margin-block: clamp(4rem,8vw,6rem); }
  .simple-method > details { overflow: hidden; border: 1px solid var(--line); border-radius: 1.15rem; background: #fff; box-shadow: 0 1rem 2.6rem rgba(32,50,79,.045); }
  .simple-method summary { display: flex; justify-content: space-between; align-items: center; padding: 1.15rem 1.25rem; color: var(--bright); cursor: pointer; font-size: 1rem; font-weight: 580; }
  .simple-method summary span { display: inline-flex; gap: .6rem; align-items: center; }
  .simple-method summary :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--signal); }
  .simple-method details[open] summary > :global(svg) { transform: rotate(180deg); }
  .simple-method ol { display: grid; grid-template-columns: repeat(3,1fr); gap: .8rem; margin: 0; border-top: 1px solid var(--line); padding: 1rem; list-style: none; }
  .simple-method li { display: grid; grid-template-columns: auto 1fr; gap: .65rem; border-radius: .85rem; padding: .8rem; background: var(--surface-2); }
  .simple-method li > span { display: grid; width: 1.7rem; height: 1.7rem; place-items: center; border-radius: 50%; background: #172a44; color: #91decf; font: 680 .67rem/1 var(--font-mono); }
  .simple-method h3 { margin: 0; color: var(--bright); font-size: .86rem; font-weight: 560; }
  .simple-method li p { margin: .35rem 0 0; color: var(--muted); font-size: .74rem; line-height: 1.5; }
  .method-limit { margin: 0 1rem 1rem; color: var(--paper); font-size: .76rem; line-height: 1.55; }
  .contribute-card { display: grid; grid-template-columns: auto minmax(0,1fr) auto; gap: clamp(1.2rem,4vw,2.5rem); align-items: center; margin-bottom: clamp(4rem,7vw,6rem); border: 1px solid #bcd8d1; border-radius: 1.25rem; padding: clamp(1.2rem,4vw,2rem); background: linear-gradient(120deg,#f4fbf9,#fff); }
  .contribute-art { position: relative; display: grid; width: 6.5rem; height: 6.5rem; place-items: center; border: 1px solid #b9dcd4; border-radius: 50%; color: #16866f; }
  .contribute-art span { position: absolute; border: 1px solid #d1e9e3; border-radius: 50%; }
  .contribute-art span:nth-child(1) { width: 4.8rem; height: 4.8rem; }
  .contribute-art span:nth-child(2) { width: 3.2rem; height: 3.2rem; }
  .contribute-art span:nth-child(3) { width: .55rem; height: .55rem; background: #667ce0; transform: translate(2.25rem,-1.2rem); }
  .contribute-art :global(svg) { width: 1.35rem; height: 1.35rem; }
  .contribute-card h2 { font-size: clamp(1.55rem,2.7vw,2.1rem); }
  .contribute-card > div:nth-child(2) > p:last-child { max-width: 44rem; margin: .7rem 0 0; color: var(--paper); font-size: .82rem; line-height: 1.62; }
  .contribute-card .button { gap: .45rem; white-space: nowrap; }
  .contribute-card .button :global(svg) { width: .9rem; height: .9rem; }
  .lab-sources { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2rem; margin-bottom: clamp(4rem,7vw,6rem); border-top: 1px solid var(--line); padding-top: 1rem; }
  .lab-sources p { margin: 0; color: var(--muted); font-size: .7rem; line-height: 1.55; }
  .lab-sources div { display: flex; flex-wrap: wrap; gap: .5rem 1rem; }
  .lab-sources a { color: var(--paper); font-size: .7rem; text-decoration: underline; text-underline-offset: .2rem; }
  @media (max-width: 940px) { .platform-results, .fixture-grid { grid-template-columns: 1fr 1fr; } .platform-result:last-child, .fixture-card:last-child { grid-column: 1 / -1; } .contribute-card { grid-template-columns: auto 1fr; } .contribute-card > a { grid-column: 2; justify-self: start; } }
