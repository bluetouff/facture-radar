---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlatformCard from "../components/PlatformCard.astro";
import UseCaseNavigator from "../components/UseCaseNavigator.astro";
import InterfaceIcon from "../components/InterfaceIcon.astro";
import ProofOrbit from "../components/ProofOrbit.astro";
import { platforms } from "../data/platforms";
import sources from "../data/sources.json";
import directory from "../data/official-directory.json";

const spotlightSlugs = ["shine", "jefacture", "yooz", "doxallia"];
const spotlights = spotlightSlugs
  .map((slug) => platforms.find((platform) => platform.slug === slug))
  .filter((platform) => platform !== undefined);
---

<BaseLayout
  title="PA Check | Choisir sa plateforme de facturation électronique"
  description="Un guide simple pour vérifier son outil actuel ou trouver une plateforme de facturation adaptée à son activité."
>
  <section class="hero-stage">
    <ProofOrbit />
    <div class="shell hero">
      <div class="hero-intro">
        <span class="eyebrow">facturation électronique · indépendants et entreprises</span>
        <h1>Partez de votre <strong>vraie question.</strong></h1>
        <p class="hero-copy">Choisissez la situation qui vous ressemble. PA Check vous mène vers une réponse, un contrôle ou une décision concrète.</p>
      </div>
      <div class="hero-verifier"><UseCaseNavigator /></div>
      <div class="hero-support">
        <div class="hero-guide" aria-label="Les principes de PA Check">
          <div><span><InterfaceIcon name="route" /></span><p><strong>Une entrée claire</strong><small>Pas de questionnaire inutile</small></p></div>
          <div><span><InterfaceIcon name="shield" /></span><p><strong>Vos données restent ici</strong><small>Aucun compte nécessaire</small></p></div>
          <div><span><InterfaceIcon name="check" /></span><p><strong>Une action suivante</strong><small>Y compris lorsqu’un point manque</small></p></div>
        </div>
        <a class="quiet-link" href="/methodologie/">Comprendre comment les informations sont mises à jour <InterfaceIcon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="shell stats-shell" aria-label="Les informations disponibles">
    <div class="stats-strip">
      <div><strong>{platforms.length}</strong><span>plateformes étudiées en détail</span></div>
      <div><strong>{sources.length}</strong><span>sources publiques consultables</span></div>
      <div><strong>0</strong><span>donnée personnelle demandée</span></div>
      <div><strong>{directory.approved.length}</strong><span>plateformes agréées recensées</span></div>
    </div>
  </section>

  <section class="story-stage" aria-labelledby="story-title">
    <div class="shell story-layout">
      <div class="story-copy">
        <p class="story-kicker">l’enquête fondatrice · l0g</p>
        <span class="story-signature">ENQUÊTER <i></i> RENDRE UTILE</span>
        <h2 id="story-title">Avant de choisir une plateforme, il fallait comprendre ce qui avait changé.</h2>
        <p>Le portail public qui devait offrir un accès minimal a été retiré du dispositif. L’obligation est restée. Entre les entreprises et leurs clients s’installe désormais un marché de plateformes privées.</p>
        <p>l0g a suivi cette nouvelle chaîne pendant cinq enquêtes : l’architecture publique, les acteurs qui feront réellement circuler les factures, le prix des offres gratuites, l’accès aux données et la continuité en cas d’incident.</p>
        <blockquote>PA Check est né pour donner une suite pratique à ce travail : aider chacun à poser la bonne question, contrôler un fichier et choisir avec moins d’angles morts.</blockquote>
        <div class="story-actions">
          <a class="story-primary" href="https://l0g.fr/publications/grand-peage-facture/">Découvrir l’enquête complète <InterfaceIcon name="arrow" /></a>
          <a href="/a-propos/">De l’enquête à PA Check</a>
        </div>
      </div>

      <div class="story-chapters" aria-label="Les cinq volets du Grand péage de la facture">
        <header><span>LE GRAND PÉAGE DE LA FACTURE</span><small>5 volets · 10 infographies · EPUB gratuit</small></header>
        <nav>
          <a class="chapter-aqua" href="https://l0g.fr/posts/le-grand-peage-de-la-facture-1-le-portail-ampute/">
            <span>01</span><p><small>PORTAIL</small><strong>Le portail amputé</strong></p><InterfaceIcon name="arrow" />
          </a>
          <a class="chapter-blue" href="https://l0g.fr/posts/le-grand-peage-de-la-facture-2-147-plateformes-combien-de-tuyaux/">
            <span>02</span><p><small>MARCHÉ</small><strong>148 plateformes, combien de tuyaux ?</strong></p><InterfaceIcon name="arrow" />
          </a>
          <a class="chapter-amber" href="https://l0g.fr/posts/le-grand-peage-de-la-facture-3-le-prix-du-gratuit/">
            <span>03</span><p><small>PRIX</small><strong>Le prix du gratuit</strong></p><InterfaceIcon name="arrow" />
          </a>
          <a class="chapter-violet" href="https://l0g.fr/posts/le-grand-peage-de-la-facture-4-qui-lit-vos-factures/">
            <span>04</span><p><small>DONNÉES</small><strong>Qui lit vos factures ?</strong></p><InterfaceIcon name="arrow" />
          </a>
          <a class="chapter-coral" href="https://l0g.fr/posts/le-grand-peage-de-la-facture-5-le-jour-ou-le-tuyau-casse/">
            <span>05</span><p><small>INCIDENT</small><strong>Le jour où le tuyau casse</strong></p><InterfaceIcon name="arrow" />
          </a>
        </nav>
      </div>
    </div>
    <div class="shell story-bridge" aria-label="De l’enquête aux outils PA Check">
      <span><b>01</b> Enquête l0g</span><i></i><span><b>02</b> Informations structurées</span><i></i><span><b>03</b> Décisions et vérifications</span>
    </div>
  </section>

  <section class="shell invoice-callout" aria-labelledby="invoice-callout-title">
    <div class="invoice-visual" aria-hidden="true">
      <div class="invoice-sheet">
        <span class="sheet-corner"></span>
        <strong>FACTURE</strong>
        <i></i><i></i><i></i>
        <div><span>XML</span><b>✓</b></div>
      </div>
      <span class="scan-line"></span>
      <span class="visual-chip"><InterfaceIcon name="shield" /> local</span>
    </div>
    <div class="invoice-callout-copy">
      <p class="mono-label">nouveau · vérificateur de facture</p>
      <h2 id="invoice-callout-title">Un fichier. Les routes qui peuvent le prendre.</h2>
      <p>Déposez un PDF Factur-X ou un XML CII. PA Check le lit localement, repère les corrections utiles puis compare six chemins de dépôt sans masquer ce qui reste à tester.</p>
      <div class="callout-points">
        <span><InterfaceIcon name="shield" /> Aucun envoi</span>
        <span><InterfaceIcon name="check" /> Résultat immédiat</span>
        <span><InterfaceIcon name="route" /> Six routes examinées</span>
      </div>
      <a class="button" href="/verifier-une-facture/">Obtenir le passeport d’une facture <InterfaceIcon name="arrow" /></a>
    </div>
  </section>

  <section class="shell decision-callout" aria-labelledby="decision-callout-title">
    <div class="decision-callout-copy">
      <p class="mono-label">une question · une réponse utile</p>
      <h2 id="decision-callout-title">Pouvez-vous garder votre outil actuel&nbsp;?</h2>
      <p>Entrez son nom. PA Check vous indique immédiatement si vous pouvez le garder, ce qu’il faut compléter ou pourquoi une autre solution devient nécessaire.</p>
      <a href="/verifier-mon-outil/#verifier-logiciel">Vérifier mon outil <InterfaceIcon name="arrow" /></a>
    </div>
    <div class="decision-callout-visual" aria-hidden="true">
      <div class="decision-outcomes">
        <span class="outcome-keep"><b>01</b><strong>GARDER</strong><small>Le nécessaire est couvert</small></span>
        <span class="outcome-complete"><b>02</b><strong>COMPLÉTER</strong><small>Un point reste à régler</small></span>
        <span class="outcome-change"><b>03</b><strong>CHANGER</strong><small>Une fonction manque</small></span>
      </div>
      <strong><InterfaceIcon name="route" /> Réponse immédiate, détails ensuite</strong>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="mono-label">notre sélection</p>
          <h2>Quatre portes d'entrée dans un atlas de {platforms.length} dossiers.</h2>
        </div>
        <p>Une offre gratuite sans compte pro, un écosystème cabinet, une plateforme d'automatisation et un hub grands volumes. Quatre situations pour comprendre comment lire les fiches.</p>
      </header>
      <div class="dossier-grid">
        {spotlights.map((platform, index) => <PlatformCard platform={platform} index={index} />)}
      </div>
      <div class="hero-actions">
        <a class="button secondary" href="/plateformes/">Voir les {platforms.length} plateformes</a>
        <a class="button secondary" href="/annuaire/">Consulter l'annuaire officiel</a>
      </div>
      <a class="pa-contribution" href="/contribuer/">
        <span><InterfaceIcon name="action" /></span>
        <div><p class="mono-label">vous représentez une PA ?</p><h3>Apportez une information à votre fiche.</h3><small>Une source publique, un périmètre précis, puis une vérification indépendante avant mise à jour.</small></div>
        <InterfaceIcon name="arrow" />
      </a>
    </div>
  </section>

  <section class="section quiet-section">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="mono-label">votre point de départ</p>
          <h2>Commencez par votre situation.</h2>
        </div>
        <p>Quelques informations suffisent pour trouver la page ou l'outil qui vous sera réellement utile.</p>
      </header>
      <div class="method-steps">
        <article><span>01</span><h3>Votre outil actuel</h3><p>Recherchez son nom pour savoir où vous en êtes.</p></article>
        <article><span>02</span><h3>Votre activité</h3><p>Indiquez votre taille et votre volume de factures.</p></article>
        <article><span>03</span><h3>Votre priorité</h3><p>Gratuité, travail avec votre comptable, API ou international.</p></article>
        <article><span>04</span><h3>Vos options</h3><p>Consultez les plateformes pertinentes et les points à confirmer.</p></article>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero-stage { position: relative; overflow: hidden; border-radius: 0 0 2.4rem 2.4rem; background: radial-gradient(circle at 78% 18%, rgba(64,91,216,.32), transparent 22rem), radial-gradient(circle at 20% 100%, rgba(117,87,214,.18), transparent 25rem), #101d3a; }
  .hero-stage::after { position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(196,206,255,.17) 1px, transparent 1.2px); background-size: 24px 24px; mask-image: linear-gradient(90deg, #000, transparent 48%, #000); content: ""; opacity: .36; pointer-events: none; }
  .hero-stage .hero { position: relative; z-index: 2; }
  .hero-stage .hero h1 { color: #f8faff; }
  .hero-stage .hero h1 strong { color: #9caaff; }
  .hero-stage .hero-copy { color: rgba(237,242,255,.76); }
  .hero-stage .eyebrow { border-color: rgba(174,186,255,.28); background: rgba(255,255,255,.07); color: #bdc7ff; }
  .hero-intro { grid-area: intro; }
  .hero-verifier { grid-area: verifier; align-self: center; position: relative; z-index: 2; }
  .hero-support { grid-area: support; }
  .hero.journey-expanded { grid-template-columns: 1fr; grid-template-areas: "verifier"; padding-block: clamp(2rem, 4vw, 3.5rem); }
  .hero.journey-expanded .hero-intro, .hero.journey-expanded .hero-support { display: none; }
  .hero.journey-expanded .hero-verifier { width: 100%; }
  .hero-guide { display: grid; max-width: 35rem; gap: .55rem; }
  .hero-guide > div { display: grid; grid-template-columns: auto 1fr; gap: .75rem; align-items: center; border: 1px solid rgba(190,202,255,.16); border-radius: var(--radius-md); padding: .75rem .8rem; background: rgba(255,255,255,.055); backdrop-filter: blur(12px); }
  .hero-guide > div > span { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: .65rem; background: rgba(142,161,255,.14); color: #bdc7ff; }
  .hero-guide p { display: grid; margin: 0; }
  .hero-guide strong { color: #fff; font-size: .78rem; }
  .hero-guide small { color: rgba(237,242,255,.64); font-size: .76rem; font-weight: 560; }
  .quiet-link { display: inline-flex; gap: .55rem; align-items: center; margin-top: 1rem; color: #bdc7ff; font-size: .76rem; font-weight: 700; }
  .quiet-link :global(svg) { width: 1rem; height: 1rem; }
  .stats-shell { position: relative; z-index: 3; margin-top: -1.75rem; }
  .stats-shell .stats-strip > div { background: rgba(255,255,255,.94); box-shadow: 0 .8rem 2.2rem rgba(27,40,72,.09); backdrop-filter: blur(12px); }
  .invoice-callout { position: relative; display: grid; grid-template-columns: minmax(15rem, .72fr) minmax(0, 1.28fr); gap: clamp(2rem, 7vw, 5rem); align-items: center; overflow: hidden; margin-top: clamp(3rem, 7vw, 5.5rem); border: 1px solid color-mix(in srgb, var(--signal) 18%, var(--line)); border-radius: 1.5rem; padding: clamp(1.4rem, 5vw, 3rem); background: linear-gradient(135deg, #fff, color-mix(in srgb, var(--signal-soft) 76%, #fff)); box-shadow: 0 1.2rem 3.5rem rgba(41,57,86,.08); }
  .invoice-callout::before { position: absolute; top: -9rem; right: -5rem; width: 22rem; height: 22rem; border: 1px solid rgba(64,91,216,.12); border-radius: 50%; box-shadow: 0 0 0 2.5rem rgba(64,91,216,.035), 0 0 0 5rem rgba(117,87,214,.025); content: ""; }
  .invoice-visual { position: relative; display: grid; place-items: center; min-height: 18rem; border-radius: 1.15rem; background: radial-gradient(circle at 50% 50%, rgba(64,91,216,.18), transparent 9rem), #15233f; }
  .invoice-sheet { position: relative; display: grid; width: 10.5rem; min-height: 13.5rem; align-content: start; border-radius: .45rem; padding: 1.3rem; background: #fff; box-shadow: 0 1.5rem 3rem rgba(0,0,0,.25); rotate: -3deg; }
  .invoice-sheet strong { color: var(--bright); font: 760 .76rem/1 var(--font-mono); letter-spacing: .08em; }
  .invoice-sheet > i { height: .38rem; margin-top: .75rem; border-radius: 999px; background: var(--surface-2); }
  .invoice-sheet > i:nth-of-type(2) { width: 72%; }
  .invoice-sheet > i:nth-of-type(3) { width: 88%; }
  .invoice-sheet > div { display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; border-top: 1px solid var(--line); padding-top: .8rem; }
  .invoice-sheet > div span { color: var(--signal); font: 730 .65rem/1 var(--font-mono); }
  .invoice-sheet > div b { display: grid; place-items: center; width: 1.45rem; height: 1.45rem; border-radius: 50%; background: var(--success-soft); color: var(--success); }
  .sheet-corner { position: absolute; top: 0; right: 0; border-width: 0 0 2rem 2rem; border-style: solid; border-color: transparent transparent var(--signal-soft) transparent; }
  .scan-line { position: absolute; right: 14%; left: 14%; top: 50%; height: 2px; background: #84f2d1; box-shadow: 0 0 .8rem #84f2d1; }
  .visual-chip { position: absolute; right: 1rem; bottom: 1rem; display: inline-flex; gap: .35rem; align-items: center; border: 1px solid rgba(255,255,255,.16); border-radius: 999px; padding: .4rem .6rem; background: rgba(255,255,255,.08); color: #a9f2dc; font-size: .76rem; font-weight: 710; }
  .visual-chip :global(svg) { width: .9rem; height: .9rem; }
  .invoice-callout-copy { position: relative; z-index: 1; }
  .invoice-callout-copy h2 { max-width: 17ch; margin: .8rem 0 0; color: var(--bright); font-size: clamp(1.7rem, 3.1vw, 2.35rem); font-weight: 510; line-height: 1.12; letter-spacing: -.032em; }
  .invoice-callout-copy > p:not(.mono-label) { max-width: 42rem; color: var(--paper); font-size: .9rem; }
  .callout-points { display: flex; flex-wrap: wrap; gap: .45rem; margin: 1rem 0 1.2rem; }
  .callout-points span { display: inline-flex; gap: .35rem; align-items: center; border-radius: 999px; padding: .4rem .55rem; background: #fff; color: var(--paper); font-size: .76rem; font-weight: 650; box-shadow: inset 0 0 0 1px var(--line); }
  .callout-points :global(svg), .invoice-callout .button :global(svg) { width: .9rem; height: .9rem; }
  .invoice-callout .button { gap: .5rem; }
  .decision-callout { display: grid; grid-template-columns: minmax(0,.92fr) minmax(390px,1.08fr); gap: clamp(2rem,6vw,5rem); align-items: center; overflow: hidden; margin-top: 1rem; border-radius: 1.4rem; padding: clamp(1.5rem,4vw,2.7rem); background: #0d1a2a; color: #fff; box-shadow: 0 1.5rem 3.8rem rgba(26,42,67,.13); }
  .decision-callout-copy h2 { max-width: 23ch; margin: .75rem 0 0; color: #f7fbff; font-size: clamp(1.55rem,2.8vw,2.15rem); font-weight: 460; line-height: 1.14; letter-spacing: -.033em; }
  .decision-callout-copy > p:not(.mono-label) { max-width: 42rem; color: rgba(234,241,249,.7); font-size: .85rem; line-height: 1.68; }
  .decision-callout-copy .mono-label { color: #7dddc7; }
  .decision-callout-copy > a { display: inline-flex; gap: .5rem; align-items: center; margin-top: .55rem; color: #8ee4d0; font-size: .78rem; font-weight: 710; }
  .decision-callout-copy > a :global(svg) { width: .95rem; height: .95rem; }
  .decision-callout-visual { position: relative; min-width: 0; border: 1px solid rgba(255,255,255,.12); border-radius: 1rem; padding: 1rem; background: rgba(255,255,255,.035); }
  .decision-outcomes { display: grid; grid-template-columns: repeat(3,1fr); gap: .65rem; padding-top: 2rem; }
  .decision-outcomes > span { display: grid; min-height: 6.6rem; align-content: start; gap: .45rem; border: 1px solid rgba(126,224,201,.22); border-radius: .75rem; padding: .75rem; background: rgba(255,255,255,.055); color: #81deca; }
  .decision-outcomes .outcome-complete { border-color: rgba(154,168,255,.24); color: #aab5ff; }
  .decision-outcomes .outcome-change { border-color: rgba(229,179,102,.27); color: #e5b366; }
  .decision-outcomes b { font: 690 .65rem/1 var(--font-mono); opacity: .72; }
  .decision-outcomes strong { font-size: .72rem; letter-spacing: .06em; }
  .decision-outcomes small { color: rgba(255,255,255,.56); font-size: .72rem; line-height: 1.4; }
  .decision-callout-visual > strong { position: absolute; top: .8rem; right: .8rem; display: inline-flex; gap: .38rem; align-items: center; border: 1px solid rgba(126,224,201,.22); border-radius: 999px; padding: .38rem .55rem; color: #8ee4d0; font-size: .68rem; font-weight: 670; }
  .decision-callout-visual > strong :global(svg) { width: .82rem; height: .82rem; }
  .quiet-section { border-block: 1px solid color-mix(in srgb, var(--signal) 12%, var(--line)); background: color-mix(in srgb, var(--signal-soft) 46%, transparent); }
  .story-stage { position: relative; overflow: hidden; margin-top: clamp(3.5rem,7vw,6rem); padding-block: clamp(3.8rem,7vw,6.5rem) 1.2rem; background: #0c1727; color: #fff; }
  .story-stage::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(138,158,194,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(138,158,194,.055) 1px,transparent 1px); background-size: 28px 28px; mask-image: linear-gradient(90deg,transparent,#000 48%,#000); content: ""; }
  .story-stage::after { position: absolute; top: -13rem; right: -8rem; width: 36rem; height: 36rem; border: 1px solid rgba(121,139,245,.2); border-radius: 50%; box-shadow: 0 0 0 5rem rgba(121,139,245,.025),0 0 0 10rem rgba(103,217,195,.018); content: ""; }
  .story-layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0,.9fr) minmax(430px,1.1fr); gap: clamp(3rem,8vw,8rem); align-items: center; }
  .story-kicker { display: inline-flex; margin: 0; border: 1px solid rgba(110,220,199,.3); border-radius: 999px; padding: .42rem .66rem; color: #77ddc9; font-size: .76rem; font-weight: 720; letter-spacing: .045em; text-transform: uppercase; }
  .story-signature { display: flex; gap: .7rem; align-items: center; margin-top: 1.3rem; color: rgba(255,255,255,.5); font: 680 .75rem/1 var(--font-mono); letter-spacing: .05em; }
  .story-signature i { width: 4rem; height: 1px; background: linear-gradient(90deg,#70dac5,#8b84f4); }
  .story-copy h2 { max-width: 19ch; margin: 1rem 0 0; color: #fff; font-size: clamp(1.9rem,3.7vw,3rem); font-weight: 490; line-height: 1.09; letter-spacing: -.038em; }
  .story-copy > p:not(.story-kicker) { max-width: 45rem; margin: 1.15rem 0 0; color: rgba(239,244,255,.7); font-size: .88rem; line-height: 1.72; }
  .story-copy blockquote { margin: 1.5rem 0 0; border: 0; border-left: 2px solid #7b8ff1; padding: .15rem 0 .15rem 1rem; color: #fff; font-size: .9rem; font-weight: 540; line-height: 1.6; }
  .story-copy blockquote::before { display: none; }
  .story-actions { display: flex; flex-wrap: wrap; gap: .8rem 1.2rem; align-items: center; margin-top: 1.5rem; }
  .story-actions a { color: #b9c5ff; font-size: .78rem; font-weight: 710; }
  .story-actions .story-primary { display: inline-flex; gap: .5rem; align-items: center; border-radius: .7rem; padding: .72rem .85rem; background: #6f7fe4; color: #fff; }
  .story-actions :global(svg) { width: .95rem; height: .95rem; }
  .story-chapters { position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 1.35rem; padding: 1rem; background: rgba(11,25,40,.76); box-shadow: 0 1.5rem 4rem rgba(0,0,0,.24); backdrop-filter: blur(10px); }
  .story-chapters > header { display: flex; justify-content: space-between; gap: .7rem; border-bottom: 1px solid rgba(255,255,255,.1); padding: .2rem .25rem .9rem; color: #aeb9c9; font: 680 .75rem/1.4 var(--font-mono); }
  .story-chapters > header span { color: #bbc4ff; }
  .story-chapters nav { display: grid; gap: .48rem; margin-top: .8rem; }
  .story-chapters nav a { --chapter-tone: #79dcc9; display: grid; grid-template-columns: auto 1fr auto; gap: .8rem; align-items: center; border: 1px solid rgba(255,255,255,.08); border-radius: .8rem; padding: .7rem .75rem; background: rgba(255,255,255,.035); color: #fff; transition: translate 160ms ease,border-color 160ms ease,background 160ms ease; }
  .story-chapters nav a:hover { translate: .2rem 0; border-color: color-mix(in srgb,var(--chapter-tone) 45%,transparent); background: rgba(255,255,255,.07); color: #fff; }
  .story-chapters .chapter-blue { --chapter-tone: #7aa2f7; }
  .story-chapters .chapter-amber { --chapter-tone: #e8ad49; }
  .story-chapters .chapter-violet { --chapter-tone: #b997ff; }
  .story-chapters .chapter-coral { --chapter-tone: #ff8c83; }
