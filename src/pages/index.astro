---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlatformCard from "../components/PlatformCard.astro";
import UseCaseNavigator from "../components/UseCaseNavigator.astro";
import InterfaceIcon from "../components/InterfaceIcon.astro";
import { Image } from "astro:assets";
import paperCheck from "../assets/pa-check-paper-v1.png";
import PlatformUpdates from "../components/PlatformUpdates.astro";
import { platforms } from "../data/platforms";
import sources from "../data/sources.json";
import directory from "../data/official-directory.json";

const spotlightSlugs = ["shine", "jefacture", "yooz", "doxallia"];
const spotlights = spotlightSlugs
  .map((slug) => platforms.find((platform) => platform.slug === slug))
  .filter((platform) => platform !== undefined);
const chapters = [
  { number: "01", topic: "Portail", title: "Le portail amputé", url: "le-grand-peage-de-la-facture-1-le-portail-ampute" },
  { number: "02", topic: "Marché", title: "148 plateformes, combien de tuyaux ?", url: "le-grand-peage-de-la-facture-2-147-plateformes-combien-de-tuyaux" },
  { number: "03", topic: "Prix", title: "Le prix du gratuit", url: "le-grand-peage-de-la-facture-3-le-prix-du-gratuit" },
  { number: "04", topic: "Données", title: "Qui lit vos factures ?", url: "le-grand-peage-de-la-facture-4-qui-lit-vos-factures" },
  { number: "05", topic: "Incident", title: "Le jour où le tuyau casse", url: "le-grand-peage-de-la-facture-5-le-jour-ou-le-tuyau-casse" },
];
---

<BaseLayout
  title="Facturation électronique : choisir une plateforme agréée | PA Check"
  description={`Trouvez une réponse claire sur la facture électronique : ${platforms.length} plateformes agréées étudiées, vérification de votre outil et contrôle local des fichiers Factur-X.`}
>
  <section class="home-opening">
    <div class="shell opening-layout">
      <div class="opening-copy">
        <p class="edition-label"><span class="opening-pill">Indépendant. Sourcé. En accès libre.</span><a href="/a-propos/">Une initiative l0g ↗</a></p>
        <h1><span class="hero-topic">Facturation électronique</span>Votre plateforme agréée, en clair.</h1>
        <p>Les bonnes questions. Les faits vérifiables.<br class="desktop-break" /> Tout pour choisir sans avancer à l’aveugle.</p>
        <div class="opening-actions"><a class="button" href="/annuaire/">Trouver ma plateforme <InterfaceIcon name="arrow" /></a><a class="opening-secondary" href="/questions/" data-answer-open>J’ai une question <InterfaceIcon name="search" /></a></div>
        <div class="opening-audiences">Indépendants <span>·</span> Entreprises <span>·</span> Cabinets comptables</div>
      </div>
      <div class="opening-art">
        <div class="art-caption"><span>Moins de flou.</span><span>Plus de choix.</span></div>
        <Image src={paperCheck} alt="" widths={[480, 768, 1100]} sizes="(max-width: 700px) 100vw, 50vw" format="webp" quality={82} priority />
        <a class="art-register" href="/annuaire/"><strong>{platforms.length}<span>PA</span></strong><span>Un marché entier.<br /><b>Un seul point de départ.</b></span><InterfaceIcon name="arrow" /></a>
        <span class="art-edition" aria-hidden="true">PA CHECK / LE CHOIX ÉCLAIRÉ</span>
      </div>
    </div>
    <div class="shell opening-proof"><span><InterfaceIcon name="proof" /> {sources.length} sources consultables</span><span><InterfaceIcon name="shield" /> Des limites affichées, des faits datés</span><a href="/methodologie/">Notre méthode <InterfaceIcon name="arrow" /></a></div>
  </section>

  <div class="shell home-workbench"><UseCaseNavigator /></div>

  <section class="shell corpus-register" aria-label="Les informations disponibles">
    <div class="register-label"><span>Votre choix,<br /><strong>pièces à l’appui.</strong></span></div>
    <a href="/annuaire/"><strong>{platforms.length}</strong><span>fiches de plateformes<small>Une couverture variable, rendue visible sur chaque fiche.</small></span><InterfaceIcon name="arrow" /></a>
    <a href="/methodologie/"><strong>{sources.length}</strong><span>sources consultables<small>Retrouvez les documents derrière chaque information.</small></span><InterfaceIcon name="arrow" /></a>
    <a href="/annuaire/" class="register-date"><span>La référence officielle<strong>{directory.approved.length} PA recensées par la DGFiP</strong><small>Relevé du 10 septembre 2026</small></span><InterfaceIcon name="arrow" /></a>
  </section>

  <div class="shell home-updates"><PlatformUpdates limit={3} /></div>

  <section class="story-stage" aria-labelledby="story-title">
    <div class="shell story-layout">
      <div class="publication-cover">
        <p class="story-kicker"><span>l0g</span> L’enquête fondatrice</p>
        <div class="cover-rule" aria-hidden="true"></div>
        <h2 id="story-title">Le grand<br />péage de<br /><em>la facture.</em></h2>
        <p>Cinq volets pour comprendre les choix qui se cachent derrière l’obligation.</p>
        <a href="https://l0g.fr/publications/grand-peage-facture/" class="publication-link">Découvrir l’enquête complète <InterfaceIcon name="arrow" /></a>
        <span class="publication-edition">5 volets · 10 infographies · EPUB gratuit</span>
      </div>
      <div class="story-copy">
        <p class="edition-label">De l’enquête à votre prochaine décision</p>
        <h3>Comprendre la réforme.<br />Puis pouvoir choisir.</h3>
        <p>Le portail public qui devait offrir un accès minimal a été retiré du dispositif. L’obligation est restée. Entre les entreprises et leurs clients s’installe désormais un marché de plateformes privées.</p>
        <p>PA Check prolonge l’enquête de l0g : il rassemble les informations utiles pour choisir une plateforme, garder son logiciel ou contrôler une facture.</p>
        <nav class="story-chapters" aria-label="Les cinq volets du Grand péage de la facture">
          {chapters.map((chapter) => <a href={`https://l0g.fr/posts/${chapter.url}/`}>
            <span>{chapter.number}</span><div><small>{chapter.topic}</small><strong>{chapter.title}</strong></div><InterfaceIcon name="arrow" />
          </a>)}
        </nav>
        <a class="story-about" href="/a-propos/">Pourquoi nous avons créé PA Check <InterfaceIcon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section home-dossiers">
    <div class="shell">
      <header class="section-head">
        <div><p class="edition-label">Explorer les dossiers</p><h2>Des situations différentes.<br />Un même besoin de clarté.</h2></div>
        <p>Indépendant, cabinet, PME ou grands volumes : quatre exemples pour entrer dans les fiches. Toutes les plateformes restent accessibles dans le registre.</p>
      </header>
      <div class="dossier-grid">{spotlights.map((platform, index) => <PlatformCard platform={platform} index={index} />)}</div>
      <div class="home-directory-link"><a class="button" href="/annuaire/">Voir les {platforms.length} plateformes <InterfaceIcon name="arrow" /></a><a href="/plateformes/">Explorer la sélection par usage</a></div>
      <a class="pa-contribution" href="/contribuer/">
        <span><InterfaceIcon name="action" /></span>
        <div><small>Vous représentez une plateforme agréée ?</small><h3>Aidez-nous à garder votre fiche exacte.</h3><p>Une nouvelle fonction, un tarif, une correction : transmettez-nous vos informations publiques.</p></div>
        <InterfaceIcon name="arrow" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-opening { overflow: clip; padding-top: clamp(2rem,4vw,4rem); background: #f1ede4; border-bottom: 1px solid var(--line); }
  .opening-layout { display: grid; grid-template-columns: minmax(0,1.12fr) minmax(0,1fr); align-items: center; gap: 1rem; }
  .edition-label { display: flex; align-items: center; flex-wrap: wrap; gap: .7rem; margin: 0; color: var(--muted); font-size: .7rem; }
  .opening-pill { display: inline-flex; gap: .5rem; align-items: center; color: var(--bright); }
  .opening-pill::before { width: .4rem; height: .4rem; background: var(--signal); border-radius: 50%; content: ""; }
  .opening-copy h1 { max-width: 21ch; margin: 1.9rem 0 1.5rem; color: var(--bright); font: 400 clamp(2.125rem,1.3rem + 2.4vw,3.5rem)/1.16 var(--font-title); letter-spacing: -.018em; text-wrap: balance; }
  .hero-topic { display: block; margin-bottom: 1rem; font: 500 .8rem/1.4 var(--font-sans); letter-spacing: .01em; color: var(--muted); }
  .opening-copy > p:not(.edition-label) { max-width: 30rem; color: var(--paper); font-size: 1.02rem; line-height: 1.7; }
  .opening-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .9rem 1.5rem; margin-top: 1.7rem; }
  .opening-actions .button { border-radius: .4rem; }
  .opening-secondary { display: inline-flex; align-items: center; gap: .7rem; min-height: 44px; color: var(--bright); font-size: .85rem; font-weight: 550; }
  .opening-secondary :global(svg) { width: 1rem; }
  .opening-audiences { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.4rem; color: var(--muted); font-size: .7rem; }
  .opening-art { position: relative; min-width: 0; padding-bottom: 2.5rem; align-self: stretch; display: grid; align-content: center; }
  .opening-art :global(img) { width: 116%; max-width: none; height: auto; margin-left: -5%; mix-blend-mode: multiply; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 92%, transparent), linear-gradient(180deg, transparent, #000 7%, #000 85%, transparent); mask-composite: intersect; }
  .art-caption { display: flex; gap: .4rem; justify-content: flex-end; padding-right: .3rem; font: 400 .85rem/1.4 var(--font-serif); font-style: italic; color: var(--muted); }
  .art-caption span:last-child { color: var(--signal); }
  .art-register { position: relative; display: flex; gap: 1.2rem; align-items: center; width: fit-content; max-width: 100%; margin: -1.7rem 0 0 auto; padding: 1.1rem 1.5rem; border-radius: .4rem; background: var(--bright); color: #f6f3ec; box-shadow: 0 12px 30px #23251f12; transition: translate 180ms ease; }
  .art-register:hover { translate: 0 -4px; color: #fff; }
  .art-register > strong { display: flex; align-items: baseline; gap: .35rem; font: 550 2.9rem/1 var(--font-sans); letter-spacing: -.07em; }
  .art-register strong span { color: #c8c7bd; font: 500 .7rem/1 var(--font-mono); letter-spacing: 0; }
  .art-register > span { font-size: .73rem; color: #cecec5; }
  .art-register b { font-weight: 500; color: #fff; }
  .art-register :global(svg) { width: 1.3rem; color: #ff8968; flex-shrink: 0; }
  .art-edition { position: absolute; bottom: .4rem; right: 0; color: var(--muted); font: .55rem/1 var(--font-mono); letter-spacing: .09em; }
  .opening-proof { display: flex; gap: 1.4rem; align-items: center; margin-top: 2.3rem; padding-block: 1.15rem; border-top: 1px solid var(--line); font-size: .74rem; }
  .opening-proof > span, .opening-proof > a { display: flex; gap: .5rem; align-items: center; }
  .opening-proof > a { margin-left: auto; color: var(--bright); }
  .opening-proof :global(svg) { width: 1rem; height: 1rem; color: var(--signal); }
  .home-workbench { margin-block: 4.5rem; }
  .corpus-register { display: grid; grid-template-columns: .8fr 1.2fr 1.2fr 1fr; align-items: center; margin-block: 3rem 4rem; border-block: 1px solid var(--line); }
  .register-label { padding: 1.5rem 1rem 1.5rem 0; font-size: 1.1rem; color: var(--muted); line-height: 1.4; letter-spacing: -.025em; }
  .register-label strong { color: var(--bright); font-weight: 580; }
  .corpus-register > a { display: flex; align-items: center; gap: 1rem; padding: 1.5rem; border-left: 1px solid var(--line); }
  .corpus-register > a:hover { background: var(--surface-2); color: var(--bright); }
  .corpus-register > a > strong { font: 500 2.5rem/1 var(--font-sans); letter-spacing: -.06em; color: var(--bright); }
  .corpus-register a span { display: grid; font-size: .78rem; color: var(--bright); }
  .corpus-register a small { display: block; margin-top: .4rem; color: var(--muted); font-size: .7rem; line-height: 1.5; }
  .corpus-register a :global(svg) { flex-shrink: 0; width: 1rem; color: var(--signal); }
  .register-date strong { margin-top: .4rem; font-size: .8rem; font-weight: 550; }
  .home-updates { margin-block: 4rem 5rem; }
  .story-stage { padding-block: 4rem; background: #eae7dc; border-block: 1px solid var(--line); }
  .story-layout { display: grid; grid-template-columns: minmax(0,.88fr) minmax(0,1fr); align-items: center; gap: clamp(3rem,7vw,6rem); }
  .publication-cover { position: relative; isolation: isolate; padding: clamp(2rem,4vw,3.5rem); border: 1px solid #48574b; background: #272922; color: #f4ead9; box-shadow: 7px 7px 0 #ded7c6,8px 8px 0 #aea796,14px 14px 0 #f6f3ec,15px 15px 0 #bdb6a5; }
  .publication-cover::before { position: absolute; inset: 0 auto 0 .75rem; width: 1px; background: #79927855; content: ""; }
  .story-kicker { display: flex; align-items: center; gap: 1rem; margin: 0; color: #d3c3a7; font-size: .76rem; }
  .story-kicker span { color: #efe4cf; font: 600 1.6rem/1 var(--font-mono); }
  .cover-rule { width: 3rem; height: 2px; margin-top: 2.7rem; background: #c59470; }
  .publication-cover h2 { margin: 1.4rem 0; font: 400 clamp(3rem,5vw,4.8rem)/.99 var(--font-serif); letter-spacing: -.035em; }
  .publication-cover h2 em { color: #ffac8c; }
  .publication-cover > p:not(.story-kicker) { max-width: 24rem; font-size: .96rem; color: #d0d4bc; }
  .publication-link { display: inline-flex; gap: .8rem; align-items: center; margin-top: 1.25rem; padding-block: .7rem; border-bottom: 1px solid #b99778; font-size: .87rem; color: #f2d1ad; }
  .publication-link:hover { color: #fff; }
  .publication-edition { display: block; border-top: 1px solid #728375; margin-top: 2.5rem; padding-top: 1rem; color: #b9c8b0; font-size: .74rem; }
  .story-copy .edition-label { color: var(--muted); }
  .story-copy h3 { margin: 1rem 0; color: var(--bright); font: 430 clamp(1.8rem,3vw,2.4rem)/1.1 var(--font-serif); }
  .story-copy > p:not(.edition-label) { color: var(--paper); font-size: .95rem; line-height: 1.75; }
  .story-chapters { margin-top: 1.6rem; border-top: 1px solid #d0daea; }
  .story-chapters a { display: grid; grid-template-columns: 1.5rem 1fr auto; gap: 1rem; align-items: center; border-bottom: 1px solid #d0daea; padding: .7rem 0; color: var(--bright); transition: padding 160ms ease; }
  .story-chapters a:hover { padding-inline: .3rem; background: #ffffff25; color: var(--bright); }
  .story-chapters a > span { font: .7rem/1 var(--font-mono); color: #6279a6; }
  .story-chapters small { display: block; color: var(--muted); font-size: .7rem; }
  .story-chapters strong { font-size: .87rem; font-weight: 550; }
  .story-chapters :global(svg) { width: 1rem; }
  .story-about { display: inline-flex; gap: .7rem; align-items: center; margin-top: 1.5rem; font-size: .84rem; color: var(--signal); }
  .home-dossiers .edition-label { color: var(--signal); }
  .home-dossiers h2 { max-width: 28ch; font-family: var(--font-title); font-weight: 400; font-size: clamp(1.8rem,2.4vw,2.3rem); line-height: 1.25; letter-spacing: -.015em; }
  .dossier-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  .home-directory-link { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; margin-top: 1.7rem; }
  .home-directory-link > a:last-child { font-size: .9rem; text-decoration: underline; text-underline-offset: .3em; }
  .home-directory-link .button { gap: .7rem; }
  .pa-contribution { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.3rem; margin-top: 3rem; padding: 1.7rem 0; border-block: 1px solid var(--line); }
  .pa-contribution > span { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border: 1px solid #bcb79f; border-radius: 50%; color: #93613e; }
  .pa-contribution h3 { margin: .3rem 0; color: var(--bright); font-size: 1.1rem; font-weight: 550; }
  .pa-contribution small { color: #6a715c; font-size: .8rem; }
  .pa-contribution p { margin: 0; font-size: .9rem; }
  @media (prefers-reduced-motion: no-preference) { .opening-art :global(img) { animation: arrive 650ms both; } @keyframes arrive { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } } }
  @media (max-width: 1000px) { .corpus-register { grid-template-columns: 1fr 1fr; } .corpus-register > a { border-left: 0; } .corpus-register > a:nth-child(even) { border-left: 1px solid var(--line); } .story-layout { gap: 3rem; } .art-register { padding: 1rem; gap: .8rem; } .art-register > strong { font-size: 2.4rem; } }
  @media (max-width: 700px) { .opening-layout { grid-template-columns: 1fr; gap: 0; } .opening-copy h1 { margin-top: 1.4rem; } .opening-art { margin: 1.5rem 0 0; padding-bottom: 1.5rem; } .opening-art :global(img) { width: 100%; max-width: 100%; margin: 0; aspect-ratio: 4 / 3; object-fit: contain; } .art-caption { position: absolute; top: 0; left: 0; z-index: 1; font-size: .8rem; } .art-register { margin-top: -2rem; padding: .85rem 1rem; } .art-register > strong { font-size: 2.3rem; } .art-edition { font-size: .5rem; } .opening-proof { flex-wrap: wrap; gap: .7rem 1.2rem; margin-top: 1.2rem; font-size: .7rem; } .opening-proof > a { margin-left: 0; } .home-workbench { margin-block: 2.5rem; } .story-layout { grid-template-columns: 1fr; } .publication-cover { margin-right: 1rem; } .dossier-grid { grid-template-columns: 1fr; } .home-updates { margin-block: 2.5rem 3.5rem; } }
  @media (max-width: 440px) { .edition-label > a { display: none; } .opening-actions { gap: .7rem 1rem; } .opening-actions .button { padding-inline: 1rem; } .opening-secondary { font-size: .8rem; } .corpus-register { grid-template-columns: 1fr; margin-bottom: 2.5rem; } .corpus-register > a, .corpus-register > a:nth-child(even) { border-left: 0; border-top: 1px solid var(--line); padding: 1rem 0; } .register-label { padding: 1rem 0; } .pa-contribution { grid-template-columns: auto 1fr; gap: .8rem; } .pa-contribution > :global(svg) { display: none; } .opening-copy > p:not(.edition-label) { font-size: .94rem; } }
</style>
