---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import InterfaceIcon from "../components/InterfaceIcon.astro";
import { platforms } from "../data/platforms";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical = Astro.url.pathname } = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
const nav = [
  { href: "/verifier-mon-outil/", label: "Question pratique", shortLabel: "Besoin", icon: "action" },
  { href: "/verifier-une-facture/", label: "Vérifier une facture", shortLabel: "Facture", icon: "invoice" },
  { href: "/diagnostic/", label: "Choisir une plateforme", shortLabel: "Choisir", icon: "verdict" },
  { href: "/plateformes/", label: `${platforms.length} plateformes`, shortLabel: "Plateformes", icon: "proof" },
  { href: "/annuaire/", label: "Annuaire officiel", shortLabel: "Annuaire", icon: "check" },
] as const;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#f4f7fb" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="PA Check, accueil">
          <span class="brand-mark"><InterfaceIcon name="invoice" /></span>
          <span class="brand-copy"><strong>PA <span>Check</span></strong><small>Choisir et vérifier</small></span>
        </a>
        <nav class="main-nav" aria-label="Navigation principale">
          {nav.map(({ href, label, shortLabel, icon }) => (
            <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? "page" : undefined}>
              <InterfaceIcon name={icon} />
              <span class="nav-label">{label}</span><span class="nav-short">{shortLabel}</span>
            </a>
          ))}
        </nav>
        <strong class="header-promise"><InterfaceIcon name="shield" /> Informations sourcées</strong>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <p class="mono-label">PA Check</p>
          <strong>Choisir sa plateforme et vérifier ses factures test.</strong>
          <p>Vos réponses et vos fichiers restent sur votre appareil. Aucun compte nécessaire.</p>
        </div>
        <nav aria-label="Pied de page">
          <a href="/methodologie/">Méthodologie</a>
          <a href="/changements/">Journal des changements</a>
          <a href="/api/platforms.json">API JSON</a>
          <a href="https://l0g.fr/publications/grand-peage-facture/">Enquête l0g</a>
          <a href="https://github.com/bluetouff/facture-radar">Code source</a>
        </nav>
      </div>
      <div class="shell footer-note">Données vérifiées le 25 août 2026 · liste DGFiP du 19 août 2026 · bêta publique</div>
    </footer>
  </body>
</html>
