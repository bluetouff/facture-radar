---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import InterfaceIcon from "../components/InterfaceIcon.astro";
import BrandMark from "../components/BrandMark.astro";
import { platforms } from "../data/platforms";
import { practicalQuestions } from "../data/practical-questions";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
}

const { title, description, canonical = Astro.url.pathname, robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" } = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
const isHome = Astro.url.pathname === "/";
const socialImageUrl = new URL("/og/pa-check-facturation-electronique-v2.png", Astro.site);
const encodedShareUrl = encodeURIComponent(canonicalUrl.toString());
const encodedShareTitle = encodeURIComponent(title);
const encodedEmailBody = encodeURIComponent(`${title}\n\n${canonicalUrl.toString()}`);
const shareLinks = [
  { label: "X", icon: "social-x", href: `https://x.com/intent/post?url=${encodedShareUrl}&text=${encodedShareTitle}`, tone: "x", external: true },
  { label: "LinkedIn", icon: "social-linkedin", href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedShareUrl}`, tone: "linkedin", external: true },
  { label: "Facebook", icon: "social-facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${encodedShareUrl}`, tone: "facebook", external: true },
  { label: "E-mail", icon: "email", href: `mailto:?subject=${encodedShareTitle}&body=${encodedEmailBody}`, tone: "email", external: false },
] as const;
const primaryNav = [
  { href: "/verifier-mon-outil/", label: "Vérifier mon outil", hint: "Garder, compléter ou changer", icon: "route", tone: "violet" },
  { href: "/verifier-une-facture/", label: "Vérifier une facture", hint: "Factur-X ou XML, contrôle local", icon: "invoice", tone: "blue" },
  { href: "/diagnostic/", label: "Choisir une plateforme", hint: "3 questions, toutes les options", icon: "target", tone: "green" },
] as const;
const resourceNav = [
  { href: "/questions/", label: `${practicalQuestions.length} questions pratiques`, hint: "Des réponses directement utilisables", icon: "question" },
  { href: "/plateformes/", label: `${platforms.length} plateformes étudiées`, hint: "Fiches détaillées et tarifs", icon: "layers" },
  { href: "/annuaire/", label: "Annuaire officiel", hint: "La liste publique de la DGFiP", icon: "directory" },
  { href: "/a-propos/", label: "Pourquoi PA Check ?", hint: "De l’enquête l0g à l’outil", icon: "route" },
  { href: "/contribuer/", label: "Mettre à jour une fiche", hint: "Pour les plateformes agréées", icon: "action" },
  { href: "/agents/", label: "Accès pour les agents", hint: "MCP public et corpus complet", icon: "route" },
  { href: "/methodologie/", label: "Sources et méthode", hint: "Ce qui est vérifié, déclaré ou inconnu", icon: "shield" },
] as const;
const footerGroups = [
  {
    label: "Utiliser",
    links: [
      { href: "/verifier-mon-outil/", label: "Vérifier mon outil", icon: "route" },
      { href: "/verifier-une-facture/", label: "Contrôler une facture", icon: "invoice" },
      { href: "/diagnostic/", label: "Choisir une plateforme", icon: "target" },
    ],
  },
  {
    label: "Comprendre",
    links: [
      { href: "/questions/", label: "Questions pratiques", icon: "question" },
      { href: "/plateformes/", label: "Plateformes étudiées", icon: "layers" },
      { href: "/annuaire/", label: "Annuaire officiel", icon: "directory" },
      { href: "/a-propos/", label: "Pourquoi PA Check ?", icon: "search" },
    ],
  },
  {
    label: "Projet ouvert",
    links: [
      { href: "/contribuer/", label: "Mettre à jour une fiche", icon: "action" },
      { href: "/methodologie/", label: "Sources et méthode", icon: "shield" },
      { href: "/changements/", label: "Journal des changements", icon: "proof" },
      { href: "/agents/", label: "MCP et corpus public", icon: "grid" },
    ],
  },
] as const;
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
const resourceIsCurrent = resourceNav.some(({ href }) => isCurrent(href));
---

<!doctype html>
<html lang="fr" itemscope={isHome || undefined} itemtype={isHome ? "https://schema.org/WebSite" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {isHome && <meta itemprop="name" content="PA Check" />}
    {isHome && <meta itemprop="alternateName" content="PA Check facturation électronique" />}
    {isHome && <meta itemprop="url" content={canonicalUrl} />}
    <meta name="theme-color" content="#e7edf5" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PA Check" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PA Check, réponses sur la facturation électronique et les plateformes agréées" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="PA Check, réponses sur la facturation électronique et les plateformes agréées" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="header-shell header-inner">
        <a class="brand" href="/" aria-label="PA Check, facturation électronique, accueil">
          <span class="brand-mark" aria-hidden="true"><BrandMark /></span>
          <span class="brand-copy"><strong><span>PA</span> Check</strong><small>Facturation électronique</small></span>
        </a>
        <nav class="main-nav" aria-label="Actions principales">
          {primaryNav.map(({ href, label, hint, icon, tone }) => (
            <a class={`nav-action tone-${tone}`} href={href} aria-current={isCurrent(href) ? "page" : undefined}>
              <span class="nav-icon"><InterfaceIcon name={icon} /></span>
              <span class="nav-copy"><strong>{label}</strong><small>{hint}</small></span>
            </a>
          ))}
        </nav>
        <div class="header-tools">
          <nav class="share-cluster" aria-label="Partager cette page">
            <span>Partager</span>
            <div>
              {shareLinks.map(({ label, icon, href, tone, external }) => (
                <a
                  class={`share-link share-${tone}`}
                  href={href}
                  aria-label={`Partager sur ${label}`}
                  title={label}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                ><InterfaceIcon name={icon} /></a>
              ))}
            </div>
          </nav>
          <details class="resource-menu">
            <summary class:list={{ current: resourceIsCurrent }}>
              <span class="summary-icon"><InterfaceIcon name="grid" /></span>
              <span>Explorer</span>
              <InterfaceIcon name="chevron" />
            </summary>
            <div class="resource-popover">
              <p>Ressources</p>
              <nav aria-label="Ressources">
                {resourceNav.map(({ href, label, hint, icon }) => (
                  <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                    <span><InterfaceIcon name={icon} /></span>
                    <strong>{label}<small>{hint}</small></strong>
                  </a>
                ))}
              </nav>
              <div class="source-note"><InterfaceIcon name="shield" /><span><strong>Informations sourcées</strong><small>Mises à jour et limites affichées</small></span></div>
            </div>
          </details>
          <details class="mobile-menu">
            <summary><InterfaceIcon name="menu" /><span>Menu</span></summary>
            <div class="mobile-popover">
              <p>Que voulez-vous faire ?</p>
              <nav aria-label="Menu principal mobile">
                {primaryNav.map(({ href, label, hint, icon, tone }) => (
                  <a class={`tone-${tone}`} href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                    <span class="nav-icon"><InterfaceIcon name={icon} /></span>
                    <strong>{label}<small>{hint}</small></strong>
                  </a>
                ))}
              </nav>
              <p>Partager cette page</p>
              <nav class="mobile-share" aria-label="Partager cette page">
                {shareLinks.map(({ label, icon, href, tone, external }) => (
                  <a
                    class={`share-${tone}`}
                    href={href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                  ><InterfaceIcon name={icon} /><span>{label}</span></a>
                ))}
              </nav>
              <p>Explorer</p>
              <nav class="mobile-resources" aria-label="Ressources mobiles">
                {resourceNav.map(({ href, label, icon }) => (
                  <a href={href} aria-current={isCurrent(href) ? "page" : undefined}><InterfaceIcon name={icon} /><span>{label}</span></a>
                ))}
              </nav>
            </div>
          </details>
        </div>
      </div>
      <div class="header-signal" aria-hidden="true"><span></span><span></span><span></span></div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <a class="footer-investigation" href="https://l0g.fr/publications/grand-peage-facture/" aria-label="Lire l’enquête l0g : Le grand péage de la facture">
          <div class="footer-investigation-copy">
            <p class="footer-kicker"><span>l0g</span> L’enquête à l’origine de PA Check</p>
            <h2>Le grand péage<br />de la facture</h2>
            <p>Cinq volets pour comprendre ce que la réforme change concrètement : l’architecture, le marché, les prix, les données et la continuité.</p>
            <strong>Lire l’enquête sur l0g.fr <InterfaceIcon name="arrow" /></strong>
          </div>
          <div class="footer-investigation-map" aria-hidden="true">
            <span><b>01</b><small>Portail</small></span>
            <span><b>02</b><small>Marché</small></span>
            <span><b>03</b><small>Prix</small></span>
            <span><b>04</b><small>Données</small></span>
            <span><b>05</b><small>Incident</small></span>
          </div>
        </a>

        <div class="footer-main">
          <div class="footer-brand">
            <a class="footer-brand-lockup" href="/" aria-label="PA Check, facturation électronique, accueil">
              <span class="brand-mark" aria-hidden="true"><BrandMark /></span>
              <span><strong><b>PA</b> Check</strong><small>Facturation électronique</small></span>
            </a>
            <p>Une réponse claire à vos questions sur la facture électronique.</p>
            <div class="footer-privacy"><InterfaceIcon name="lock" /><span>Vos choix restent dans ce navigateur.</span></div>
          </div>

          <div class="footer-links">
            <nav class="footer-nav" aria-label="Pied de page">
              {footerGroups.map((group) => (
                <section>
                  <h2>{group.label}</h2>
                  {group.links.map((link) => <a href={link.href}><InterfaceIcon name={link.icon} /><span>{link.label}</span></a>)}
                </section>
              ))}
            </nav>
            <a class="footer-support" href="https://l0g.fr/soutenir/" aria-label="Soutenir le projet indépendant l0g">
              <span class="footer-support-icon"><InterfaceIcon name="support" /></span>
              <span class="footer-support-copy"><small>Projet public et indépendant</small><strong>Soutenir l0g</strong></span>
              <InterfaceIcon class="footer-support-arrow" name="arrow" />
            </a>
          </div>
        </div>

        <div class="footer-note">
          <p><span>Données vérifiées le 27 août 2026</span><span>Liste DGFiP du 19 août 2026</span><span>Bêta publique</span></p>
          <nav aria-label="Informations légales et techniques">
            <a href="https://l0g.fr/rgpd/"><InterfaceIcon name="shield" /><span>Mentions légales l0g</span></a>
            <a href="/confidentialite/"><InterfaceIcon name="lock" /><span>Confidentialité</span></a>
            <a href="/conditions-utilisation/"><InterfaceIcon name="directory" /><span>Conditions d’utilisation</span></a>
            <a href="/securite/"><InterfaceIcon name="shield" /><span>Sécurité</span></a>
            <a href="https://github.com/bluetouff/facture-radar"><InterfaceIcon name="grid" /><span>Code source</span></a>
            <a href="/api/corpus.json"><InterfaceIcon name="download" /><span>Corpus JSON</span></a>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
